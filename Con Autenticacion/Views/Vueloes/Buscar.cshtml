@model IEnumerable<Con_Autenticacion.Models.Vuelo>

@{
    ViewBag.Title = "Buscar Vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var hayResultados = ViewBag.HayResultados != null ? (bool)ViewBag.HayResultados : false;
    var fechaBusqueda = ViewBag.Fecha as DateTime?;
    var pasajeros = ViewBag.CantidadPasajeros != null ? (int)ViewBag.CantidadPasajeros : 1;
    var origenSeleccionado = ViewBag.AeropuertoOrigenId;
    var destinoSeleccionado = ViewBag.AeropuertoDestinoId;
    var aeropuertos = ViewBag.Aeropuertos ?? new List<SelectListItem>();
    var totalResultados = ViewBag.TotalResultados != null ? (int)ViewBag.TotalResultados : 0;
    var ocupadosPorVuelo = ViewBag.OcupadosPorVuelo as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Buscar Vuelos</h2>
        <p class="small text-muted mb-4">Encuentra vuelos disponibles según tu origen, destino, fecha y cantidad de pasajeros.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        @using (Html.BeginForm("Buscar", "Vueloes", FormMethod.Get))
        {
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Origen</label>
                    @Html.DropDownList("AeropuertoOrigenId",
                        new SelectList(aeropuertos, "Value", "Text", origenSeleccionado),
                        "Seleccione aeropuerto...",
                        new { @class = "form-select form-control-lg", required = "required" })
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Destino</label>
                    @Html.DropDownList("AeropuertoDestinoId",
                        new SelectList(aeropuertos, "Value", "Text", destinoSeleccionado),
                        "Seleccione aeropuerto...",
                        new { @class = "form-select form-control-lg", required = "required" })
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Fecha de salida</label>
                    <input type="date"
                           class="form-control form-control-lg"
                           name="Fecha"
                           value="@(fechaBusqueda.HasValue ? fechaBusqueda.Value.ToString("yyyy-MM-dd") : "")"
                           required>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Pasajeros</label>
                    <input type="number"
                           class="form-control form-control-lg"
                           name="CantidadPasajeros"
                           min="1"
                           max="10"
                           value="@pasajeros"
                           required>
                </div>

                <div class="col-12 mt-4 d-flex gap-2 justify-content-end">
                    <a href="@Url.Action("Buscar", "Vueloes")" class="btn btn-outline-secondary px-4">Limpiar filtros</a>
                    <button type="submit" class="btn px-4 text-white fw-bold" style="background-color: #37474f; border-color: #37474f;">Buscar vuelos</button>
                </div>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #e0e0e0 !important;">
        <div class="card-header bg-light border-bottom py-3 px-4">
            @if (hayResultados)
            {
                <span class="small text-muted">
                    Mostrando <strong>@totalResultados</strong> vuelos disponibles para <strong>@pasajeros pasajeros</strong>
                    @if (fechaBusqueda.HasValue)
                    {
                        <span>el <strong>@fechaBusqueda.Value.ToString("dd MMM yyyy")</strong>.</span>
                    }
                </span>
            }
            else
            {
                <span class="small text-muted">No se encontraron vuelos con los filtros seleccionados.</span>
            }
        </div>

        <div class="card-body p-0">
            @if (!hayResultados)
            {
                <div class="p-4 text-center text-muted">
                    No hay vuelos disponibles para ese origen, destino y fecha.
                </div>
            }
            else
            {
                foreach (var vuelo in Model)
                {
                    var capacidad = 0;
                    if (vuelo.Aeronave != null && vuelo.Aeronave.ModeloAeronave != null)
                    {
                        capacidad = vuelo.Aeronave.ModeloAeronave.CapacidadAsientos;
                    }

                    var ocupados = 0;
                    if (ocupadosPorVuelo.ContainsKey(vuelo.VueloId))
                    {
                        ocupados = ocupadosPorVuelo[vuelo.VueloId];
                    }

                    var restantes = capacidad > 0 ? capacidad - ocupados : 0;
                    var duracion = vuelo.Frecuencia != null ? vuelo.Frecuencia.HoraLlegada - vuelo.Frecuencia.HoraSalida : TimeSpan.Zero;
                    var origenIata = vuelo.Frecuencia != null && vuelo.Frecuencia.Ruta != null && vuelo.Frecuencia.Ruta.Aeropuerto != null ? vuelo.Frecuencia.Ruta.Aeropuerto.CodigoIATA : "ORIG";
                    var destinoIata = vuelo.Frecuencia != null && vuelo.Frecuencia.Ruta != null && vuelo.Frecuencia.Ruta.Aeropuerto1 != null ? vuelo.Frecuencia.Ruta.Aeropuerto1.CodigoIATA : "DEST";
                    var precio = restantes > 0 ? 120 + (restantes * 5) : 0;

                    <div class="d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
                        <div class="d-flex align-items-center gap-4">
                            <div class="text-center">
                                <div class="fw-bold fs-5 text-dark">@((vuelo.Frecuencia != null) ? vuelo.Frecuencia.HoraSalida.ToString("hh\\:mm") : "--:--")</div>
                                <div class="small text-muted">@origenIata</div>
                            </div>
                            <div class="text-muted small" style="width: 100px; border-top: 2px dashed #adb5bd;"></div>
                            <div class="text-center">
                                <div class="fw-bold fs-5 text-dark">@((vuelo.Frecuencia != null) ? vuelo.Frecuencia.HoraLlegada.ToString("hh\\:mm") : "--:--")</div>
                                <div class="small text-muted">@destinoIata</div>
                            </div>
                            <div class="small text-muted ms-3">@duracion.TotalMinutes.ToString("0") minutos</div>
                        </div>

                        <div class="text-center">
                            <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-2">Disponible</span>
                            <div class="small text-muted mt-1">@restantes asientos restantes</div>
                        </div>

                        <div class="text-end d-flex align-items-center gap-3">
                            <div>
                                <div class="small text-muted">Desde</div>
                                <div class="fw-bold fs-5 text-dark">$@precio.ToString("0.00")</div>
                                <div class="small text-muted mt-1">
                                    @if (vuelo.Aeronave != null)
                                    {
                                        @vuelo.Aeronave.Matricula
                                    }
                                    else
                                    {
                                        <span>N/A</span>
                                    }
                                </div>
                            </div>
                            <a href="@Url.Action("Resultados", "Vueloes", new { AeropuertoOrigenId = origenSeleccionado, AeropuertoDestinoId = destinoSeleccionado, Fecha = (fechaBusqueda.HasValue ? fechaBusqueda.Value.ToString("yyyy-MM-dd") : ""), CantidadPasajeros = pasajeros })" class="btn btn-sm px-3 py-2 text-white fw-semibold rounded-3" style="background-color: #37474f; border-color: #37474f;">Seleccionar</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
