@{
    ViewBag.Title = "Resultados de Búsqueda";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Resultados de Búsqueda</h2>
        <p class="small text-muted mb-4">
            Vuelos encontrados para <strong>Quito (UIO)</strong> → <strong>Guayaquil (GYE)</strong> el <strong>28 Oct 2026</strong> · <strong>2 pasajeros</strong>.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <select class="form-select form-select-sm">
                    <option>Todos los horarios</option>
                    <option>Mañana (00:00 - 12:00)</option>
                    <option>Tarde (12:00 - 18:00)</option>
                    <option>Noche (18:00 - 23:59)</option>
                </select>
            </div>

            <div class="col-md-3">
                <select class="form-select form-select-sm">
                    <option>Todas</option>
                    <option>Vuelo directo</option>
                    <option>1 escala</option>
                    <option>2 escalas</option>
                </select>
            </div>

            <div class="col-md-3">
                <select class="form-select form-select-sm">
                    <option>Todas</option>
                    <option>Aerolínea VIP</option>
                    <option>Otras aerolíneas</option>
                </select>
            </div>

            <div class="col-md-3 text-end">
                <button class="btn btn-sm btn-outline-secondary">Limpiar filtros</button>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column gap-3">
        <div class="card border-0 shadow-sm rounded-4" style="border: 1px solid #e0e0e0 !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="fw-bold text-dark">Aerolínea VIP</span>
                        <span class="badge bg-light text-dark ms-2">VIP-401</span>
                    </div>
                    <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-2">Disponible</span>
                </div>

                <div class="d-flex align-items-center justify-content-between">
                    <div class="text-center">
                        <div class="fw-bold fs-4 text-dark">08:30</div>
                        <div class="small text-muted">UIO - Quito</div>
                    </div>

                    <div class="flex-grow-1 px-4 text-center">
                        <div class="small text-muted mb-1">1h 15m</div>
                        <div style="border-top: 2px dashed #adb5bd; position: relative;">
                            <span class="badge bg-warning text-dark rounded-pill position-absolute top-50 start-50 translate-middle" style="font-size: 10px;">1 escala</span>
                        </div>
                        <div class="small text-muted mt-1">Directo</div>
                    </div>

                    <div class="text-center">
                        <div class="fw-bold fs-4 text-dark">09:45</div>
                        <div class="small text-muted">GYE - Guayaquil</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div>
                        <span class="small text-muted">Desde</span>
                        <span class="fw-bold fs-5 text-dark">$120.00</span>
                        <span class="small text-muted">/ pasajero</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary px-3">Ver detalles</button>
                        <button class="btn btn-sm px-4 text-white fw-semibold rounded-3" style="background-color: #37474f; border-color: #37474f;">Seleccionar vuelo</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4" style="border: 1px solid #e0e0e0 !important;">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <span class="fw-bold text-dark">Aerolínea VIP</span>
                        <span class="badge bg-light text-dark ms-2">VIP-705</span>
                    </div>
                    <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-2">Disponible</span>
                </div>

                <div class="d-flex align-items-center justify-content-between">
                    <div class="text-center">
                        <div class="fw-bold fs-4 text-dark">10:15</div>
                        <div class="small text-muted">UIO - Quito</div>
                    </div>

                    <div class="flex-grow-1 px-4 text-center">
                        <div class="small text-muted mb-1">1h 25m</div>
                        <div style="border-top: 2px dashed #adb5bd; position: relative;">
                            <span class="badge bg-warning text-dark rounded-pill position-absolute top-50 start-50 translate-middle" style="font-size: 10px;">1 escala</span>
                        </div>
                        <div class="small text-muted mt-1">Vía Guayaquil</div>
                    </div>

                    <div class="text-center">
                        <div class="fw-bold fs-4 text-dark">11:40</div>
                        <div class="small text-muted">GYE - Guayaquil</div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <div>
                        <span class="small text-muted">Desde</span>
                        <span class="fw-bold fs-5 text-dark">$135.00</span>
                        <span class="small text-muted">/ pasajero</span>
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-secondary px-3">Ver detalles</button>
                        <button class="btn btn-sm px-4 text-white fw-semibold rounded-3" style="background-color: #37474f; border-color: #37474f;">Seleccionar vuelo</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
