@using System
@using System.Collections.Generic
@using System.Globalization
@using Con_Autenticacion.Models

@model Vuelo

@{
    ViewBag.Title = "Disponibilidad de Asientos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // DATOS REALES PROVISTOS POR EL CONTROLADOR (sin datos ficticios).
    int capacidadTotal = (int)(ViewBag.CapacidadTotal ?? 0);
    int capacidadAplicable = (int)(ViewBag.CapacidadAplicable ?? 0);
    int limitePantalla = (int)(ViewBag.LimitePantalla ?? 7);
    bool capacidadExcedeLimite = (bool)(ViewBag.CapacidadExcedeLimite ?? false);
    int limiteSeleccion = (int)(ViewBag.LimiteSeleccion ?? 0);
    int cantidadPasajeros = (int)(ViewBag.CantidadPasajeros ?? 0);
    bool estadoOperativoValido = (bool)(ViewBag.EstadoOperativoValido ?? true);
    string mensajeEstado = (string)(ViewBag.MensajeEstado ?? "");
    bool excedeLimitePantalla = (bool)(ViewBag.ExcedeLimitePantalla ?? false);
    bool excedeDisponibilidadVista = (bool)(ViewBag.ExcedeDisponibilidad ?? false);
    string errorValidacion = (string)(ViewBag.ErrorValidacion ?? "");
    string modeloAeronaveTexto = (string)(ViewBag.ModeloAeronave ?? "N/A");

    string aeropuertoOrigen =
        (string)(ViewBag.AeropuertoOrigen ?? "N/A");

    string aeropuertoDestino =
        (string)(ViewBag.AeropuertoDestino ?? "N/A");

    DateTime? fechaOperacion =
        (DateTime?)(ViewBag.FechaOperacion ?? null);

    string matricula =
        (string)(ViewBag.Matricula ?? "N/A");

    var asientos = ViewBag.Asientos as List<Asiento>
        ?? new List<Asiento>();

    var asientosOcupados =
        ViewBag.AsientosOcupados as List<string>
        ?? new List<string>();

    // ESTADOS NUEVOS:
    // DISPONIBLE, RESERVADO Y OCUPADO
    var estadosRecibidos =
        ViewBag.EstadosAsientos as IDictionary<string, string>;

    var estadosAsientos =
        new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

    if (estadosRecibidos != null)
    {
        foreach (var item in estadosRecibidos)
        {
            if (!string.IsNullOrWhiteSpace(item.Key))
            {
                estadosAsientos[item.Key.Trim()] =
                    (item.Value ?? "").Trim().ToUpperInvariant();
            }
        }
    }

    // DETERMINAR ESTADO REAL DE CADA ASIENTO
    Func<Asiento, string> obtenerEstado = asiento =>
    {
        string codigo = (asiento.Codigo ?? "").Trim();

        string estado;

        if (estadosAsientos.TryGetValue(codigo, out estado))
        {
            if (estado == "RESERVADO" ||
                estado == "PENDIENTE")
            {
                return "RESERVADO";
            }

            if (estado == "OCUPADO" ||
                estado == "CONFIRMADA")
            {
                return "OCUPADO";
            }

            return "DISPONIBLE";
        }

        // COMPATIBILIDAD CON EL CONTROLADOR ORIGINAL
        foreach (var ocupado in asientosOcupados)
        {
            if (string.Equals((ocupado ?? "").Trim(), codigo,
                StringComparison.OrdinalIgnoreCase)) return "OCUPADO";
        }

        return "DISPONIBLE";
    };

    // CONTADORES SEGUN LOS ASIENTOS REALES
    if (capacidadTotal <= 0)
    {
        capacidadTotal = asientos.Count;
    }

    int reservados = 0;
    int ocupados = 0;
    var filas = new List<byte>();
    foreach (var asiento in asientos)
    {
        string estado = obtenerEstado(asiento);
        if (estado == "RESERVADO")
        {
            reservados++;
        }
        if (estado == "OCUPADO")
        {
            ocupados++;
        }
        if (!filas.Contains(asiento.Fila))
        {
            filas.Add(asiento.Fila);
        }
    }
    filas.Sort();

    int disponibles = Math.Max(
        0, capacidadTotal - reservados - ocupados);

    string estadoVuelo =
        Model.EstadoVueloCodigo ?? "DESCONOCIDO";

    string claseEstadoVuelo =
        estadoVuelo == "CONFIRMADO" ? "bg-success" :
        estadoVuelo == "PROGRAMADO" ? "bg-primary" :
        estadoVuelo == "CANCELADO" ? "bg-danger" :
        "bg-secondary";

    string textoFecha =
        fechaOperacion.HasValue
        ? fechaOperacion.Value.ToString(
            "dd MMM yyyy",
            new CultureInfo("es-EC"))
        : Model.FechaOperacion.ToString(
            "dd MMM yyyy",
            new CultureInfo("es-EC"));

    // Solo se puede continuar si el vuelo esta en un estado operativo valido
    // y la cantidad solicitada es compatible con el limite de esta pantalla
    // y con la disponibilidad real.
    bool puedeContinuar = estadoOperativoValido && limiteSeleccion > 0;
}

<style>
    .vip-disponibilidad {
        max-width: 1150px;
        margin: 0 auto;
    }

    .vip-panel {
        background: #ffffff;
        border: 1px solid #e5eaf0;
        border-radius: 18px;
        box-shadow: 0 6px 24px rgba(20, 42, 60, .06);
    }

    .vip-cabecera-vuelo {
        background: linear-gradient( 115deg, #172a3b, #29465d );
        border-radius: 18px;
        color: #ffffff;
    }

        .vip-cabecera-vuelo .vip-dato {
            color: #d7e3ec;
            font-size: 12px;
        }

        .vip-cabecera-vuelo .vip-ruta {
            font-weight: 800;
            font-size: 23px;
            letter-spacing: .5px;
        }

        .vip-cabecera-vuelo .vip-etiqueta {
            color: #e8c987;
            font-weight: 600;
            font-size: 12px;
        }

    .vip-indicador {
        text-align: center;
        padding: 19px 10px;
        border-radius: 13px;
        background: #f8fafc;
        height: 100%;
    }

        .vip-indicador .numero {
            font-size: 29px;
            font-weight: 800;
            line-height: 1.3;
        }

        .vip-indicador .etiqueta {
            color: #64748b;
            font-size: 13px;
            font-weight: 600;
        }

    .vip-mapa {
        padding: 30px 16px;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 25px 25px 15px 15px;
        max-width: 350px;
        margin: auto;
    }

    .vip-frente {
        font-size: 11px;
        text-align: center;
        color: #64748b;
        letter-spacing: 1px;
        font-weight: 700;
        margin-bottom: 23px;
    }

    .vip-fila-dinamica {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .vip-numero-fila {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        min-width: 20px;
    }

    .vip-asientos-fila {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

    .vip-pasillo {
        text-align: center;
        font-size: 10px;
        color: #94a3b8;
        padding: 0 6px;
    }

    .vip-asiento {
        height: 54px;
        width: 60px;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 800;
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .vip-libre {
        background: #dcfce7;
        color: #166534;
        border: 2px solid #22c55e;
        cursor: pointer;
    }

        .vip-libre:hover {
            background: #bbf7d0;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(22, 163, 74, .18);
        }

    .vip-reservado {
        background: #7c3aed;
        color: white;
        border: 2px solid #6d28d9;
        cursor: not-allowed;
        opacity: 1 !important;
    }

    .vip-ocupado {
        background: #dc2626;
        color: white;
        border: 2px solid #b91c1c;
        cursor: not-allowed;
        opacity: 1 !important;
    }

    .vip-seleccionado {
        background: #15803d !important;
        color: white !important;
        border: 2px solid #166534 !important;
        box-shadow: 0 4px 13px rgba(21, 128, 61, .25);
    }

    .vip-leyenda {
        width: 14px;
        height: 14px;
        display: inline-block;
        border-radius: 4px;
        margin-right: 5px;
        vertical-align: middle;
    }

    .vip-boton-principal {
        background: #172a3b;
        border-color: #172a3b;
        color: white;
        font-weight: 600;
        border-radius: 9px;
    }

        .vip-boton-principal:hover {
            background: #29465d;
            color: white;
        }

        .vip-boton-principal:disabled {
            background: #94a3b8;
            border-color: #94a3b8;
            color: white;
        }

    @@media (max-width: 767px) {
        .vip-cabecera-vuelo .vip-ruta {
            font-size: 18px;
        }

        .vip-indicador .numero {
            font-size: 23px;
        }

        .vip-mapa {
            max-width: 100%;
        }
    }
</style>

<div class="container py-4 vip-disponibilidad"
     id="configuracionDisponibilidad"
     data-limite-seleccion="@limiteSeleccion"
     data-cantidad-pasajeros="@cantidadPasajeros"
     data-puede-continuar="@puedeContinuar.ToString().ToLowerInvariant()">

    <!-- TITULO -->
    <div class="mb-4">

        <h2 class="h4 fw-bold text-dark mb-1">
            Disponibilidad de Asientos
        </h2>

        <p class="small text-muted mb-0">
            Consulta la disponibilidad y selecciona
            tus asientos para continuar con la reserva.
        </p>

    </div>

    <!-- ALERTAS DE VALIDACION (todas basadas en datos reales del servidor) -->
    @if (!string.IsNullOrWhiteSpace(errorValidacion))
    {
        <div class="alert alert-danger" role="alert">
            @errorValidacion
        </div>
    }

    @if (!estadoOperativoValido)
    {
        <div class="alert alert-warning" role="alert">
            <strong>No es posible continuar:</strong> @mensajeEstado
        </div>
    }
    else if (excedeLimitePantalla)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Ajusta el n&uacute;mero de pasajeros:</strong>
            se solicitaron @cantidadPasajeros pasajero(s), pero esta pantalla solo permite
            gestionar un maximo de @limitePantalla asientos por operacion.
        </div>
    }
    else if (excedeDisponibilidadVista)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Ajusta el n&uacute;mero de pasajeros:</strong>
            no hay suficientes asientos disponibles (@disponibles) para los @cantidadPasajeros
            pasajero(s) solicitados.
        </div>
    }

    @if (capacidadExcedeLimite)
    {
        <div class="alert alert-info" role="alert">
            La aeronave asignada tiene una capacidad real de <strong>@capacidadTotal</strong> asientos
            (registrada en ModeloAeronave.CapacidadAsientos). Esta pantalla, segun su especificacion,
            solo gestiona la seleccion de hasta <strong>@limitePantalla</strong> asientos por operacion;
            el resto de la capacidad fisica de la aeronave no se modifica ni se oculta en SQL Server.
        </div>
    }

    <!-- INFORMACION DEL VUELO -->
    <div class="vip-cabecera-vuelo p-4 mb-4">

        <div class="row align-items-center g-3">

            <div class="col-md-8">

                <div class="vip-etiqueta mb-2">
                    AEROLINEA VIP
                </div>

                <div class="vip-ruta">
                    @aeropuertoOrigen
                    <span class="mx-2">&rarr;</span>
                    @aeropuertoDestino
                </div>

                <div class="vip-dato mt-2">

                    Vuelo
                    @("VIP" + Model.VueloId.ToString("D5"))

                    <span class="mx-2">&bull;</span>

                    @textoFecha

                    <span class="mx-2">&bull;</span>

                    Aeronave @matricula
                    @if (modeloAeronaveTexto != "N/A")
                    {
                        <text> (@modeloAeronaveTexto)</text>
                    }

                </div>

            </div>

            <div class="col-md-4 text-md-end">

                <div class="vip-dato mb-2">
                    Estado del vuelo
                </div>

                <span class="badge @claseEstadoVuelo px-3 py-2">
                    @estadoVuelo
                </span>

            </div>

        </div>

    </div>

    <!-- INDICADORES -->
    <div class="vip-panel p-3 p-md-4 mb-4">

        <div class="row g-3">

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="etiqueta">Capacidad</div>
                    <div class="numero text-dark">
                        @capacidadTotal
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="etiqueta">Reservados</div>
                    <div class="numero"
                         style="color:#7c3aed;">
                        @reservados
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="etiqueta">Ocupados</div>
                    <div class="numero text-danger">
                        @ocupados
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="etiqueta">Disponibles</div>
                    <div class="numero text-success">
                        @disponibles
                    </div>
                </div>
            </div>

        </div>

        <div class="row g-2 mt-1 small text-muted">
            <div class="col-6 col-md-3">
                Limite de esta pantalla: <strong class="text-dark">@limitePantalla asientos</strong>
            </div>
            <div class="col-6 col-md-3">
                Capacidad aplicable: <strong class="text-dark">@capacidadAplicable</strong>
            </div>
            <div class="col-6 col-md-3">
                Pasajeros solicitados:
                <strong class="text-dark">@(cantidadPasajeros > 0 ? cantidadPasajeros.ToString() : "No especificado")</strong>
            </div>
            <div class="col-6 col-md-3">
                Max. a seleccionar ahora: <strong class="text-dark">@limiteSeleccion</strong>
            </div>
        </div>

    </div>

    <!-- MAPA DE ASIENTOS -->
    <div class="vip-panel p-4 mb-4">

        <div class="d-flex flex-wrap
                    justify-content-between
                    align-items-center gap-3 mb-4">

            <div>
                <h5 class="fw-bold text-dark mb-1">
                    Mapa de asientos
                </h5>

                <p class="small text-muted mb-0">
                    Distribuci&oacute;n de asientos de esta
                    aeronave (@asientos.Count asiento(s)).
                </p>
            </div>

            <!-- LEYENDA -->
            <div class="d-flex flex-wrap gap-3 small">

                <span>
                    <i class="vip-leyenda"
                       style="background:#dcfce7;
                              border:1px solid #22c55e;"></i>
                    Disponible
                </span>

                <span>
                    <i class="vip-leyenda"
                       style="background:#7c3aed;"></i>
                    Reservado
                </span>

                <span>
                    <i class="vip-leyenda"
                       style="background:#dc2626;"></i>
                    Ocupado
                </span>

                <span>
                    <i class="vip-leyenda"
                       style="background:#15803d;"></i>
                    Seleccionado
                </span>

            </div>

        </div>

        @if (asientos.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                No existen asientos configurados
                para la aeronave de este vuelo.
            </div>
        }
        else
        {
            <div class="vip-mapa">

                <div class="vip-frente">
                    PARTE DELANTERA
                </div>

                @foreach (var fila in filas)
                {
                    // Agrupacion en memoria sobre una lista ya recuperada de
                    // SQL Server (no es una consulta nueva a la base de
                    // datos). No se asume cantidad fija de asientos por fila.
                    var asientosFila = new List<Asiento>();
                    foreach (var asiento in asientos)
                    {
                        if (asiento.Fila == fila)
                        {
                            asientosFila.Add(asiento);
                        }
                    }
                    asientosFila.Sort(delegate (Asiento a, Asiento b)
                    {
                        int orden = string.Compare((a.Lado ?? "").Trim(), (b.Lado ?? "").Trim(),
                            StringComparison.OrdinalIgnoreCase);
                        return orden != 0 ? orden : a.NumeroAsiento.CompareTo(b.NumeroAsiento);
                    });

                    <div class="vip-fila-dinamica">

                        <!-- NUMERO DE FILA -->
                        <span class="vip-numero-fila">
                            @fila
                        </span>

                        <div class="vip-asientos-fila">

                            @{ string ladoAnterior = null; }

                            @foreach (var asiento in asientosFila)
                            {
                                string ladoActual =
                                    (asiento.Lado ?? "").Trim().ToUpperInvariant();

                                // El separador de pasillo se inserta solo
                                // cuando cambia el lado real del asiento,
                                // sin asumir una distribucion fija.
                                if (ladoAnterior != null &&
                                    ladoActual != ladoAnterior)
                                {
                                    <span class="vip-pasillo">
                                        PASILLO
                                    </span>
                                }

                                ladoAnterior = ladoActual;

                                string codigo =
                                    (asiento.Codigo ?? "").Trim();

                                string estado = obtenerEstado(asiento);

                                bool bloqueado =
                                    estado != "DISPONIBLE" ||
                                    !estadoOperativoValido;

                                string clase =
                                    estado == "RESERVADO"
                                    ? "vip-reservado"
                                    : estado == "OCUPADO"
                                      ? "vip-ocupado"
                                      : "vip-libre";

                                <button type="button"
                                        class="vip-asiento @clase js-asiento"
                                        data-asiento="@codigo"
                                        aria-label="Asiento @codigo: @estado"
                                        aria-pressed="false"
                                        title="@estado"
                                        disabled="@(bloqueado ? "disabled" : null)">
                                    @codigo
                                </button>
                            }

                        </div>

                    </div>
                }

                <div class="text-center small text-muted mt-4">
                    PARTE POSTERIOR
                </div>

            </div>
        }

        <div class="text-center small text-muted mt-4">

            Selecciona uno o varios asientos verdes.
            Puedes pulsarlos nuevamente para quitar la seleccion.

        </div>

    </div>

    <!-- RESUMEN Y BOTONES -->
    <div class="vip-panel p-4">

        <div class="row align-items-center g-3">

            <div class="col-md-6">

                <div class="fw-bold text-dark mb-1">
                    Tu seleccion
                </div>
                <div class="mt-3 mb-3">
                    <label for="cantidadPasajerosSelector" class="form-label fw-semibold text-dark">N&uacute;mero de pasajeros</label>
                    <select id="cantidadPasajerosSelector" class="form-select" data-maximo="@limiteSeleccion" style="max-width:230px"
                            aria-describedby="ayudaCantidad" data-inicial="@cantidadPasajeros">
                        @for (int n = 1; n <= limiteSeleccion; n++)
                        {
                            if (n == cantidadPasajeros)
                            {
                                <option value="@n" selected="selected">@n pasajero(s)</option>
                            }
                            else
                            {
                                <option value="@n">@n pasajero(s)</option>
                            }
                        }
                    </select>
                    <div id="ayudaCantidad" class="small text-muted mt-1">
                        Puedes reservar varios asientos, uno por cada pasajero, hasta los disponibles.
                    </div>
                </div>


                <div class="small text-muted">
                    Asientos seleccionados:
                </div>

                <div id="asientosSeleccionados"
                     class="mt-2"
                     aria-live="polite">

                    <span class="text-muted">
                        Ninguno
                    </span>

                </div>

                <div id="contadorSeleccion"
                     class="small text-success mt-2">
                    0 asientos seleccionados
                </div>

            </div>

            <div class="col-md-6">

                <div class="d-flex flex-wrap
                            justify-content-md-end gap-2">

                    <a href="@Url.Action("Index", "Vueloes")"
                       class="btn btn-outline-secondary px-3">
                        Volver
                    </a>

                    <a href="@Url.Action(
                        "DisponibilidadAsientos",
                        "Vueloes",
                        new { vueloId = Model.VueloId, cantidadPasajeros = cantidadPasajeros })"
                       class="btn btn-outline-primary px-3">
                        Actualizar disponibilidad
                    </a>

                    <form id="formContinuar"
                          method="post"
                          action="@Url.Action("ConfirmarSeleccionAsientos", "Vueloes")"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="vueloId"
                               value="@Model.VueloId" />

                        <input type="hidden"
                               id="cantidadPasajerosHidden"
                               name="cantidadPasajeros"
                               value="@cantidadPasajeros" />

                        <input type="hidden"
                               id="codigosAsientosInput"
                               name="codigosAsientos"
                               value="" />

                        <button type="submit"
                                id="btnContinuar"
                                class="btn vip-boton-principal px-4"
                                disabled>
                            Continuar
                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

    <p class="text-center small text-muted mt-3">
        La seleccion es provisional.
        Los asientos se validaran nuevamente
        al registrar la reserva.
    </p>

</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/vip-asientos-multiples.js")"></script>
}
