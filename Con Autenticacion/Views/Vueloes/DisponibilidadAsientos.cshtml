@{
    ViewBag.Title = "Disponibilidad de Asientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Disponibilidad de Asientos</h2>
        <p class="small text-muted mb-4">
            Vuelo <strong>VIP-401</strong> · <strong>Quito (UIO)</strong> → <strong>Guayaquil (GYE)</strong> · <strong>28 Oct 2026</strong> · Aeronave: <strong>Airbus A320</strong>.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-3 text-center">
            <div class="col-md-3">
                <div class="small text-muted fw-bold">Capacidad</div>
                <div class="fs-4 fw-bold text-dark">180</div>
            </div>

            <div class="col-md-3">
                <div class="small text-muted fw-bold">Ocupados</div>
                <div class="fs-4 fw-bold text-danger">145</div>
            </div>

            <div class="col-md-3">
                <div class="small text-muted fw-bold">Disponibles</div>
                <div class="fs-4 fw-bold text-success">35</div>
            </div>

            <div class="col-md-3">
                <div class="small text-muted fw-bold">Estado del vuelo</div>
                <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-2">Programado</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark mb-0">Selecciona tu asiento</h5>
            <div>
                <span class="badge bg-light text-dark border me-2">Libre</span>
                <span class="badge bg-secondary text-white me-2">Ocupado</span>
                <span class="badge bg-success text-white me-2">Seleccionado</span>
            </div>
        </div>

        <div class="d-flex flex-column align-items-center gap-2">
            <div class="d-flex gap-3 justify-content-center">
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">1A</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">1B</button>
                <button class="btn btn-sm btn-success fw-bold" style="width: 45px; height: 45px;">1C</button>
                <div style="width: 30px;"></div>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">1D</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">1E</button>
                <button class="btn btn-sm btn-secondary fw-bold" style="width: 45px; height: 45px;" disabled>1F</button>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">2A</button>
                <button class="btn btn-sm btn-secondary fw-bold" style="width: 45px; height: 45px;" disabled>2B</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">2C</button>
                <div style="width: 30px;"></div>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">2D</button>
                <button class="btn btn-sm btn-success fw-bold" style="width: 45px; height: 45px;">2E</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">2F</button>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">3A</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">3B</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">3C</button>
                <div style="width: 30px;"></div>
                <button class="btn btn-sm btn-secondary fw-bold" style="width: 45px; height: 45px;" disabled>3D</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">3E</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">3F</button>
            </div>

            <div class="d-flex gap-3 justify-content-center">
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">4A</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">4B</button>
                <button class="btn btn-sm btn-secondary fw-bold" style="width: 45px; height: 45px;" disabled>4C</button>
                <div style="width: 30px;"></div>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">4D</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">4E</button>
                <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">4F</button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                <span class="fw-bold text-dark">2 asientos seleccionados:</span> 1C, 2A
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary px-4">Actualizar disponibilidad</button>
                <button class="btn px-4 text-white fw-bold rounded-3" style="background-color: #37474f; border-color: #37474f;">Continuar</button>
            </div>
        </div>
    </div>
</div>
