@using Con_Autenticacion.Models
@model Vuelo

@{
    ViewBag.Title = "Disponibilidad de Asientos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var capacidad = (int)(ViewBag.Capacidad ?? 0);
    var ocupados = (int)(ViewBag.Ocupados ?? 0);
    var restantes = (int)(ViewBag.Restantes ?? 0);
    var aeropuertoOrigen = (string)(ViewBag.AeropuertoOrigen ?? "N/A");
    var aeropuertoDestino = (string)(ViewBag.AeropuertoDestino ?? "N/A");
    var fechaOperacion = (DateTime?)(ViewBag.FechaOperacion ?? null);
    var matricula = (string)(ViewBag.Matricula ?? "N/A");
    var asientosOcupados = (List<string>)(ViewBag.AsientosOcupados ?? new List<string>());
    var asientos = (List<Asiento>)(ViewBag.Asientos ?? new List<Asiento>());
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Disponibilidad de Asientos</h2>
        <p class="small text-muted mb-4">
            Vuelo @Html.DisplayFor(modelItem => modelItem.VueloId) · <strong>@aeropuertoOrigen</strong> → <strong>@aeropuertoDestino</strong> · <strong>@(fechaOperacion.HasValue ? fechaOperacion.Value.ToString("dd MMM yyyy") : "N/A")</strong> · Aeronave: <strong>@matricula</strong>.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-3 text-center">
            <div class="col-md-3">
                <div class="small text-muted fw-bold">Capacidad</div>
                <div class="fs-4 fw-bold text-dark">@capacidad</div>
            </div>

            <div class="col-md-3">
                <div class="small text-muted fw-bold">Ocupados</div>
                <div class="fs-4 fw-bold text-danger">@ocupados</div>
            </div>

            <div class="col-md-3">
                <div class="small text-muted fw-bold">Disponibles</div>
                <div class="fs-4 fw-bold text-success">@restantes</div>
            </div>

            <div class="col-md-3">
                <div class="small text-muted fw-bold">Estado del vuelo</div>
                @if (Model != null && Model.EstadoVuelo != null)
                {
                    <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-2">@Html.DisplayFor(modelItem => modelItem.EstadoVuelo.Descripcion)</span>
                }
                else
                {
                    <span class="badge bg-secondary bg-opacity-75 rounded-pill px-3 py-2">Desconocido</span>
                }
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark mb-0">Selecciona tu asiento</h5>
            <div>
                <span class="badge bg-light text-dark border me-2">Libre</span>
                <span class="badge bg-secondary text-white me-2">Ocupado</span>
                <span class="badge bg-success text-white me-2">Seleccionado</span>
            </div>
        </div>

        <div class="d-flex flex-column align-items-center gap-2">
            @{
                var asientosPorFila = new System.Collections.Hashtable();

                foreach (var asiento in asientos)
                {
                    var filaKey = asiento.Fila.ToString();
                    if (!asientosPorFila.ContainsKey(filaKey))
                    {
                        asientosPorFila[filaKey] = new List<Asiento>();
                    }
                    ((List<Asiento>)asientosPorFila[filaKey]).Add(asiento);
                }

                var filasKeys = new List<string>();
                foreach (var key in asientosPorFila.Keys)
                {
                    filasKeys.Add(key.ToString());
                }

                for (int i = 0; i < filasKeys.Count - 1; i++)
                {
                    for (int j = 0; j < filasKeys.Count - 1 - i; j++)
                    {
                        if (int.Parse(filasKeys[j]) > int.Parse(filasKeys[j + 1]))
                        {
                            var temp = filasKeys[j];
                            filasKeys[j] = filasKeys[j + 1];
                            filasKeys[j + 1] = temp;
                        }
                    }
                }

                foreach (var filaKey in filasKeys)
                {
                    var asientosEnFila = (List<Asiento>)asientosPorFila[filaKey];
                    <div class="d-flex gap-3 justify-content-center">
                        @{
                            for (int i = 0; i < asientosEnFila.Count - 1; i++)
                            {
                                for (int j = 0; j < asientosEnFila.Count - 1 - i; j++)
                                {
                                    if (asientosEnFila[j].Lado.CompareTo(asientosEnFila[j + 1].Lado) > 0)
                                    {
                                        var temp = asientosEnFila[j];
                                        asientosEnFila[j] = asientosEnFila[j + 1];
                                        asientosEnFila[j + 1] = temp;
                                    }
                                }
                            }

                            int contador = 0;
                            foreach (var asiento in asientosEnFila)
                            {
                                var estaOcupado = false;
                                foreach (var codigoOcupado in asientosOcupados)
                                {
                                    if (codigoOcupado == asiento.Codigo)
                                    {
                                        estaOcupado = true;
                                        break;
                                    }
                                }

                                if (contador == 3)
                                {
                                    <div style="width: 30px;"></div>
                                }

                                if (estaOcupado)
                                {
                                    <button class="btn btn-sm btn-secondary fw-bold" style="width: 45px; height: 45px;" disabled>@asiento.Codigo</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;">@asiento.Codigo</button>
                                }

                                contador++;
                            }
                        }
                    </div>
                }
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="d-flex justify-content-between align-items-center">
            <div class="small text-muted">
                <span class="fw-bold text-dark">Asientos seleccionados:</span> <span id="asientosSeleccionados">Ninguno</span>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary px-4">Actualizar disponibilidad</button>
                <a href="@Url.Action("Seleccionar", "Vueloes", new { vueloId = Model.VueloId })" class="btn px-4 text-white fw-bold rounded-3" style="background-color: #37474f; border-color: #37474f;">Continuar</a>
            </div>
        </div>
    </div>
</div>
