@using System
@using System.Collections.Generic
@using System.Globalization
@using Con_Autenticacion.Models

@model Vuelo

@{
    ViewBag.Title = "Seleccion de Vuelo y Asiento";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // DATOS REALES ENVIADOS POR VueloesController.Seleccionar()
    int capacidad = (int)(ViewBag.Capacidad ?? 0);
    int capacidadAplicable = (int)(ViewBag.CapacidadAplicable ?? 0);
    int limitePantalla = (int)(ViewBag.LimitePantalla ?? 7);
    int limiteSeleccion = (int)(ViewBag.LimiteSeleccion ?? 0);
    int cantidadPasajeros = (int)(ViewBag.CantidadPasajeros ?? 1);
    int disponibles = (int)(ViewBag.Disponibles ?? 0);
    int ocupados = (int)(ViewBag.Ocupados ?? 0);
    bool estadoOperativoValido = (bool)(ViewBag.EstadoOperativoValido ?? false);
    bool excedeLimitePantalla = (bool)(ViewBag.ExcedeLimitePantalla ?? false);
    bool excedeDisponibilidad = (bool)(ViewBag.ExcedeDisponibilidad ?? false);
    bool capacidadExcedeLimite = (bool)(ViewBag.CapacidadExcedeLimite ?? false);
    string mensajeEstado = (string)(ViewBag.MensajeEstado ?? "");
    string errorValidacion = (string)(ViewBag.ErrorValidacion ?? "");

    string aeropuertoOrigen = (string)(ViewBag.AeropuertoOrigen ?? "N/A");
    string aeropuertoDestino = (string)(ViewBag.AeropuertoDestino ?? "N/A");
    string aeropuertoOrigenNombre = (string)(ViewBag.AeropuertoOrigenNombre ?? "");
    string aeropuertoDestinoNombre = (string)(ViewBag.AeropuertoDestinoNombre ?? "");
    string horaPartida = (string)(ViewBag.HoraPartida ?? "--:--");
    string horaLlegada = (string)(ViewBag.HoraLlegada ?? "--:--");
    string matricula = (string)(ViewBag.Matricula ?? "N/A");
    string modeloAeronave = (string)(ViewBag.ModeloAeronave ?? "N/A");
    string estadoVueloDescripcion = (string)(ViewBag.EstadoVueloDescripcion ?? "");

    DateTime? fechaOperacion = ViewBag.FechaOperacion;
    int? origenId = ViewBag.AeropuertoOrigenId;
    int? destinoId = ViewBag.AeropuertoDestinoId;

    List<Asiento> asientos = ViewBag.Asientos as List<Asiento> ?? new List<Asiento>();
    List<string> asientosOcupados = ViewBag.AsientosOcupados as List<string> ?? new List<string>();
    List<string> asientosSeleccionados = ViewBag.AsientosSeleccionados as List<string> ?? new List<string>();

    IDictionary<string, string> estadosRecibidos = ViewBag.EstadosAsientos as IDictionary<string, string>;
    Dictionary<string, string> estadosAsientos = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    if (estadosRecibidos != null)
    {
        foreach (var item in estadosRecibidos)
        {
            if (!string.IsNullOrWhiteSpace(item.Key))
            {
                estadosAsientos[item.Key.Trim()] = (item.Value ?? "").Trim().ToUpperInvariant();
            }
        }
    }

    Func<Asiento, string> obtenerEstado = asiento =>
    {
        string codigo = (asiento.Codigo ?? "").Trim();
        string estado;

        if (estadosAsientos.TryGetValue(codigo, out estado))
        {
            if (estado == "PENDIENTE")
            {
                return "RESERVADO";
            }

            if (estado == "CONFIRMADA")
            {
                return "OCUPADO";
            }

            return "DISPONIBLE";
        }

        foreach (var ocupado in asientosOcupados)
        {
            if (string.Equals((ocupado ?? "").Trim(), codigo, StringComparison.OrdinalIgnoreCase))
            {
                return "OCUPADO";
            }
        }

        return "DISPONIBLE";
    };

    Func<string, bool> fueSeleccionado = codigo =>
    {
        foreach (var seleccionado in asientosSeleccionados)
        {
            if (string.Equals((seleccionado ?? "").Trim(), codigo, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }
        return false;
    };

    int reservadosVista = 0;
    int ocupadosVista = 0;
    int disponiblesVista = 0;
    foreach (var asiento in asientos)
    {
        string estadoAsiento = obtenerEstado(asiento);
        if (estadoAsiento == "RESERVADO")
        {
            reservadosVista++;
        }
        else if (estadoAsiento == "OCUPADO")
        {
            ocupadosVista++;
        }
        else
        {
            disponiblesVista++;
        }
    }

    // Filas reales de los asientos recuperados de SQL Server. No se asume
    // ninguna distribucion fija de filas ni columnas.
    List<byte> filas = new List<byte>();
    foreach (var asiento in asientos)
    {
        if (!filas.Contains(asiento.Fila))
        {
            filas.Add(asiento.Fila);
        }
    }
    filas.Sort();

    if (capacidad <= 0)
    {
        capacidad = asientos.Count;
    }

    bool permiteSeleccion = estadoOperativoValido && limiteSeleccion > 0;

    bool seleccionInicialCompleta = permiteSeleccion &&
        cantidadPasajeros > 0 && asientosSeleccionados.Count == cantidadPasajeros;

    string fechaTexto = fechaOperacion.HasValue
        ? fechaOperacion.Value.ToString("dd MMM yyyy", new CultureInfo("es-EC"))
        : Model.FechaOperacion.ToString("dd MMM yyyy", new CultureInfo("es-EC"));

    string estadoVuelo = Model.EstadoVueloCodigo ?? "DESCONOCIDO";
    string claseEstadoVuelo =
        estadoVuelo == "CONFIRMADO" ? "bg-success" :
        estadoVuelo == "PROGRAMADO" ? "bg-primary" :
        estadoVuelo == "CANCELADO" ? "bg-danger" :
        "bg-secondary";

    string estadoSeleccionTexto = seleccionInicialCompleta
        ? "Seleccion completa"
        : (cantidadPasajeros > asientosSeleccionados.Count
            ? "Faltan " + (cantidadPasajeros - asientosSeleccionados.Count) + " asiento(s)"
            : "Seleccion incompleta");
}

<style>
    .vip-seleccion {
        max-width: 1150px;
        margin: auto;
    }

    .vip-card {
        background: #ffffff;
        border: 1px solid #e5eaf0;
        border-radius: 18px;
        box-shadow: 0 6px 24px rgba(20, 42, 60, .06);
    }

    .vip-vuelo-header {
        background: linear-gradient(115deg, #172a3b, #29465d);
        border-radius: 18px;
        color: white;
        padding: 28px;
    }

    .vip-ruta {
        font-size: 23px;
        font-weight: 800;
    }

    .vip-subdato {
        color: #d7e3ec;
        font-size: 13px;
    }

    .vip-titulo {
        color: #e8c987;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .vip-indicador {
        background: #f8fafc;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        height: 100%;
    }

        .vip-indicador .numero {
            font-size: 25px;
            font-weight: 800;
        }

        .vip-indicador .nombre {
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
        }

    .vip-mapa {
        max-width: 420px;
        margin: auto;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 25px 25px 15px 15px;
        padding: 30px 16px;
    }

    .vip-frente {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-align: center;
        color: #64748b;
        margin-bottom: 25px;
    }

    .vip-fila-dinamica {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
    }

    .vip-numero-fila {
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        min-width: 22px;
    }

    .vip-asientos-fila {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 8px;
        flex: 1;
    }

    .vip-pasillo {
        text-align: center;
        font-size: 10px;
        color: #94a3b8;
        padding: 0 6px;
    }

    .vip-asiento {
        width: 60px;
        height: 54px;
        font-size: 15px;
        font-weight: 800;
        border-radius: 10px;
        transition: transform .15s ease;
    }

    .vip-libre {
        background: #dcfce7;
        border: 2px solid #22c55e;
        color: #166534;
        cursor: pointer;
    }

        .vip-libre:hover {
            background: #bbf7d0;
            transform: translateY(-2px);
        }

    .vip-reservado {
        background: #7c3aed;
        border: 2px solid #6d28d9;
        color: white;
        opacity: 1 !important;
        cursor: not-allowed;
    }

    .vip-ocupado {
        background: #dc2626;
        border: 2px solid #b91c1c;
        color: white;
        opacity: 1 !important;
        cursor: not-allowed;
    }

    .vip-elegido {
        background: #15803d !important;
        border: 2px solid #166534 !important;
        color: white !important;
    }

    .vip-vacio {
        display: block;
        width: 60px;
        height: 54px;
    }

    .vip-leyenda {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-block;
        vertical-align: middle;
        margin-right: 5px;
    }

    .vip-boton-principal {
        background-color: #172a3b;
        border-color: #172a3b;
        color: white;
        border-radius: 9px;
        font-weight: 700;
    }

        .vip-boton-principal:hover {
            background-color: #29465d;
            color: white;
        }

        .vip-boton-principal:disabled {
            background-color: #94a3b8;
            border-color: #94a3b8;
            color: white;
        }

    @@media (max-width: 767px) {
        .vip-ruta {
            font-size: 18px;
        }

        .vip-indicador .numero {
            font-size: 21px;
        }

        .vip-mapa {
            max-width: 100%;
        }
    }
</style>

<div class="container py-4 vip-seleccion">

    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">
            Seleccion de Vuelo y Asiento
        </h2>

        <p class="small text-muted mb-0">
            Confirma el vuelo, selecciona los asientos reales de la aeronave
            y revisa el resumen antes de continuar con el registro del pasajero.
        </p>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorValidacion))
    {
        <div class="alert alert-danger" role="alert">
            @errorValidacion
        </div>
    }

    @if (!estadoOperativoValido)
    {
        <div class="alert alert-warning" role="alert">
            <strong>No es posible continuar:</strong> @mensajeEstado
        </div>
    }
    else if (excedeLimitePantalla)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Ajusta el numero de pasajeros:</strong>
            se solicitaron @cantidadPasajeros pasajero(s), pero esta pantalla
            solo permite gestionar un maximo de @limitePantalla asientos por operacion.
        </div>
    }
    else if (excedeDisponibilidad)
    {
        <div class="alert alert-warning" role="alert">
            <strong>Ajusta el numero de pasajeros:</strong>
            no hay suficientes asientos disponibles (@disponibles) para los
            @cantidadPasajeros pasajero(s) solicitados.
        </div>
    }

    @if (capacidadExcedeLimite)
    {
        <div class="alert alert-info" role="alert">
            La aeronave tiene una capacidad real de <strong>@capacidad</strong> asientos.
            Esta pantalla solo permite seleccionar hasta <strong>@limitePantalla</strong>
            asientos por operacion; la capacidad almacenada en SQL Server no se modifica.
        </div>
    }

    <!-- INFORMACION REAL DEL VUELO -->
    <div class="vip-vuelo-header mb-4">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <div class="vip-titulo mb-2">
                    AEROLINEA VIP
                </div>

                <div class="vip-ruta">
                    @aeropuertoOrigen
                    <span class="mx-2">&rarr;</span>
                    @aeropuertoDestino
                </div>

                @if (!string.IsNullOrWhiteSpace(aeropuertoOrigenNombre) ||
                     !string.IsNullOrWhiteSpace(aeropuertoDestinoNombre))
                {
                    <div class="vip-subdato mt-1">
                        @aeropuertoOrigenNombre
                        <span class="mx-2">&rarr;</span>
                        @aeropuertoDestinoNombre
                    </div>
                }

                <div class="vip-subdato mt-2">
                    Vuelo @("VIP" + Model.VueloId.ToString("D5"))
                    <span class="mx-2">&bull;</span>
                    @fechaTexto
                    <span class="mx-2">&bull;</span>
                    Aeronave @matricula
                    @if (modeloAeronave != "N/A")
                    {
                        <text> (@modeloAeronave)</text>
                    }
                </div>
            </div>

            <div class="col-md-4 text-md-end">
                <div class="vip-subdato mb-2">
                    Horario del vuelo
                </div>

                <div class="fs-5 fw-bold">
                    @horaPartida
                    <span class="mx-1">&rarr;</span>
                    @horaLlegada
                </div>

                <span class="badge @claseEstadoVuelo mt-2 px-3 py-2">
                    @estadoVuelo
                </span>

                @if (!string.IsNullOrWhiteSpace(estadoVueloDescripcion))
                {
                    <div class="vip-subdato mt-1">@estadoVueloDescripcion</div>
                }
            </div>
        </div>
    </div>

    <!-- INDICADORES REALES -->
    <div class="vip-card p-3 p-md-4 mb-4">
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Capacidad</div>
                    <div class="numero text-dark">@capacidad</div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Reservados</div>
                    <div class="numero" style="color:#7c3aed;">@reservadosVista</div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Ocupados</div>
                    <div class="numero text-danger">@ocupadosVista</div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Disponibles</div>
                    <div class="numero text-success">@disponiblesVista</div>
                </div>
            </div>
        </div>

        <div class="row g-2 mt-1 small text-muted">
            <div class="col-6 col-md-3">
                Pasajeros solicitados:
                <strong class="text-dark">@cantidadPasajeros</strong>
            </div>
            <div class="col-6 col-md-3">
                Limite de esta pantalla:
                <strong class="text-dark">@limitePantalla</strong>
            </div>
            <div class="col-6 col-md-3">
                Capacidad aplicable:
                <strong class="text-dark">@capacidadAplicable</strong>
            </div>
            <div class="col-6 col-md-3">
                Maximo a seleccionar:
                <strong class="text-dark">@limiteSeleccion</strong>
            </div>
        </div>
    </div>

    @using (Html.BeginForm("ContinuarConSeleccion", "Vueloes", FormMethod.Post,
        new { id = "formSeleccion" }))
    {
        @Html.AntiForgeryToken()

        <input type="hidden" name="vueloId" value="@Model.VueloId" />
        <input type="hidden" id="cantidadPasajerosHidden" name="cantidadPasajeros" value="@cantidadPasajeros" />
        <input type="hidden" id="codigosAsientosInput" name="codigosAsientos"
               value="@string.Join(",", asientosSeleccionados)" />

        <!-- MAPA DE ASIENTOS -->
        <div class="vip-card p-4 mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
                <div>
                    <h5 class="fw-bold text-dark mb-1">Mapa de asientos</h5>
                    <p class="small text-muted mb-0">
                        Distribucion de asientos de esta aeronave
                        (@asientos.Count asiento(s)).
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-3 small">
                    <span>
                        <i class="vip-leyenda" style="background:#dcfce7;border:1px solid #22c55e;"></i>
                        Disponible
                    </span>
                    <span>
                        <i class="vip-leyenda" style="background:#7c3aed;"></i>
                        Reservado
                    </span>
                    <span>
                        <i class="vip-leyenda" style="background:#dc2626;"></i>
                        Ocupado
                    </span>
                    <span>
                        <i class="vip-leyenda" style="background:#15803d;"></i>
                        Seleccionado
                    </span>
                </div>
            </div>

            @if (asientos.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    No existen asientos configurados para la aeronave de este vuelo.
                </div>
            }
            else
            {
                <div class="vip-mapa">
                    <div class="vip-frente">
                        PARTE DELANTERA
                    </div>

                    @foreach (var fila in filas)
                    {
                        List<Asiento> asientosFila = new List<Asiento>();
                        foreach (var asiento in asientos)
                        {
                            if (asiento.Fila == fila)
                            {
                                asientosFila.Add(asiento);
                            }
                        }

                        asientosFila.Sort(delegate (Asiento a, Asiento b)
                        {
                            int cmpLado = string.Compare((a.Lado ?? "").Trim(), (b.Lado ?? "").Trim(),
                                StringComparison.OrdinalIgnoreCase);
                            return cmpLado != 0 ? cmpLado : a.NumeroAsiento.CompareTo(b.NumeroAsiento);
                        });

                        <div class="vip-fila-dinamica">
                            <span class="vip-numero-fila">@fila</span>

                            <div class="vip-asientos-fila">
                                @{ string ladoAnterior = null; }

                                @foreach (var asiento in asientosFila)
                                {
                                    string ladoActual = (asiento.Lado ?? "").Trim().ToUpperInvariant();

                                    if (ladoAnterior != null && ladoActual != ladoAnterior)
                                    {
                                        <span class="vip-pasillo">PASILLO</span>
                                    }

                                    ladoAnterior = ladoActual;

                                    string codigo = (asiento.Codigo ?? "").Trim();
                                    string estadoAsiento = obtenerEstado(asiento);
                                    bool seleccionado = fueSeleccionado(codigo);

                                    bool bloqueado = !permiteSeleccion || estadoAsiento != "DISPONIBLE";

                                    string clase = estadoAsiento == "RESERVADO"
                                        ? "vip-reservado"
                                        : estadoAsiento == "OCUPADO"
                                            ? "vip-ocupado"
                                            : "vip-libre";

                                    if (seleccionado)
                                    {
                                        clase = clase + " vip-elegido";
                                    }

                                    <button type="button"
                                            class="vip-asiento @clase js-asiento"
                                            data-codigo="@codigo"
                                            aria-pressed="@(seleccionado ? "true" : "false")"
                                            title="@estadoAsiento"
                                            disabled="@(bloqueado ? "disabled" : null)">
                                        @codigo
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="text-center small text-muted mt-4">
                        PARTE POSTERIOR
                    </div>
                </div>
            }

            <p class="small text-muted text-center mt-4 mb-0">
                Pulsa un asiento verde para seleccionarlo o quitarlo.
                Los asientos reservados y ocupados estan bloqueados.
            </p>

            <div id="mensajeSeleccion" class="small text-danger text-center mt-2" aria-live="polite"></div>
        </div>

        <!-- RESUMEN Y NAVEGACION -->
        <div class="vip-card p-4">
            <div class="row g-3">
                <div class="col-md-7">
                    <div class="fw-bold text-dark mb-2">Resumen de la seleccion</div>
                    <div class="mt-3 mb-3">
                        <label for="cantidadPasajerosSelector" class="form-label fw-semibold text-dark">Numero de pasajeros</label>
                        <select id="cantidadPasajerosSelector" class="form-select" data-maximo="@limiteSeleccion" style="max-width:230px"
                                aria-describedby="ayudaCantidad" data-inicial="@cantidadPasajeros">
                            @for (int n = 1; n <= limiteSeleccion; n++)
                            {
                                if (n == cantidadPasajeros)
                                {
                                    <option value="@n" selected="selected">@n pasajero(s)</option>
                                }
                                else
                                {
                                    <option value="@n">@n pasajero(s)</option>
                                }
                            }
                        </select>
                        <div id="ayudaCantidad" class="small text-muted mt-1">
                            Puedes reservar varios asientos, uno por cada pasajero, hasta los disponibles.
                        </div>
                    </div>


                    <div class="small text-muted">
                        <div>
                            <strong class="text-dark">Vuelo:</strong>
                            @("VIP" + Model.VueloId.ToString("D5"))
                            &middot; @fechaTexto
                        </div>
                        <div>
                            <strong class="text-dark">Ruta:</strong>
                            @aeropuertoOrigen &rarr; @aeropuertoDestino
                        </div>
                        <div>
                            <strong class="text-dark">Pasajeros:</strong>
                            @cantidadPasajeros
                        </div>
                    </div>

                    <div class="small text-muted mt-3">
                        Asientos seleccionados
                    </div>

                    <div id="resumenAsientos" class="mt-2" aria-live="polite">
                        @if (asientosSeleccionados.Count == 0)
                        {
                            <span class="text-muted">Ninguno</span>
                        }
                        else
                        {
                            foreach (var codigo in asientosSeleccionados)
                            {
                                <span class="badge bg-success me-2 mb-1 px-3 py-2">
                                    Asiento @codigo
                                </span>
                            }
                        }
                    </div>

                    <div id="contadorSeleccion" class="small text-muted mt-2">
                        @asientosSeleccionados.Count de @cantidadPasajeros asiento(s)
                    </div>

                    <div id="estadoSeleccion"
                         class="small mt-1 fw-semibold @(seleccionInicialCompleta ? "text-success" : "text-warning")"
                         aria-live="polite">
                        @estadoSeleccionTexto
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        La seleccion es provisional. La disponibilidad se comprobara
                        nuevamente en el servidor antes de continuar.
                    </p>
                </div>

                <div class="col-md-5">
                    <div class="d-flex flex-wrap justify-content-md-end gap-2">
                        <a href="@Url.Action("DisponibilidadAsientos", "Vueloes",
                                 new { vueloId = Model.VueloId, cantidadPasajeros = cantidadPasajeros })"
                           class="btn btn-outline-secondary px-4">
                            Regresar
                        </a>

                        <button type="submit"
                                id="btnContinuar"
                                class="btn vip-boton-principal px-4"
                                disabled="@(seleccionInicialCompleta ? null : "disabled")">
                            Continuar
                        </button>
                    </div>

                    @if (origenId.HasValue && destinoId.HasValue)
                    {
                        <div class="text-md-end mt-3">
                            <a class="small text-muted"
                               href="@Url.Action("Resultados", "Vueloes", new
                                        {
                                            AeropuertoOrigenId = origenId,
                                            AeropuertoDestinoId = destinoId,
                                            Fecha = fechaOperacion,
                                            CantidadPasajeros = cantidadPasajeros
                                        })">
                                Volver a los resultados de la busqueda
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/vip-asientos-multiples.js")"></script>
}
