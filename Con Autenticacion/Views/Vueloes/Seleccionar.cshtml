
@using System
@using System.Linq
@using System.Collections.Generic
@using Con_Autenticacion.Models

@model Vuelo

@{
    ViewBag.Title = "Seleccion de Vuelo y Asiento";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int capacidad = (int)(ViewBag.Capacidad ?? 0);

    string aeropuertoOrigen =
        (string)(ViewBag.AeropuertoOrigen ?? "N/A");

    string aeropuertoDestino =
        (string)(ViewBag.AeropuertoDestino ?? "N/A");

    string horaPartida =
        (string)(ViewBag.HoraPartida ?? "--:--");

    string horaLlegada =
        (string)(ViewBag.HoraLlegada ?? "--:--");

    string matricula =
        (string)(ViewBag.Matricula ?? "N/A");

    DateTime? fechaOperacion =
        (DateTime?)(ViewBag.FechaOperacion ?? null);

    var asientos = ViewBag.Asientos as List<Asiento>
        ?? new List<Asiento>();

    var asientosOcupados =
        ViewBag.AsientosOcupados as List<string>
        ?? new List<string>();

    var estadosRecibidos =
        ViewBag.EstadosAsientos as IDictionary<string, string>;

    var estadosAsientos =
        new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

    if (estadosRecibidos != null)
    {
        foreach (var item in estadosRecibidos)
        {
            if (!string.IsNullOrWhiteSpace(item.Key))
            {
                estadosAsientos[item.Key.Trim()] =
                    (item.Value ?? "").Trim().ToUpperInvariant();
            }
        }
    }

    // Consultar el estado de cada asiento.
    Func<Asiento, string> obtenerEstado = asiento =>
    {
        string codigo = (asiento.Codigo ?? "").Trim();
        string estado;

        if (estadosAsientos.TryGetValue(codigo, out estado))
        {
            if (estado == "RESERVADO" || estado == "PENDIENTE")
            {
                return "RESERVADO";
            }

            if (estado == "OCUPADO" || estado == "CONFIRMADA")
            {
                return "OCUPADO";
            }

            return "DISPONIBLE";
        }

        // Compatibilidad con el controlador original.
        if (asientosOcupados.Any(c =>
            string.Equals(
                (c ?? "").Trim(),
                codigo,
                StringComparison.OrdinalIgnoreCase)))
        {
            return "OCUPADO";
        }

        return "DISPONIBLE";
    };

    if (capacidad <= 0)
    {
        capacidad = asientos.Count;
    }

    int reservados = asientos.Count(
        a => obtenerEstado(a) == "RESERVADO");

    int ocupados = asientos.Count(
        a => obtenerEstado(a) == "OCUPADO");

    int disponibles = asientos.Count(
        a => obtenerEstado(a) == "DISPONIBLE");

    string fechaTexto = fechaOperacion.HasValue
        ? fechaOperacion.Value.ToString("dd/MM/yyyy")
        : Model.FechaOperacion.ToString("dd/MM/yyyy");

    bool autenticado = Request.IsAuthenticated;

    bool permiteSeleccion =
        Model.EstadoVueloCodigo == "PROGRAMADO" ||
        Model.EstadoVueloCodigo == "CONFIRMADO";
}

<style>
    .vip-seleccion {
        max-width: 1150px;
        margin: auto;
    }

    .vip-card {
        background: #ffffff;
        border: 1px solid #e5eaf0;
        border-radius: 18px;
        box-shadow: 0 6px 24px rgba(20, 42, 60, .06);
    }

    .vip-vuelo-header {
        background: linear-gradient(115deg, #172a3b, #29465d);
        border-radius: 18px;
        color: white;
        padding: 28px;
    }

    .vip-ruta {
        font-size: 23px;
        font-weight: 800;
    }

    .vip-subdato {
        color: #d7e3ec;
        font-size: 13px;
    }

    .vip-titulo {
        color: #e8c987;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .vip-indicador {
        background: #f8fafc;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        height: 100%;
    }

        .vip-indicador .numero {
            font-size: 25px;
            font-weight: 800;
        }

        .vip-indicador .nombre {
            color: #64748b;
            font-size: 12px;
            font-weight: 600;
        }

    .vip-mapa {
        max-width: 350px;
        margin: auto;
        background: #f8fafc;
        border: 1px solid #e5eaf0;
        border-radius: 28px 28px 15px 15px;
        padding: 30px 15px;
    }

    .vip-frente {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        text-align: center;
        color: #64748b;
        margin-bottom: 25px;
    }

    .vip-fila {
        display: grid;
        grid-template-columns: 24px 60px 48px 60px;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-bottom: 12px;
    }

    .vip-numero {
        color: #64748b;
        font-size: 13px;
        text-align: center;
    }

    .vip-pasillo {
        font-size: 10px;
        text-align: center;
        color: #94a3b8;
    }

    .vip-asiento {
        width: 60px;
        height: 54px;
        font-size: 15px;
        font-weight: 800;
        border-radius: 10px;
        transition: transform .15s ease;
    }

    .vip-libre {
        background: #dcfce7;
        border: 2px solid #22c55e;
        color: #166534;
        cursor: pointer;
    }

        .vip-libre:hover {
            background: #bbf7d0;
            transform: translateY(-2px);
        }

    .vip-reservado {
        background: #7c3aed;
        border: 2px solid #6d28d9;
        color: white;
        opacity: 1 !important;
        cursor: not-allowed;
    }

    .vip-ocupado {
        background: #dc2626;
        border: 2px solid #b91c1c;
        color: white;
        opacity: 1 !important;
        cursor: not-allowed;
    }

    .vip-elegido {
        background: #15803d !important;
        border: 2px solid #166534 !important;
        color: white !important;
    }

    .vip-vacio {
        display: block;
        width: 60px;
        height: 54px;
    }

    .vip-leyenda {
        width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-block;
        vertical-align: middle;
        margin-right: 5px;
    }

    .vip-pasajero-card {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 20px;
        background: #fbfcfe;
        margin-bottom: 15px;
    }

    .vip-boton-principal {
        background-color: #172a3b;
        border-color: #172a3b;
        color: white;
        border-radius: 9px;
        font-weight: 700;
    }

        .vip-boton-principal:hover {
            background-color: #29465d;
            color: white;
        }

        .vip-boton-principal:disabled {
            background-color: #94a3b8;
            border-color: #94a3b8;
            color: white;
        }

    @@media (max-width: 767px) {
        .vip-ruta {
            font-size: 18px;
        }

        .vip-indicador .numero {
            font-size: 21px;
        }
    }
</style>

<div class="container py-4 vip-seleccion">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">
            Seleccion de Vuelo y Asiento
        </h2>

        <p class="small text-muted mb-0">
            Confirma tu vuelo, selecciona tus asientos
            e ingresa los datos de cada pasajero.
        </p>
    </div>

    <!-- MENSAJES -->
    @if (TempData["ReservaCreada"] != null)
    {
        <div class="alert alert-success">
            @TempData["ReservaCreada"]
        </div>
    }

    @if (TempData["ErrorReserva"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorReserva"]
        </div>
    }

    <!-- INFORMACION DEL VUELO -->
    <div class="vip-vuelo-header mb-4">

        <div class="row align-items-center g-3">

            <div class="col-md-8">

                <div class="vip-titulo mb-2">
                    AEROLINEA VIP
                </div>

                <div class="vip-ruta">
                    @aeropuertoOrigen
                    <span class="mx-2">&rarr;</span>
                    @aeropuertoDestino
                </div>

                <div class="vip-subdato mt-2">

                    Vuelo @("VIP" + Model.VueloId.ToString("D5"))

                    <span class="mx-2">&bull;</span>

                    @fechaTexto

                    <span class="mx-2">&bull;</span>

                    Aeronave @matricula

                </div>

            </div>

            <div class="col-md-4 text-md-end">

                <div class="vip-subdato mb-2">
                    Horario del vuelo
                </div>

                <div class="fs-5 fw-bold">
                    @horaPartida
                    <span class="mx-1">&rarr;</span>
                    @horaLlegada
                </div>

                <span class="badge bg-light text-dark mt-2">
                    @Model.EstadoVueloCodigo
                </span>

            </div>

        </div>
    </div>

    <!-- INDICADORES -->
    <div class="vip-card p-3 p-md-4 mb-4">

        <div class="row g-3">

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Capacidad</div>
                    <div class="numero text-dark">
                        @capacidad
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Reservados</div>
                    <div class="numero"
                         style="color:#7c3aed;">
                        @reservados
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Ocupados</div>
                    <div class="numero text-danger">
                        @ocupados
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3">
                <div class="vip-indicador">
                    <div class="nombre">Disponibles</div>
                    <div class="numero text-success">
                        @disponibles
                    </div>
                </div>
            </div>

        </div>
    </div>

    @if (!permiteSeleccion)
    {
        <div class="alert alert-warning">
            Este vuelo no admite nuevas reservas.
        </div>
    }

    <!-- FORMULARIO -->
    @using (Html.BeginForm(
        "Guardar",
        "ReservaAsientos",
        FormMethod.Post,
        new { id = "formReserva" }))
    {
        @Html.AntiForgeryToken()

        <input type="hidden"
               name="VueloId"
               value="@Model.VueloId" />

        <!-- MAPA DE ASIENTOS -->
        <div class="vip-card p-4 mb-4">

            <div class="d-flex flex-wrap justify-content-between
                        align-items-center gap-3 mb-4">

                <div>
                    <h5 class="fw-bold text-dark mb-1">
                        Mapa de asientos
                    </h5>

                    <p class="small text-muted mb-0">
                        Selecciona los asientos disponibles.
                    </p>
                </div>

                <div class="d-flex flex-wrap gap-3 small">

                    <span>
                        <i class="vip-leyenda"
                           style="background:#dcfce7;
                                  border:1px solid #22c55e;"></i>
                        Disponible
                    </span>

                    <span>
                        <i class="vip-leyenda"
                           style="background:#7c3aed;"></i>
                        Reservado
                    </span>

                    <span>
                        <i class="vip-leyenda"
                           style="background:#dc2626;"></i>
                        Ocupado
                    </span>

                    <span>
                        <i class="vip-leyenda"
                           style="background:#15803d;"></i>
                        Seleccionado
                    </span>

                </div>
            </div>

            <div class="vip-mapa">

                <div class="vip-frente">
                    PARTE DELANTERA
                </div>

                @for (int fila = 1; fila <= 4; fila++)
                {
                    var izquierda = asientos.FirstOrDefault(
                        a => a.Fila == fila &&
                             a.Lado != null &&
                             a.Lado.Trim().ToUpperInvariant() == "I");

                    var derecha = asientos.FirstOrDefault(
                        a => a.Fila == fila &&
                             a.Lado != null &&
                             a.Lado.Trim().ToUpperInvariant() == "D");

                    <div class="vip-fila">

                        <span class="vip-numero">
                            @fila
                        </span>

                        <!-- ASIENTO IZQUIERDO -->
                        @if (izquierda != null)
                        {
                            string codigo =
                                (izquierda.Codigo ?? "").Trim();

                            string estado = obtenerEstado(izquierda);

                            bool bloqueado =
                                !permiteSeleccion ||
                                estado != "DISPONIBLE";

                            string clase =
                                estado == "RESERVADO"
                                ? "vip-reservado"
                                : estado == "OCUPADO"
                                  ? "vip-ocupado"
                                  : "vip-libre";

                            <button type="button"
                                    class="vip-asiento @clase js-asiento"
                                    data-codigo="@codigo"
                                    aria-pressed="false"
                                    title="@estado"
                                    disabled="@(bloqueado ? "disabled" : null)">
                                @codigo
                            </button>
                        }
                        else
                        {
                            <span class="vip-vacio"></span>
                        }

                        <span class="vip-pasillo">
                            PASILLO
                        </span>

                        <!-- ASIENTO DERECHO -->
                        @if (derecha != null)
                        {
                            string codigo =
                                (derecha.Codigo ?? "").Trim();

                            string estado = obtenerEstado(derecha);

                            bool bloqueado =
                                !permiteSeleccion ||
                                estado != "DISPONIBLE";

                            string clase =
                                estado == "RESERVADO"
                                ? "vip-reservado"
                                : estado == "OCUPADO"
                                  ? "vip-ocupado"
                                  : "vip-libre";

                            <button type="button"
                                    class="vip-asiento @clase js-asiento"
                                    data-codigo="@codigo"
                                    aria-pressed="false"
                                    title="@estado"
                                    disabled="@(bloqueado ? "disabled" : null)">
                                @codigo
                            </button>
                        }
                        else
                        {
                            <span class="vip-vacio"></span>
                        }

                    </div>
                }

                <div class="text-center small text-muted mt-4">
                    PARTE POSTERIOR
                </div>

            </div>

            @if (asientos.Count == 0)
            {
                <div class="alert alert-warning mt-4">
                    No hay asientos configurados para este vuelo.
                </div>
            }

            <p class="small text-muted text-center mt-4 mb-0">
                Pulsa un asiento verde para seleccionarlo.
                Los asientos reservados y ocupados estan bloqueados.
            </p>

        </div>

        <!-- DATOS DE PASAJEROS -->
        <div class="vip-card p-4 mb-4">

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h5 class="fw-bold text-dark mb-0">
                    Datos de los pasajeros
                </h5>

                <span id="cantidadElegidos"
                      class="badge bg-secondary px-3 py-2">
                    0 asientos
                </span>

            </div>

            <div id="contenedorPasajeros"
                 aria-live="polite">

                <p class="text-muted mb-0">
                    Selecciona un asiento para ingresar
                    los datos del pasajero.
                </p>

            </div>

        </div>

        <!-- RESUMEN -->
        <div class="vip-card p-4">

            <div class="row align-items-center g-3">

                <div class="col-md-6">

                    <div class="fw-bold text-dark mb-1">
                        Resumen de tu reserva
                    </div>

                    <div class="small text-muted">
                        Asientos seleccionados
                    </div>

                    <div id="resumenAsientos"
                         class="mt-2"
                         aria-live="polite">
                        <span class="text-muted">
                            Ninguno
                        </span>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        La reserva se registrara
                        como pendiente de compra.
                    </p>

                </div>

                <div class="col-md-6">

                    <div class="d-flex flex-wrap
                                justify-content-md-end gap-2">

                        <a href="@Url.Action(
                            "DisponibilidadAsientos",
                            "Vueloes",
                            new { vueloId = Model.VueloId })"
                           class="btn btn-outline-secondary px-4">
                            Regresar
                        </a>

                        <button type="submit"
                                id="btnGuardar"
                                class="btn vip-boton-principal px-4"
                                disabled>
                            Registrar reserva pendiente
                        </button>

                    </div>

                </div>

            </div>
        </div>

        if (!autenticado)
        {
            <div class="alert alert-info mt-3">
                Debes iniciar sesion para registrar una reserva.

                <a href="@Url.Action(
                    "Login",
                    "Account",
                    new {
                        returnUrl = Url.Action(
                            "Seleccionar",
                            "Vueloes",
                            new { vueloId = Model.VueloId })
                    })"
                   class="alert-link">
                    Iniciar sesion
                </a>
            </div>
        }
    }
</div>

@section scripts {
    <script>
document.addEventListener("DOMContentLoaded", function () {

    var seleccionados = [];
    var datosPasajeros = {};

    var botones =
        document.querySelectorAll(".js-asiento");

    var contenedor =
        document.getElementById("contenedorPasajeros");

    var contador =
        document.getElementById("cantidadElegidos");

    var resumen =
        document.getElementById("resumenAsientos");

    var guardar =
        document.getElementById("btnGuardar");

    var formulario =
        document.getElementById("formReserva");

    var autenticado =
        @Html.Raw(autenticado ? "true" : "false");

    var permiteSeleccion =
        @Html.Raw(permiteSeleccion ? "true" : "false");

    // Guardar los datos antes de actualizar formularios.
    function conservarDatos() {

        var secciones =
            contenedor.querySelectorAll("[data-seccion-asiento]");

        secciones.forEach(function (seccion) {

            var codigo =
                seccion.getAttribute("data-seccion-asiento");

            var datos = {};

            seccion.querySelectorAll(
                "input[data-campo],select[data-campo]"
            ).forEach(function (campo) {

                datos[campo.getAttribute("data-campo")] =
                    campo.value;
            });

            datosPasajeros[codigo] = datos;
        });
    }

    // Crear un campo de texto para cada pasajero.
    function crearCampo(nombre, etiqueta, indice, valor) {

        var caja = document.createElement("div");
        caja.className = "col-md-6";

        var label = document.createElement("label");
        label.className = "form-label small fw-semibold";
        label.textContent = etiqueta;

        var input = document.createElement("input");
        input.type = "text";

        input.name =
            "Pasajeros[" + indice + "]." + nombre;

        input.setAttribute("data-campo", nombre);

        input.className =
            "form-control form-control-sm";

        input.value = valor || "";
        input.required = true;

        if (nombre === "NumeroDocumento") {
            input.minLength = 5;
            input.maxLength = 20;
        } else {
            input.maxLength = 100;
        }

        caja.appendChild(label);
        caja.appendChild(input);

        return caja;
    }

    // Crear el selector del tipo de documento.
    function crearTipoDocumento(indice, valor) {

        var caja = document.createElement("div");
        caja.className = "col-md-6";

        var label = document.createElement("label");
        label.className = "form-label small fw-semibold";
        label.textContent = "Tipo de documento";

        var select = document.createElement("select");

        select.name =
            "Pasajeros[" + indice + "].TipoDocumentoCodigo";

        select.setAttribute(
            "data-campo", "TipoDocumentoCodigo");

        select.className =
            "form-select form-select-sm";

        select.required = true;

        var tipos = [
            ["CEDULA", "Cedula"],
            ["PASAPORTE", "Pasaporte"]
        ];

        tipos.forEach(function (tipo) {

            var opcion = document.createElement("option");
            opcion.value = tipo[0];
            opcion.textContent = tipo[1];

            select.appendChild(opcion);
        });

        select.value = valor || "CEDULA";

        caja.appendChild(label);
        caja.appendChild(select);

        return caja;
    }

    // Actualizar los datos de pasajeros y resumen.
    function actualizarPantalla() {

        contenedor.innerHTML = "";
        resumen.innerHTML = "";

        contador.textContent =
            seleccionados.length + " asientos";

        guardar.disabled =
            !autenticado ||
            !permiteSeleccion ||
            seleccionados.length === 0;

        if (seleccionados.length === 0) {

            var mensaje = document.createElement("p");

            mensaje.className = "text-muted mb-0";

            mensaje.textContent =
                "Selecciona un asiento para ingresar " +
                "los datos del pasajero.";

            contenedor.appendChild(mensaje);

            var texto = document.createElement("span");

            texto.className = "text-muted";
            texto.textContent = "Ninguno";

            resumen.appendChild(texto);

            return;
        }

        seleccionados.forEach(function (codigo, indice) {

            var info = datosPasajeros[codigo] || {};

            // Etiqueta del asiento.
            var etiqueta = document.createElement("span");

            etiqueta.className =
                "badge bg-success me-2 mb-1 px-3 py-2";

            etiqueta.textContent = "Asiento " + codigo;

            resumen.appendChild(etiqueta);

            // Contenedor de cada pasajero.
            var seccion = document.createElement("section");

            seccion.className = "vip-pasajero-card";

            seccion.setAttribute(
                "data-seccion-asiento", codigo);

            var encabezado = document.createElement("div");

            encabezado.className =
                "d-flex justify-content-between " +
                "align-items-center gap-2 mb-3";

            var titulo = document.createElement("strong");

            titulo.textContent =
                "Pasajero " + (indice + 1) +
                " - Asiento " + codigo;

            var quitar = document.createElement("button");

            quitar.type = "button";
            quitar.className = "btn btn-sm btn-outline-danger";
            quitar.textContent = "Quitar";

            quitar.addEventListener("click", function () {
                alternarAsiento(codigo);
            });

            encabezado.appendChild(titulo);
            encabezado.appendChild(quitar);
            seccion.appendChild(encabezado);

            // Campo oculto para el servidor.
            var campoAsiento = document.createElement("input");

            campoAsiento.type = "hidden";

            campoAsiento.name =
                "Pasajeros[" + indice + "].CodigoAsiento";

            campoAsiento.value = codigo;

            seccion.appendChild(campoAsiento);

            // Campos de identificacion.
            var fila = document.createElement("div");
            fila.className = "row g-3";

            fila.appendChild(
                crearTipoDocumento(
                    indice,
                    info.TipoDocumentoCodigo));

            fila.appendChild(
                crearCampo(
                    "NumeroDocumento",
                    "Numero de documento",
                    indice,
                    info.NumeroDocumento));

            fila.appendChild(
                crearCampo(
                    "Nombres",
                    "Nombres",
                    indice,
                    info.Nombres));

            fila.appendChild(
                crearCampo(
                    "Apellidos",
                    "Apellidos",
                    indice,
                    info.Apellidos));

            seccion.appendChild(fila);
            contenedor.appendChild(seccion);
        });
    }

    // Seleccionar o quitar asientos.
    function alternarAsiento(codigo) {

        var boton = null;

        botones.forEach(function (elemento) {

            if (elemento.getAttribute("data-codigo") === codigo) {
                boton = elemento;
            }
        });

        if (!boton || boton.disabled) {
            return;
        }

        conservarDatos();

        var indice = seleccionados.indexOf(codigo);

        if (indice >= 0) {

            seleccionados.splice(indice, 1);

            boton.classList.remove("vip-elegido");
            boton.classList.add("vip-libre");
            boton.setAttribute("aria-pressed", "false");

        } else {

            seleccionados.push(codigo);

            boton.classList.remove("vip-libre");
            boton.classList.add("vip-elegido");
            boton.setAttribute("aria-pressed", "true");
        }

        actualizarPantalla();
    }

    // Eventos para los asientos disponibles.
    botones.forEach(function (boton) {

        if (!boton.disabled) {

            boton.addEventListener("click", function () {

                alternarAsiento(
                    boton.getAttribute("data-codigo"));
            });
        }
    });

    // Recibir los asientos elegidos en la pantalla 07.
    var parametros =
        new URLSearchParams(window.location.search);

    var recibidos = parametros.get("asientos");

    if (recibidos) {

        recibidos.split(",").forEach(function (codigo) {

            codigo = codigo.trim().toUpperCase();

            botones.forEach(function (boton) {

                var nombre =
                    boton.getAttribute("data-codigo");

                if (nombre === codigo &&
                    !boton.disabled &&
                    seleccionados.indexOf(codigo) < 0) {

                    seleccionados.push(codigo);

                    boton.classList.remove("vip-libre");
                    boton.classList.add("vip-elegido");

                    boton.setAttribute("aria-pressed", "true");
                }
            });
        });
    }

    // Prevenir envios repetidos.
    formulario.addEventListener("submit", function (evento) {

        if (!autenticado ||
            !permiteSeleccion ||
            seleccionados.length === 0) {

            evento.preventDefault();
            return;
        }

        if (!formulario.checkValidity()) {
            return;
        }

        guardar.disabled = true;
        guardar.textContent = "Registrando reserva...";
    });

    actualizarPantalla();

});
    </script>
}
