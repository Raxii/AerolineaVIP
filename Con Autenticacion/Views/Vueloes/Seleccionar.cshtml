@using Con_Autenticacion.Models
@model Vuelo

@{
    ViewBag.Title = "Seleccion de Vuelo y Asiento";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var capacidad = (int)(ViewBag.Capacidad ?? 0);
    var ocupados = (int)(ViewBag.Ocupados ?? 0);
    var restantes = (int)(ViewBag.Restantes ?? 0);
    var aeropuertoOrigen = (string)(ViewBag.AeropuertoOrigen ?? "N/A");
    var aeropuertoDestino = (string)(ViewBag.AeropuertoDestino ?? "N/A");
    var horaPartida = (string)(ViewBag.HoraPartida ?? "--:--");
    var horaLlegada = (string)(ViewBag.HoraLlegada ?? "--:--");
    var fechaOperacion = (DateTime?)(ViewBag.FechaOperacion ?? null);
    var matricula = (string)(ViewBag.Matricula ?? "N/A");
    var asientosOcupados = (List<string>)(ViewBag.AsientosOcupados ?? new List<string>());
    var asientos = (List<Asiento>)(ViewBag.Asientos ?? new List<Asiento>());
}

<div class="container py-5" style="max-width: 1150px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Seleccion de Vuelo y Asiento</h2>
        <p class="small text-muted mb-4">Confirma tu vuelo y elige tus asientos antes de continuar con el registro de pasajeros.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row align-items-center">
            <div class="col-md-6 d-flex align-items-center gap-4">
                <div class="text-center">
                    <div class="fw-bold fs-5 text-dark">@horaPartida</div>
                    <div class="small text-muted">@aeropuertoOrigen</div>
                </div>

                <div class="text-muted small" style="width: 80px; border-top: 2px dashed #adb5bd;"></div>

                <div class="text-center">
                    <div class="fw-bold fs-5 text-dark">@horaLlegada</div>
                    <div class="small text-muted">@aeropuertoDestino</div>
                </div>

                <div class="ms-3">
                    <span class="badge bg-light text-dark border">@Html.DisplayFor(modelItem => modelItem.VueloId)</span>
                    <div class="small text-muted mt-1">@(fechaOperacion.HasValue ? fechaOperacion.Value.ToString("dd MMM yyyy") : "N/A") · @matricula</div>
                </div>
            </div>

            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                @if (restantes > 0)
                {
                    <span class="badge bg-success bg-opacity-75 rounded-pill px-3 py-2 me-2">Disponible</span>
                }
                else
                {
                    <span class="badge bg-danger bg-opacity-75 rounded-pill px-3 py-2 me-2">Sin disponibilidad</span>
                }
                <span class="small text-muted">@restantes asientos libres</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-dark mb-0">Elige tus asientos</h5>
            <div>
                <span class="badge bg-light text-dark border me-2">Libre</span>
                <span class="badge bg-secondary text-white me-2">Ocupado</span>
                <span class="badge bg-success text-white me-2">Seleccionado</span>
            </div>
        </div>

        <div class="d-flex flex-column align-items-center gap-2">
            @{
                var asientosPorFila = new System.Collections.Hashtable();

                foreach (var asiento in asientos)
                {
                    var filaKey = asiento.Fila.ToString();
                    if (!asientosPorFila.ContainsKey(filaKey))
                    {
                        asientosPorFila[filaKey] = new List<Asiento>();
                    }
                    ((List<Asiento>)asientosPorFila[filaKey]).Add(asiento);
                }

                var filasKeys = new List<string>();
                foreach (var key in asientosPorFila.Keys)
                {
                    filasKeys.Add(key.ToString());
                }

                for (int i = 0; i < filasKeys.Count - 1; i++)
                {
                    for (int j = 0; j < filasKeys.Count - 1 - i; j++)
                    {
                        if (int.Parse(filasKeys[j]) > int.Parse(filasKeys[j + 1]))
                        {
                            var temp = filasKeys[j];
                            filasKeys[j] = filasKeys[j + 1];
                            filasKeys[j + 1] = temp;
                        }
                    }
                }

                foreach (var filaKey in filasKeys)
                {
                    var asientosEnFila = (List<Asiento>)asientosPorFila[filaKey];
                    <div class="d-flex gap-3 justify-content-center">
                        @{
                            for (int i = 0; i < asientosEnFila.Count - 1; i++)
                            {
                                for (int j = 0; j < asientosEnFila.Count - 1 - i; j++)
                                {
                                    if (asientosEnFila[j].Lado.CompareTo(asientosEnFila[j + 1].Lado) > 0)
                                    {
                                        var temp = asientosEnFila[j];
                                        asientosEnFila[j] = asientosEnFila[j + 1];
                                        asientosEnFila[j + 1] = temp;
                                    }
                                }
                            }

                            int contador = 0;
                            foreach (var asiento in asientosEnFila)
                            {
                                var estaOcupado = false;
                                foreach (var codigoOcupado in asientosOcupados)
                                {
                                    if (codigoOcupado == asiento.Codigo)
                                    {
                                        estaOcupado = true;
                                        break;
                                    }
                                }

                                if (contador == 3)
                                {
                                    <div style="width: 30px;"></div>
                                }

                                if (estaOcupado)
                                {
                                    <button class="btn btn-sm btn-secondary fw-bold" style="width: 45px; height: 45px;" disabled>@asiento.Codigo</button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-light border fw-bold" style="width: 45px; height: 45px;" data-asiento="@asiento.Codigo">@asiento.Codigo</button>
                                }

                                contador++;
                            }
                        }
                    </div>
                }
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <h6 class="fw-bold text-dark mb-3">Resumen de tu seleccion</h6>

        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
            <div>
                <span class="fw-semibold text-dark">Pasajero 1</span>
                <span class="small text-muted">(Adulto)</span>
            </div>
            <div>
                <span class="badge bg-light text-dark border px-3 py-2">Asiento 1C</span>
            </div>
            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;">Quitar</button>
        </div>

        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
            <div>
                <span class="fw-semibold text-dark">Pasajero 2</span>
                <span class="small text-muted">(Adulto)</span>
            </div>
            <div>
                <span class="badge bg-light text-dark border px-3 py-2">Asiento 2E</span>
            </div>
            <button class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 12px;">Quitar</button>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mt-4">
        <button class="btn btn-outline-secondary px-4">Regresar</button>
        <button class="btn px-4 text-white fw-bold rounded-3" style="background-color: #37474f; border-color: #37474f;">Continuar al registro</button>
    </div>
</div>
