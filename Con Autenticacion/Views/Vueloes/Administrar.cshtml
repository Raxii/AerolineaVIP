
@using System
@using System.Collections.Generic
@using Con_Autenticacion.Models

@{
    // =====================================
    // DATOS Y VARIABLES PARA LA ADMINISTRACION DE VUELOS
    // =====================================
    ViewBag.Title = "Administracion de Vuelos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    List<Vuelo> vuelos = ViewBag.Vuelos as List<Vuelo>;
    if (vuelos == null) { vuelos = new List<Vuelo>(); }

    int programados = 0;
    int cancelados = 0;
    List<string> rutas = new List<string>();
    Dictionary<string, string> estados =
        new Dictionary<string, string>();
    // =====================================
    // PROCESAMIENTO DE INFORMACION DE LOS VUELOS
    // =====================================

    foreach (Vuelo v in vuelos)
    {
        string codigo = v.EstadoVueloCodigo ?? "";

        if (codigo == "PROGRAMADO") { programados++; }
        if (codigo == "CANCELADO") { cancelados++; }

        if (codigo != "" && !estados.ContainsKey(codigo))
        {
            string nombre = v.EstadoVuelo != null
                ? v.EstadoVuelo.Descripcion : codigo;

            estados.Add(codigo, nombre);
        }

        if (v.Frecuencia != null &&
            v.Frecuencia.Ruta != null &&
            v.Frecuencia.Ruta.Aeropuerto != null &&
            v.Frecuencia.Ruta.Aeropuerto1 != null)
        {
            string ruta =
                v.Frecuencia.Ruta.Aeropuerto.CodigoIATA
                + " - " +
                v.Frecuencia.Ruta.Aeropuerto1.CodigoIATA;

            if (!rutas.Contains(ruta))
            {
                rutas.Add(ruta);
            }
        }
    }

    DateTime hoy = DateTime.Today;

    string[] diasSemana =
    {
        "Dom", "Lun", "Mar", "Mie",
        "Jue", "Vie", "Sab"
    };
}

<style>
    .av-admin {
        max-width: 1250px;
        margin: 0 auto;
        padding: 40px 15px 65px;
    }

        .av-admin .titulo {
            color: #172b3c;
            font-weight: 800;
        }

        .av-admin .dorado {
            color: #b88738;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .av-admin .tarjeta {
            background: white;
            border: 1px solid #e0e6eb;
            border-radius: 16px;
            box-shadow: 0 8px 24px rgba(20,40,60,.06);
            overflow: hidden;
        }

        .av-admin .tarjeta-cabecera {
            padding: 18px 22px;
            background: #f8fafc;
            border-bottom: 1px solid #e3e8ed;
        }

        .av-admin .btn-principal {
            background: #172b3c;
            border: 1px solid #172b3c;
            color: #fff;
            font-weight: 600;
        }

            .av-admin .btn-principal:hover {
                background: #2d4658;
                color: #fff;
            }

        .av-admin .indicador {
            padding: 18px 20px;
            background: white;
            border: 1px solid #e0e6eb;
            border-radius: 14px;
            height: 100%;
        }

        .av-admin .numero {
            color: #172b3c;
            font-size: 28px;
            font-weight: 800;
        }

        .av-admin .form-label {
            font-size: 13px;
            font-weight: 700;
        }

        .av-admin .dia-calendario {
            min-width: 82px;
            padding: 12px;
            text-align: center;
            border: 1px solid #dce3e9;
            border-radius: 10px;
            background: #fff;
            color: #172b3c;
            cursor: pointer;
            transition: background-color .2s, color .2s, border-color .2s, transform .2s;
        }

            .av-admin .dia-calendario:hover {
                border-color: #b88738;
                transform: translateY(-2px);
            }

            .av-admin .dia-calendario.dia-hoy {
                background: #172b3c;
                border-color: #172b3c;
                color: #fff;
            }

                .av-admin .dia-calendario.dia-hoy:hover {
                    background: #2d4658;
                }

        .av-admin .tabla-vuelos th {
            font-weight: 700;
            font-size: 13px;
            background: #edf1f5;
            padding: 15px;
            white-space: nowrap;
        }

        .av-admin .tabla-vuelos td {
            vertical-align: middle;
            padding: 15px;
            font-size: 14px;
        }

        .av-admin .acciones {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .av-admin .estado {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .av-admin .estado-programado {
            background: #dcf4e7;
            color: #157347;
        }

        .av-admin .estado-cancelado {
            background: #fce4e4;
            color: #b02a37;
        }

        .av-admin .estado-otro {
            background: #e8edf4;
            color: #34465b;
        }
</style>

<div class="av-admin">

    <div class="d-flex justify-content-between
                align-items-end flex-wrap gap-3 mb-4">

        <div>
            <div class="dorado mb-2">
                AEROLINEA VIP / ADMINISTRACION
            </div>

            <h2 class="titulo mb-2">
                Administracion de Vuelos e Itinerarios
            </h2>

            <p class="text-muted mb-0">
                Consulta y administra vuelos,
                frecuencias, aeronaves y estados.
            </p>
        </div>

        @Html.ActionLink(
            "+ Crear programacion",
            "Create",
            "Vueloes",
            null,
            new { @class = "btn btn-principal px-4 py-2" }
        )
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="indicador">
                <div class="small text-muted">
                    Total de vuelos
                </div>
                <div class="numero">@vuelos.Count</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="indicador">
                <div class="small text-muted">
                    Vuelos programados
                </div>
                <div class="numero text-success">
                    @programados
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="indicador">
                <div class="small text-muted">
                    Vuelos cancelados
                </div>
                <div class="numero text-danger">
                    @cancelados
                </div>
            </div>
        </div>

    </div>

    <div class="tarjeta p-4 mb-4">

        <h5 class="fw-bold mb-3">Buscar vuelos</h5>

        <div class="row g-3 align-items-end">

            <div class="col-md-3">
                <label for="filtroFecha" class="form-label">
                    Fecha
                </label>
                <input id="filtroFecha"
                       type="date"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label for="filtroRuta" class="form-label">
                    Ruta
                </label>
                <select id="filtroRuta" class="form-select">
                    <option value="">Todas las rutas</option>

                    @foreach (string ruta in rutas)
                    {
                        <option value="@ruta">@ruta</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label for="filtroEstado" class="form-label">
                    Estado
                </label>
                <select id="filtroEstado" class="form-select">
                    <option value="">Todos los estados</option>

                    @foreach (
                        KeyValuePair<string, string> estado
                        in estados)
                    {
                        <option value="@estado.Key">
                            @estado.Value
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button id="btnFiltrar"
                            type="button"
                            class="btn btn-principal flex-fill">
                        Filtrar
                    </button>

                    <button id="btnLimpiar"
                            type="button"
                            class="btn btn-outline-secondary">
                        Limpiar
                    </button>
                </div>
            </div>

        </div>

        <div class="mt-3">
            <button id="btnConflictos"
                    type="button"
                    class="btn btn-outline-danger btn-sm">
                Consultar conflictos
            </button>

            <small class="text-muted ms-2">
                Revision preliminar de horarios
                de una misma aeronave.
            </small>
        </div>

        <div id="resultadoConflictos"
             class="mt-3"
             style="display:none;">
        </div>

    </div>

    <div class="tarjeta p-4 mb-4">

        <h5 class="fw-bold mb-3">
            Calendario de operaciones -
            @hoy.ToString("MM/yyyy")
        </h5>

        <div class="d-flex gap-2 flex-wrap">

            @for (int i = 0; i < 7; i++)
            {
                DateTime dia = hoy.AddDays(i);

                string clase = i == 0
                    ? "dia-calendario dia-hoy"
                    : "dia-calendario";

                int totalDia = 0;

                foreach (Vuelo vuelo in vuelos)
                {
                    if (vuelo.FechaOperacion.Date == dia.Date)
                    {
                        totalDia++;
                    }
                }

                <button type="button"
                        class="@clase"
                        data-fecha="@dia.ToString("yyyy-MM-dd")"
                        aria-pressed="@(i == 0 ? "true" : "false")">

                    <div class="small">
                        @diasSemana[(int)dia.DayOfWeek]
                    </div>

                    <div class="fw-bold fs-5">
                        @dia.ToString("dd")
                    </div>

                    <div class="small">
                        @totalDia vuelos
                    </div>
                </button>
            }

        </div>

        <p class="small text-muted mb-0 mt-3">
            Selecciona un dia para filtrar los vuelos.
        </p>
    </div>

    <div class="tarjeta">

        <div class="tarjeta-cabecera
                    d-flex justify-content-between
                    align-items-center gap-2 flex-wrap">

            <div>
                <h5 class="fw-bold mb-1">
                    Itinerarios programados
                </h5>
                <span class="small text-muted">
                    Listado de vuelos registrados
                </span>
            </div>

            <span id="contadorVuelos"
                  class="badge bg-light text-dark border">
                @vuelos.Count vuelos
            </span>
        </div>

        <div class="table-responsive">

            <table id="tablaVuelos"
                   class="table table-striped tabla-vuelos mb-0">

                <thead>
                    <tr>
                        <th>Vuelo</th>
                        <th>Ruta</th>
                        <th>Fecha / Hora</th>
                        <th>Aeronave</th>
                        <th>Frecuencia</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (vuelos.Count == 0)
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">
                                No hay vuelos registrados.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (Vuelo vuelo in vuelos)
                        {
                            string ruta = "Sin ruta";
                            string inicio = "";
                            string fin = "";
                            string aeronave = "No asignada";
                            string matricula = "";
                            string aeronaveId = "";

                            string codigo =
                                vuelo.EstadoVueloCodigo ?? "";

                            string estado =
                                vuelo.EstadoVuelo != null
                                ? vuelo.EstadoVuelo.Descripcion
                                : codigo;

                            string claseEstado =
                                codigo == "PROGRAMADO"
                                ? "estado-programado"
                                : (codigo == "CANCELADO"
                                ? "estado-cancelado"
                                : "estado-otro");

                            if (vuelo.Frecuencia != null)
                            {
                                inicio = vuelo.Frecuencia.HoraSalida
                                    .ToString(@"hh\:mm");

                                fin = vuelo.Frecuencia.HoraLlegada
                                    .ToString(@"hh\:mm");

                                if (vuelo.Frecuencia.Ruta != null &&
                                    vuelo.Frecuencia.Ruta.Aeropuerto != null &&
                                    vuelo.Frecuencia.Ruta.Aeropuerto1 != null)
                                {
                                    ruta =
                                        vuelo.Frecuencia.Ruta
                                        .Aeropuerto.CodigoIATA
                                        + " - " +
                                        vuelo.Frecuencia.Ruta
                                        .Aeropuerto1.CodigoIATA;
                                }
                            }

                            if (vuelo.Aeronave != null)
                            {
                                matricula =
                                    vuelo.Aeronave.Matricula;

                                aeronaveId = Convert.ToString(
                                    vuelo.Aeronave.AeronaveId);

                                aeronave = matricula;

                                if (vuelo.Aeronave.ModeloAeronave != null)
                                {
                                    aeronave =
                                        vuelo.Aeronave
                                        .ModeloAeronave.Nombre;
                                }
                            }

                            <tr data-vuelo="true"
                                data-fecha="@vuelo.FechaOperacion.ToString("yyyy-MM-dd")"
                                data-ruta="@ruta"
                                data-estado="@codigo"
                                data-aeronave="@aeronaveId"
                                data-inicio="@inicio"
                                data-fin="@fin">

                                <td>
                                    <strong>#@vuelo.VueloId</strong>
                                </td>

                                <td>@ruta</td>

                                <td>
                                    <strong>
                                        @vuelo.FechaOperacion.ToString("dd/MM/yyyy")
                                    </strong>
                                    <div class="small text-muted mt-1">
                                        @inicio - @fin
                                    </div>
                                </td>

                                <td>
                                    <strong>@aeronave</strong>
                                    <div class="small text-muted">
                                        @matricula
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border">
                                        #@vuelo.FrecuenciaId
                                    </span>
                                </td>

                                <td>
                                    <span class="estado @claseEstado">
                                        @estado
                                    </span>
                                </td>

                                <td>
                                    <div class="acciones">

                                        @Html.ActionLink(
                                            "Ver",
                                            "Details",
                                            "Vueloes",
                                            new { id = vuelo.VueloId },
                                            new
                                                 {
                                                @class = "btn btn-sm btn-outline-secondary"
                                            }
                                        )

                                        @Html.ActionLink(
                                            "Modificar",
                                            "Edit",
                                            "Vueloes",
                                            new { id = vuelo.VueloId },
                                            new
                                                 {
                                                @class = "btn btn-sm btn-outline-primary"
                                            }
                                        )

                                        @if (codigo != "CANCELADO")
                                        {
                                            @Html.ActionLink(
                                                "Cancelar",
                                                "Edit",
                                                "Vueloes",
                                                new { id = vuelo.VueloId },
                                                new
                                                     {
                                                    @class = "btn btn-sm btn-outline-danger",
                                                    title = "Selecciona CANCELADO y guarda en Editar",
                                                    onclick = "return confirm('Se abrira Editar vuelo para cambiar el estado a Cancelado. Continuar?');"
                                                }
                                            )
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">
                                                Cancelado
                                            </span>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </tbody>
            </table>
        </div>

        <div class="p-3 border-top small text-muted">
            Cancelar abre Editar vuelo. Para cancelar,
            selecciona el estado Cancelado y guarda.
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/Validaciones/administrar.js")"></script>
}
