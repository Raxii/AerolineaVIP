@using Con_Autenticacion.Models

@{
    ViewBag.Title = "Administracion de Vuelos e Itinerarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var totalVuelos = (int)(ViewBag.TotalVuelos ?? 0);
    var vuelos = (List<Vuelo>)(ViewBag.Vuelos ?? new List<Vuelo>());
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">Administracion de Vuelos e Itinerarios</h2>
            <p class="small text-muted mb-0">Gestion de la programacion aprobada, rutas, horarios y estados operativos.</p>
        </div>

        <button class="btn px-4 text-white fw-bold rounded-3" style="background-color: #37474f; border-color: #37474f;">+ Crear Programacion</button>
    </div>
    @*AUN NO SE APLICA FILTRO*@
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold">Fecha</label>
                <input type="date" class="form-control form-control-sm">
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold">Ruta</label>
                <select class="form-select form-select-sm">
                    <option>Todas</option>
                    <option>UIO - GYE</option>
                    <option>UIO - MEC</option>
                    <option>GYE - UIO</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold">Estado</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>Programado</option>
                    <option>En vuelo</option>
                    <option>Retrasado</option>
                    <option>Cancelado</option>
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button class="btn btn-sm btn-outline-danger w-100">Consultar Conflictos</button>
                <button class="btn btn-sm px-3 text-white fw-semibold w-100" style="background-color: #37474f; border-color: #37474f;">Filtrar</button>
            </div>
        </div>
    </div>
    @*FALTA ACTUALIZAR HORARIO*@
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <h6 class="fw-bold text-dark mb-3">Calendario de Operaciones - Octubre 2026</h6>

        <div class="d-flex gap-2 flex-wrap">
            <div class="border rounded-3 p-2 text-center" style="width: 60px; background-color: #37474f; color: white;">
                <div class="small">Lun</div>
                <div class="fw-bold">28</div>
            </div>

            <div class="border rounded-3 p-2 text-center bg-light" style="width: 60px;">
                <div class="small text-muted">Mar</div>
                <div class="fw-bold text-dark">29</div>
            </div>

            <div class="border rounded-3 p-2 text-center bg-white text-muted" style="width: 60px; opacity: 0.5;">
                <div class="small">Mie</div>
                <div class="fw-bold">30</div>
            </div>

            <div class="border rounded-3 p-2 text-center bg-light" style="width: 60px;">
                <div class="small text-muted">Jue</div>
                <div class="fw-bold text-dark">31</div>
            </div>

            <div class="border rounded-3 p-2 text-center bg-light" style="width: 60px;">
                <div class="small text-muted">Vie</div>
                <div class="fw-bold text-dark">01</div>
            </div>

            <div class="border rounded-3 p-2 text-center bg-light" style="width: 60px;">
                <div class="small text-muted">Sab</div>
                <div class="fw-bold text-dark">02</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #e0e0e0 !important;">
        <div class="card-header bg-light border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="small fw-bold text-dark">Itinerarios Programados</span>
            <span class="badge bg-light text-dark border">@totalVuelos vuelos</span>
        </div>

        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light text-dark">
                <tr>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Vuelo</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Ruta</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Fecha / Hora</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Aeronave</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Secuencia</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Estado</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (vuelos.Count > 0)
                {
                    foreach (var vuelo in vuelos)
                    {
                        var horaPartida = "";
                        var horaLlegada = "";
                        var rutaDisplay = "";

                        if (vuelo.Frecuencia != null && vuelo.Frecuencia.Ruta != null)
                        {
                            horaPartida = vuelo.Frecuencia.HoraSalida.ToString(@"hh\:mm");
                            horaLlegada = vuelo.Frecuencia.HoraLlegada.ToString(@"hh\:mm");

                            if (vuelo.Frecuencia.Ruta.Aeropuerto != null && vuelo.Frecuencia.Ruta.Aeropuerto1 != null)
                            {
                                rutaDisplay = vuelo.Frecuencia.Ruta.Aeropuerto.CodigoIATA + " - " + vuelo.Frecuencia.Ruta.Aeropuerto1.CodigoIATA;
                            }
                        }

                        var aeronaveDisplay = "No asignada";
                        if (vuelo.Aeronave != null)
                        {
                            aeronaveDisplay = vuelo.Aeronave.ModeloAeronave != null ? vuelo.Aeronave.ModeloAeronave.Nombre : "Desconocido";
                        }

                        var estadoDisplay = vuelo.EstadoVuelo != null ? vuelo.EstadoVuelo.Descripcion : "Desconocido";
                        var estadoBadge = "bg-success";
                        if (vuelo.EstadoVuelo != null)
                        {
                            if (vuelo.EstadoVuelo.Codigo == "RE")
                            {
                                estadoBadge = "bg-warning";
                            }
                            else if (vuelo.EstadoVuelo.Codigo == "CA")
                            {
                                estadoBadge = "bg-danger";
                            }
                        }

                        var secuencia = "Directo";
                        var numeroTramos = 0;
                        try
                        {
                            // Contar tramos para este vuelo
                            var db = new Con_Autenticacion.Models.AerolineaVIP_Context();
                            foreach (var tramo in db.TramoItinerario)
                            {
                                if (tramo.VueloId == vuelo.VueloId)
                                {
                                    numeroTramos++;
                                }
                            }

                            if (numeroTramos > 1)
                            {
                                secuencia = (numeroTramos - 1) + " escala";
                                if (numeroTramos - 1 > 1)
                                {
                                    secuencia = (numeroTramos - 1) + " escalas";
                                }
                            }
                        }
                        catch
                        {
                            secuencia = "Directo";
                        }

                        <tr>
                            <td class="py-3 px-4 fw-semibold">
                                @Html.DisplayFor(modelItem => vuelo.VueloId)
                            </td>
                            <td class="py-3 px-4">@rutaDisplay</td>
                            <td class="py-3 px-4">
                                @Html.DisplayFor(modelItem => vuelo.FechaOperacion, "{0:dd MMM yyyy}")
                                <br>
                                <span class="small text-muted">@horaPartida - @horaLlegada</span>
                            </td>
                            <td class="py-3 px-4">@aeronaveDisplay</td>
                            <td class="py-3 px-4">
                                <span class="badge bg-light text-dark border">@secuencia</span>
                            </td>
                            <td class="py-3 px-4">
                                <span class="badge @estadoBadge bg-opacity-75 rounded-pill">@estadoDisplay</span>
                            </td>
                            <td class="py-3 px-4">
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary">Modificar</button>
                                    <button class="btn btn-sm btn-outline-danger">Cancelar</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="py-3 px-4 text-center text-muted small">No hay vuelos registrados</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
