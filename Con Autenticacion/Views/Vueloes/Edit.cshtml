@using System
@using System.Collections.Generic
@using System.Web.Mvc
@using Con_Autenticacion.Models
@model Con_Autenticacion.Models.Vuelo

@{
    ViewBag.Title = "Editar vuelo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    IEnumerable<SelectListItem> rutas =
        ViewBag.ListaRutas as IEnumerable<SelectListItem>
        ?? ViewBag.RutaId as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();

    IEnumerable<Frecuencia> frecuencias =
        ViewBag.ListaFrecuencias as IEnumerable<Frecuencia>
        ?? new List<Frecuencia>();

    IEnumerable<SelectListItem> aeronaves =
        ViewBag.AeronaveId as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();

    IEnumerable<SelectListItem> estados =
        ViewBag.EstadoVueloCodigo as IEnumerable<SelectListItem>
        ?? new List<SelectListItem>();

    // Materializar las listas para poder verificar si llegaron datos.
    List<SelectListItem> rutasDisponibles = new List<SelectListItem>(rutas);
    List<Frecuencia> frecuenciasDisponibles = new List<Frecuencia>(frecuencias);

    int rutaActual = 0;
    int frecuenciaActual = Model == null ? 0 : Model.FrecuenciaId;

    foreach (Frecuencia frecuencia in frecuenciasDisponibles)
    {
        if (frecuencia.FrecuenciaId == frecuenciaActual)
        {
            rutaActual = frecuencia.RutaId;
            break;
        }
    }

    string[] dias = {
        "", "Lunes", "Martes", "Miercoles", "Jueves",
        "Viernes", "Sabado", "Domingo"
    };
}

<style>
    .vip-programar {
        max-width: 980px;
        margin: 0 auto;
        padding: 38px 12px 64px;
    }

        .vip-programar .vip-ruta-superior {
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: #b88738;
            text-transform: uppercase;
        }

        .vip-programar h2 {
            font-weight: 800;
            font-size: 30px;
            color: #172b3c;
            margin: 9px 0;
        }

        .vip-programar .vip-subtitulo {
            color: #66798b;
            margin: 0 0 25px;
        }

        .vip-programar .vip-tarjeta {
            background: white;
            border: 1px solid #e1e8ee;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 28px rgba(23,43,60,.075);
        }

        .vip-programar .vip-cabecera {
            padding: 20px 26px;
            border-bottom: 1px solid #e7ecf1;
            font-size: 18px;
            font-weight: 750;
            color: #172b3c;
        }

        .vip-programar .vip-cuerpo {
            padding: 27px 26px;
        }

        .vip-programar .vip-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 20px 26px;
        }

        .vip-programar .vip-campo {
            min-width: 0;
        }

        .vip-programar label {
            display: block;
            font-weight: 700;
            color: #253b50;
            margin-bottom: 8px;
        }

        .vip-programar .vip-entrada {
            display: block;
            width: 100%;
            min-height: 44px;
            border: 1px solid #d8e1e9;
            border-radius: 9px;
            padding: 9px 12px;
            background: #fff;
            color: #20364a;
        }

            .vip-programar .vip-entrada:focus {
                outline: 0;
                border-color: #b88738;
                box-shadow: 0 0 0 3px rgba(184,135,56,.12);
            }

        .vip-programar .vip-hint {
            color: #627487;
            font-size: 13px;
            margin-top: 6px;
        }

        .vip-programar .vip-resumen {
            margin: 25px 0 0;
            padding: 18px 20px;
            border-left: 4px solid #b88738;
            border-radius: 9px;
            background: #f4f7fa;
            color: #253b50;
        }

            .vip-programar .vip-resumen strong {
                display: block;
                margin-bottom: 4px;
            }

        .vip-programar .vip-acciones {
            margin-top: 25px;
            border-top: 1px solid #e7ecf1;
            padding-top: 21px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .vip-programar .vip-guardar {
            background: #172b3c;
            border: 1px solid #172b3c;
            border-radius: 9px;
            padding: 11px 19px;
            font-weight: 700;
            color: white;
        }

            .vip-programar .vip-guardar:hover {
                background: #304b60;
                color: white;
            }

        .vip-programar .vip-volver {
            padding: 11px 19px;
            border-radius: 9px;
            border: 1px solid #a8b6c5;
            color: #52677b;
            background: white;
            text-decoration: none;
            display: inline-block;
        }

            .vip-programar .vip-volver:hover {
                background: #f1f5f9;
            }

        .vip-programar .field-validation-error {
            display: block;
            margin-top: 5px;
            color: #b42318;
        }

    @@media (max-width: 700px) {
        .vip-programar {
            padding: 24px 10px 50px;
        }

            .vip-programar .vip-grid {
                grid-template-columns: 1fr;
            }

            .vip-programar .vip-cuerpo {
                padding: 20px;
            }
    }
</style>

<div class="container vip-programar">
    <div class="vip-ruta-superior">AEROLÍNEA VIP / ADMINISTRACIÓN</div>
    <h2>Editar vuelo</h2>
    <p class="vip-subtitulo">Selecciona primero la ruta; luego su frecuencia y la aeronave.</p>

    <div class="vip-tarjeta">
        <div class="vip-cabecera">Actualizar vuelo #@Model.VueloId</div>
        <div class="vip-cuerpo">
            @using (Html.BeginForm("Edit", "Vueloes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.VueloId)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                if (rutasDisponibles.Count == 0)
                {
                    <div class="alert alert-warning" role="alert">
                        No se recibieron rutas del controlador.
                    </div>
                }
                else if (frecuenciasDisponibles.Count == 0)
                {
                    <div class="alert alert-warning" role="alert">
                        No se recibieron frecuencias del controlador.
                        El método Create/Edit debe cargar <strong>ViewBag.ListaFrecuencias</strong>.
                    </div>
                }

                <div class="vip-grid">
                    <div class="vip-campo">
                        <label for="RutaSeleccionada">Ruta del vuelo</label>
                        <select id="RutaSeleccionada" class="vip-entrada" required>
                            <option value="">-- Seleccione una ruta --</option>
                            @foreach (SelectListItem ruta in rutasDisponibles)
                            {
                                if (ruta.Value == Convert.ToString(rutaActual))
                                {
                                    <option value="@ruta.Value" selected="selected">@ruta.Text</option>
                                }
                                else
                                {
                                    <option value="@ruta.Value">@ruta.Text</option>
                                }
                            }
                        </select>
                        <div class="vip-hint">La ruta indica origen y destino.</div>
                    </div>

                    <div class="vip-campo">
                        <label for="FrecuenciaId">Día y horario de salida</label>
                        <select id="FrecuenciaId" name="FrecuenciaId" class="vip-entrada" required>
                            <option value="">-- Seleccione una frecuencia --</option>
                            @foreach (Frecuencia f in frecuenciasDisponibles)
                            {
                                string dia = f.DiaSemana >= 1 && f.DiaSemana <= 7
                                    ? dias[(int)f.DiaSemana] : "Día no definido";
                                string horario = f.HoraSalida.ToString(@"hh\:mm")
                                    + " - " + f.HoraLlegada.ToString(@"hh\:mm");
                                if (f.FrecuenciaId == frecuenciaActual)
                                {
                                    <option value="@f.FrecuenciaId" data-ruta="@f.RutaId"
                                            data-dia="@f.DiaSemana" data-horario="@horario"
                                            selected="selected">
                                        @dia | @horario
                                    </option>
                                }
                                else
                                {
                                    <option value="@f.FrecuenciaId" data-ruta="@f.RutaId"
                                            data-dia="@f.DiaSemana" data-horario="@horario">
                                        @dia | @horario
                                    </option>
                                }
                            }
                        </select>
                        @Html.ValidationMessageFor(m => m.FrecuenciaId, "", new { @class = "text-danger" })
                        <div class="vip-hint">Elige el día y horario de salida establecidos para esta ruta.</div>
                    </div>

                    <div class="vip-campo">
                        <label for="FechaOperacion">Fecha de operación</label>
                        <select id="FechaOperacion" name="FechaOperacion" class="vip-entrada"
                                data-fecha-inicial="@(Model == null || Model.FechaOperacion == DateTime.MinValue ? "" : Model.FechaOperacion.ToString("yyyy-MM-dd"))"
                                required>
                            <option value="">-- Selecciona primero un día y horario --</option>
                        </select>
                        @Html.ValidationMessageFor(m => m.FechaOperacion, "", new { @class = "text-danger" })
                        <div class="vip-hint">Solo aparecen fechas del día de semana elegido, durante los próximos 12 meses.</div>
                        <div id="avAvisoFecha" class="small text-danger mt-1" role="status"></div>
                    </div>

                    <div class="vip-campo">
                        <label for="AeronaveId">Aeronave</label>
                        @Html.DropDownListFor(m => m.AeronaveId, aeronaves,
                            "-- Seleccione una aeronave --",
                            new { @class = "vip-entrada", required = "required" })
                        @Html.ValidationMessageFor(m => m.AeronaveId, "", new { @class = "text-danger" })
                        <div class="vip-hint">Selecciona una aeronave disponible para ese horario.</div>
                    </div>

                    <div class="vip-campo">
                        <label for="EstadoVueloCodigo">Estado del vuelo</label>
                        @Html.DropDownListFor(m => m.EstadoVueloCodigo, estados,
                            "-- Seleccione un estado --",
                            new { @class = "vip-entrada", required = "required" })
                        @Html.ValidationMessageFor(m => m.EstadoVueloCodigo, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="vip-resumen" aria-live="polite">
                    <strong>Resumen de programación</strong>
                    <span id="avResumen">Selecciona una ruta y frecuencia para ver el horario.</span>
                </div>

                <div class="vip-acciones">
                    <button type="submit" class="vip-guardar">Guardar cambios</button>
                    @Html.ActionLink("Cancelar", "Administrar", "Vueloes", null,
                        new { @class = "vip-volver" })
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="@Url.Content("~/Scripts/vip-vuelos-fechas.js")"></script>
}
