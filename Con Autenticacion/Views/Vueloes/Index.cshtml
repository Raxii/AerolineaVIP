
@using System.Linq
@using Con_Autenticacion.Models
@model IEnumerable<Vuelo>

@{
    ViewBag.Title = "Vuelos";

    bool esAdministrador = Request.IsAuthenticated &&
        (User.IsInRole("SuperUsuario") ||
         User.IsInRole("Administrador"));

    int totalVuelos = Model == null ? 0 : Model.Count();

    int vuelosProgramados = Model == null ? 0 :
        Model.Count(v => v.EstadoVueloCodigo == "PROGRAMADO");

    int vuelosConfirmados = Model == null ? 0 :
        Model.Count(v => v.EstadoVueloCodigo == "CONFIRMADO");
}

<div class="container py-4" style="max-width:1250px;">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="h4 fw-bold mb-1">
                Gestión y consulta de vuelos
            </h2>

            <p class="text-muted small mb-0">
                Consulta los vuelos registrados y accede a sus operaciones.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            @Html.ActionLink(
                "Buscar vuelos",
                "Buscar",
                "Vueloes",
                null,
                new { @class = "btn btn-outline-primary btn-sm" }
            )

            @Html.ActionLink(
                "Resultados",
                "Resultados",
                "Vueloes",
                null,
                new { @class = "btn btn-outline-secondary btn-sm" }
            )

            @if (esAdministrador)
            {
                @Html.ActionLink(
                    "Administrar",
                    "Administrar",
                    "Vueloes",
                    null,
                    new { @class = "btn btn-outline-dark btn-sm" }
                )

                @Html.ActionLink(
                    "Nuevo vuelo",
                    "Create",
                    "Vueloes",
                    null,
                    new
                         {
                        @class = "btn btn-sm text-white",
                        style = "background-color:#172A3B;"
                    }
                )
            }

        </div>
    </div>

    <!-- Resumen de vuelos -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="small text-muted">
                        Total de vuelos
                    </div>

                    <div class="fs-3 fw-bold">
                        @totalVuelos
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="small text-muted">
                        Programados
                    </div>

                    <div class="fs-3 fw-bold">
                        @vuelosProgramados
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">

                    <div class="small text-muted">
                        Confirmados
                    </div>

                    <div class="fs-3 fw-bold">
                        @vuelosConfirmados
                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Tabla de vuelos -->
    <div class="card border-0 shadow-sm overflow-hidden">

        <div class="card-header bg-white py-3">
            <strong>Listado de vuelos</strong>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Fecha</th>
                        <th>Frecuencia ID</th>
                        <th>Aeronave ID</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var vuelo in Model)
                        {
                            <tr>

                                <!-- Código del vuelo -->
                                <td class="fw-semibold">
                                    @("VIP" + vuelo.VueloId.ToString("D5"))
                                </td>

                                <!-- Fecha -->
                                <td>
                                    @vuelo.FechaOperacion.ToString("dd/MM/yyyy")
                                </td>

                                <!-- Frecuencia -->
                                <td>
                                    @vuelo.FrecuenciaId
                                </td>

                                <!-- Aeronave -->
                                <td>
                                    @(vuelo.AeronaveId.HasValue
                                        ? vuelo.AeronaveId.Value.ToString()
                                        : "Sin asignar")
                                </td>

                                <!-- Estado -->
                                <td>

                                    @if (vuelo.EstadoVueloCodigo == "CONFIRMADO")
                                    {
                                        <span class="badge bg-success">
                                            Confirmado
                                        </span>
                                    }
                                    else if (vuelo.EstadoVueloCodigo == "PROGRAMADO")
                                    {
                                        <span class="badge bg-primary">
                                            Programado
                                        </span>
                                    }
                                    else if (vuelo.EstadoVueloCodigo == "CANCELADO")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelado
                                        </span>
                                    }
                                    else if (vuelo.EstadoVueloCodigo == "COMPLETADO")
                                    {
                                        <span class="badge bg-secondary">
                                            Completado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @vuelo.EstadoVueloCodigo
                                        </span>
                                    }

                                </td>

                                <!-- Acciones -->
                                <td>

                                    <div class="d-flex flex-wrap gap-1">

                                        <!-- Detalles: usa id -->
                                        @Html.ActionLink(
                                            "Detalles",
                                            "Details",
                                            "Vueloes",
                                            new { id = vuelo.VueloId },
                                            new
                                                 {
                                                @class = "btn btn-sm btn-outline-primary"
                                            }
                                        )

                                        <!-- Asientos: usa vueloId -->
                                        @Html.ActionLink(
                                            "Asientos",
                                            "DisponibilidadAsientos",
                                            "Vueloes",
                                            new { vueloId = vuelo.VueloId },
                                            new
                                                 {
                                                @class = "btn btn-sm btn-outline-secondary"
                                            }
                                        )

                                        <!-- Seleccionar: usa vueloId -->
                                        @Html.ActionLink(
                                            "Seleccionar",
                                            "Seleccionar",
                                            "Vueloes",
                                            new { vueloId = vuelo.VueloId },
                                            new
                                                 {
                                                @class = "btn btn-sm btn-outline-secondary"
                                            }
                                        )

                                        @if (esAdministrador)
                                        {
                                            <!-- Editar: usa id -->
                                            @Html.ActionLink(
                                                "Editar",
                                                "Edit",
                                                "Vueloes",
                                                new { id = vuelo.VueloId },
                                                new
                                                     {
                                                    @class = "btn btn-sm btn-outline-dark"
                                                }
                                            )

                                            <!-- Eliminar: usa id -->
                                            @Html.ActionLink(
                                                "Eliminar",
                                                "Delete",
                                                "Vueloes",
                                                new { id = vuelo.VueloId },
                                                new
                                                     {
                                                    @class = "btn btn-sm btn-outline-danger"
                                                }
                                            )
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-4">

                                No hay vuelos para mostrar.
                                Verifica que el controlador envíe
                                la lista de vuelos a esta vista.

                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>

    <!-- Nota -->
    <p class="small text-muted mt-3">
        Las operaciones están sujetas a los permisos
        y validaciones de cada acción del controlador.
    </p>

</div>
