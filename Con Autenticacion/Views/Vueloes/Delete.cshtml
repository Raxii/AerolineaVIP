@model Con_Autenticacion.Models.Vuelo

@{
    ViewBag.Title = "Eliminar vuelo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .vip-vuelo-page {
        max-width: 980px;
        margin: 0 auto;
        padding: 34px 12px 56px;
    }

    .vip-vuelo-eyebrow {
        color: #b88a3b;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .vip-vuelo-title {
        color: #172a3b;
        font-size: 1.9rem;
        font-weight: 800;
        margin: 0;
    }

    .vip-vuelo-subtitle {
        color: #64748b;
        margin: 8px 0 24px;
    }

    .vip-vuelo-card {
        background: #fff;
        border: 1px solid #e5eaf0;
        border-radius: 18px;
        box-shadow: 0 8px 26px rgba(23, 42, 59, .08);
        overflow: hidden;
    }

    .vip-vuelo-card-header {
        padding: 20px 26px;
        border-bottom: 1px solid #e8edf2;
        background: #fff;
    }

        .vip-vuelo-card-header h3 {
            color: #172a3b;
            font-size: 1.12rem;
            font-weight: 750;
            margin: 0;
        }

    .vip-vuelo-card-body {
        padding: 28px 26px;
    }

    .vip-vuelo-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 22px 24px;
    }

    .vip-vuelo-field {
        min-width: 0;
    }

    .vip-vuelo-label {
        display: block;
        color: #26394b;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .vip-vuelo-input {
        width: 100%;
        min-height: 44px;
        border: 1px solid #d7e0e8;
        border-radius: 9px;
        padding: 9px 12px;
        color: #243647;
        background: #fff;
        box-shadow: none;
    }

        .vip-vuelo-input:focus {
            border-color: #b88a3b;
            outline: 0;
            box-shadow: 0 0 0 3px rgba(184, 138, 59, .14);
        }

    .vip-vuelo-validation {
        display: block;
        margin-top: 6px;
        font-size: .88rem;
    }

    .vip-vuelo-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf1f5;
    }

    .vip-btn-primary {
        background: #172a3b;
        border: 1px solid #172a3b;
        color: #fff;
        border-radius: 9px;
        padding: 10px 19px;
        font-weight: 700;
        text-decoration: none;
    }

        .vip-btn-primary:hover,
        .vip-btn-primary:focus {
            background: #29465d;
            border-color: #29465d;
            color: #fff;
        }

    .vip-btn-secondary {
        background: #fff;
        border: 1px solid #aab6c2;
        color: #405366;
        border-radius: 9px;
        padding: 10px 18px;
        font-weight: 600;
        text-decoration: none;
    }

        .vip-btn-secondary:hover,
        .vip-btn-secondary:focus {
            background: #f3f6f9;
            color: #172a3b;
            text-decoration: none;
        }

    .vip-vuelo-alert {
        border-radius: 10px;
        margin-bottom: 20px;
    }

    .vip-delete-warning {
        border: 1px solid #f3d5d5;
        background: #fff8f8;
        color: #842029;
        border-radius: 11px;
        padding: 14px 16px;
        margin-bottom: 22px;
    }

    .vip-delete-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 24px;
    }

    .vip-delete-item {
        padding: 13px 15px;
        background: #f8fafc;
        border: 1px solid #e8edf2;
        border-radius: 10px;
    }

        .vip-delete-item dt {
            color: #64748b;
            font-size: .82rem;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .vip-delete-item dd {
            color: #172a3b;
            font-weight: 650;
            margin: 0;
            overflow-wrap: anywhere;
        }

    .vip-btn-danger {
        background: #b42318;
        border: 1px solid #b42318;
        color: #fff;
        border-radius: 9px;
        padding: 10px 18px;
        font-weight: 700;
    }

        .vip-btn-danger:hover,
        .vip-btn-danger:focus {
            background: #912018;
            border-color: #912018;
            color: #fff;
        }

    @@media (max-width: 700px) {
        .vip-vuelo-page {
            padding: 24px 10px 40px;
        }

        .vip-vuelo-grid,
        .vip-delete-details {
            grid-template-columns: 1fr;
        }

        .vip-vuelo-card-body {
            padding: 22px 18px;
        }

        .vip-vuelo-card-header {
            padding: 18px;
        }
    }
</style>

<div class="container vip-vuelo-page">
    <div class="vip-vuelo-eyebrow">Aerolínea VIP / Administración</div>
    <h2 class="vip-vuelo-title">Eliminar vuelo</h2>
    <p class="vip-vuelo-subtitle">
        Revisa la información antes de confirmar esta operación.
    </p>

    <div class="vip-vuelo-card">
        <div class="vip-vuelo-card-header">
            <h3>Vuelo #@Model.VueloId</h3>
        </div>

        <div class="vip-vuelo-card-body">
            <div class="vip-delete-warning" role="alert">
                <strong>Atención:</strong>
                ¿Estás seguro de que deseas eliminar este vuelo? Esta acción no se puede deshacer.
            </div>

            <dl class="vip-delete-details">
                <div class="vip-delete-item">
                    <dt>@Html.DisplayNameFor(model => model.VueloId)</dt>
                    <dd>@Html.DisplayFor(model => model.VueloId)</dd>
                </div>

                <div class="vip-delete-item">
                    <dt>@Html.DisplayNameFor(model => model.FrecuenciaId)</dt>
                    <dd>@Html.DisplayFor(model => model.FrecuenciaId)</dd>
                </div>

                <div class="vip-delete-item">
                    <dt>@Html.DisplayNameFor(model => model.FechaOperacion)</dt>
                    <dd>@Html.DisplayFor(model => model.FechaOperacion)</dd>
                </div>

                <div class="vip-delete-item">
                    <dt>@Html.DisplayNameFor(model => model.AeronaveId)</dt>
                    <dd>@Html.DisplayFor(model => model.AeronaveId)</dd>
                </div>

                <div class="vip-delete-item">
                    <dt>@Html.DisplayNameFor(model => model.EstadoVueloCodigo)</dt>
                    <dd>@Html.DisplayFor(model => model.EstadoVueloCodigo)</dd>
                </div>
            </dl>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.VueloId)

                <div class="vip-vuelo-actions">
                    <button type="submit" class="vip-btn-danger">
                        Sí, eliminar vuelo
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new { @class = "vip-btn-secondary" })
                </div>
            }
        </div>
    </div>
</div>
