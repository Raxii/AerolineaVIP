@using Con_Autenticacion.Models;
@model Compra

@{
    ViewBag.Title = "Compra - Detalles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .byron-vip .card-header {
        background-color: #34414C;
        color: white;
    }

    .byron-vip .btn-vip {
        background-color: #34414C;
        border-color: #34414C;
        color: white;
    }

        .byron-vip .btn-vip:hover {
            background-color: #26323B;
            color: white;
        }

    .byron-vip .table thead th {
        background-color: #E7EBEF;
        color: #34414C;
    }

    .byron-vip .card {
        border: 1px solid #E7EBEF;
    }

    .byron-vip .table td {
        vertical-align: middle;
    }

    .byron-vip .card-body {
        background-color: #FFFFFF;
    }

    .byron-vip .text-muted {
        color: #607281 !important;
    }
</style>

<div class="container py-4 byron-vip">
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h2 class="h4 mb-1">AEROLÍNEA VIP</h2>
            <p class="mb-0">Compra - Detalles</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">Resumen de la compra</p>
            <dl class="row">
                <dt class="col-sm-4">Reserva</dt>
                <dd class="col-sm-8">@(Model.Reserva != null ? Model.Reserva.CodigoReserva : "Sin código")</dd>
                <dt class="col-sm-4">Pasajero(s)</dt>
                <dd class="col-sm-8">
                    @if (Model.Reserva != null && Model.Reserva.ReservaPasajeroVuelo != null && Model.Reserva.ReservaPasajeroVuelo.Count > 0)
                    {
                        foreach (var asignacion in Model.Reserva.ReservaPasajeroVuelo)
                        {
                            if (asignacion.Pasajero != null)
                            {
                                <div>@asignacion.Pasajero.Nombres @asignacion.Pasajero.Apellidos</div>
                            }
                        }
                    }
                    else
                    { <span class="text-muted">Sin datos</span>}
            </dd>
            <dt class="col-sm-4">Fecha de compra</dt>
            <dd class="col-sm-8">@Model.FechaCompra.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Importe</dt>
            <dd class="col-sm-8">@Model.Importe.ToString("N2") @Model.MonedaCodigo</dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@(Model.EstadoCompra != null ? Model.EstadoCompra.Descripcion : Model.EstadoCompraCodigo)</dd>
        </dl>
        @Html.ActionLink("Editar", "Edit", new { id = Model.CompraId }, new { @class = "btn btn-vip" })
        @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
</div>
