@using Con_Autenticacion.Models
@using System.Collections.Generic
@using System.Web.Mvc
@model Compra
@{
    ViewBag.Title = "Registrar compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool reservaFija = Model != null && Model.ReservaId > 0;
    IEnumerable<SelectListItem> reservas =
        ViewBag.ReservaId as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
}

<div class="container py-4" style="max-width:950px">
    <div class="card shadow-sm border-0">
        <div class="card-header text-white p-4" style="background:#172a3b">
            <h2 class="h4 mb-1">AEROLINEA VIP</h2>
            <p class="mb-0">Registrar compra</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">El total de la reserva se calcula automaticamente y no se puede modificar.</p>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @using (Html.BeginForm("Create", "Compras", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Reserva</label>
                        @if (reservaFija)
                        {
                            @Html.HiddenFor(m => m.ReservaId)
                            <select class="form-select bg-light" disabled="disabled" aria-label="Reserva seleccionada">
                                @foreach (SelectListItem item in reservas)
                                {
                                    if (item.Value == Model.ReservaId.ToString())
                                    {
                                        <option selected="selected">@item.Text</option>
                                    }
                                }
                            </select>
                        }
                        else
                        {
                            @Html.DropDownListFor(m => m.ReservaId, reservas,
                                "-- Selecciona una reserva --",
                                new { @class = "form-select", required = "required" })
                            @Html.ValidationMessageFor(m => m.ReservaId, "", new { @class = "text-danger" })
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Importe total</label>
                        <div class="input-group">
                            <span class="input-group-text">USD</span>
                            <div class="form-control bg-light fw-bold" aria-label="Importe total">
                                @(reservaFija ? Model.Importe.ToString("N2") : "Se calcula al registrar")
                            </div>
                        </div>
                        <div class="form-text">El precio final se verifica en el servidor antes de guardar y pagar.</div>
                    </div>
                </div>

                <button type="submit" class="btn text-white" style="background:#172a3b">
                    Registrar y continuar al pago
                </button>
                @Html.ActionLink("Volver a mis reservas", "Reservas", "MisViajes", null,
                    new { @class = "btn btn-outline-secondary ms-2" })
            }
        </div>
    </div>
</div>
