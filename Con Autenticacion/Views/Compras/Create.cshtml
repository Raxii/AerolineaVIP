@using Con_Autenticacion.Models;
@model Compra

@{
    ViewBag.Title = "Nuevo registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .clase-vip .card-header {
        background: #34414C;
        color: white;
    }

    .clase-vip .btn-vip {
        background: #34414C;
        border-color: #34414C;
        color: white;
    }

        .clase-vip .btn-vip:hover {
            background: #26323B;
            color: white;
        }

    .clase-vip .table thead {
        background: #E7EBEF;
    }

    .clase-vip .card {
        border: 1px solid #E7EBEF;
    }

    .clase-vip .form-control, .clase-vip .form-select {
        background: #FFFFFF;
    }
</style>


<div class="container py-4 clase-vip">
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h2 class="h4 mb-1">AEROLÍNEA VIP</h2>
            <p class="mb-0">Nuevo registro</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">Administración de compras</p>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.ReservaId, "Reserva", new { @class = "form-label" })
                        @Html.DropDownList("ReservaId", null, new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.ReservaId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.FechaCompra, "Fecha de compra", new { @class = "form-label" })
                        @Html.EditorFor(model => model.FechaCompra, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FechaCompra, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.Importe, "Importe", new { @class = "form-label" })
                        @Html.EditorFor(model => model.Importe, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Importe, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.MonedaCodigo, "Moneda", new { @class = "form-label" })
                        @Html.DropDownList("MonedaCodigo", null, new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.MonedaCodigo, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.EstadoCompraCodigo, "Estado de compra", new { @class = "form-label" })
                        @Html.DropDownList("EstadoCompraCodigo", null, new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.EstadoCompraCodigo, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(model => model.ClaveIdempotencia, "Código de operación", new { @class = "form-label" })
                        @Html.EditorFor(model => model.ClaveIdempotencia, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ClaveIdempotencia, "", new { @class = "text-danger" })
                    </div>
                </div>
                <button type="submit" class="btn btn-vip">Guardar</button>
                @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-outline-secondary" })
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
