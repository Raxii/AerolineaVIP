@model Con_Autenticacion.Models.Aeronave

@{
    ViewBag.Title = "Detalle de aeronave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width:850px">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h2 class="h4 mb-0">Detalle de aeronave</h2>
        </div>
        <div class="card-body p-4">
            <dl class="row">
                <dt class="col-sm-4">Matricula</dt>
                <dd class="col-sm-8">@Model.Matricula</dd>

                <dt class="col-sm-4">Modelo</dt>
                <dd class="col-sm-8">@(Model.ModeloAeronave == null ? "-" : Model.ModeloAeronave.Nombre)</dd>

                <dt class="col-sm-4">Capacidad</dt>
                <dd class="col-sm-8">@(Model.ModeloAeronave == null ? 0 : Model.ModeloAeronave.CapacidadAsientos)</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@(Model.EstadoAeronave == null ? Model.EstadoAeronaveCodigo : Model.EstadoAeronave.Descripcion)</dd>
            </dl>

            @Html.ActionLink("Editar", "Edit", new { id = Model.AeronaveId }, new { @class = "btn btn-dark" })
            @Html.ActionLink("Volver", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
</div>
