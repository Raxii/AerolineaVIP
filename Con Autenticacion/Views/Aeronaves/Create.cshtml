@model Con_Autenticacion.Models.Aeronave

@{
    ViewBag.Title = "Registrar aeronave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width:850px">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h2 class="h4 mb-0">Registrar aeronave</h2>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Matricula, "Matricula", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Matricula, new { @class = "form-control", maxlength = "20", required = "required" })
                    @Html.ValidationMessageFor(m => m.Matricula, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.ModeloAeronaveId, "Modelo", new { @class = "form-label" })
                    @Html.DropDownList("ModeloAeronaveId", null, "Seleccione un modelo", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.ModeloAeronaveId, "", new { @class = "text-danger" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.EstadoAeronaveCodigo, "Estado", new { @class = "form-label" })
                    @Html.DropDownList("EstadoAeronaveCodigo", null, "Seleccione un estado", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.EstadoAeronaveCodigo, "", new { @class = "text-danger" })
                </div>
                <button class="btn btn-dark" type="submit">Guardar aeronave</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
            }
        </div>
    </div>
</div>
