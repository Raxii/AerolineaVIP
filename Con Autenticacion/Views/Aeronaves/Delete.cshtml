@model Con_Autenticacion.Models.Aeronave

@{
    ViewBag.Title = "Eliminar aeronave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width:850px">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h2 class="h4 mb-0">Eliminar aeronave</h2>
        </div>
        <div class="card-body p-4">
            <div class="alert alert-warning">Confirma si deseas eliminar esta aeronave.</div>
            <p><strong>Matricula:</strong> @Model.Matricula</p>
            <p><strong>Modelo:</strong> @(Model.ModeloAeronave == null ? "-" : Model.ModeloAeronave.Nombre)</p>

            @using (Html.BeginForm("Delete", "Aeronaves", new { id = Model.AeronaveId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Confirmar eliminacion</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
            }
        </div>
    </div>
</div>
