@using System.Linq
@using System.Collections.Generic
@using Con_Autenticacion.Models
@model IEnumerable<Aeronave>

@{
    ViewBag.Title = "Aeronaves";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var registros = ViewBag.ListaAeronaves as IEnumerable<Aeronave> ?? Model ?? new List<Aeronave>();
    var vuelos = ViewBag.VuelosPorAeronave as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3">Gestion de aeronaves</h2>
            <p class="text-muted mb-0">Administracion de la flota</p>
        </div>
        @Html.ActionLink("Nueva aeronave", "Create", null, new { @class = "btn btn-dark" })
    </div>

    @using (Html.BeginForm("Index", "Aeronaves", FormMethod.Get, new { @class = "row g-2 mb-3" }))
    {
        <div class="col-md-5">
            <input name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por matricula" />
        </div>
        <div class="col-md-3">
            <select name="estadoCodigo" class="form-select">
                <option value="">Todos los estados</option>
                @foreach (EstadoAeronave e in (ViewBag.Estados as IEnumerable<EstadoAeronave> ?? new List<EstadoAeronave>()))
                {
                    <option value="@e.Codigo" selected="@(Convert.ToString(ViewBag.EstadoSeleccionado) == e.Codigo ? "selected" : null)">@e.Descripcion</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="modeloId" class="form-select">
                <option value="">Todos los modelos</option>
                @foreach (ModeloAeronave m in (ViewBag.Modelos as IEnumerable<ModeloAeronave> ?? new List<ModeloAeronave>()))
                {
                    <option value="@m.ModeloAeronaveId" selected="@(Convert.ToString(ViewBag.ModeloSeleccionado) == m.ModeloAeronaveId.ToString() ? "selected" : null)">@m.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-1">
            <button class="btn btn-outline-dark w-100" type="submit">Filtrar</button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Matricula</th>
                        <th>Modelo</th>
                        <th>Capacidad</th>
                        <th>Estado</th>
                        <th>Vuelos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in registros)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Matricula</td>
                            <td>@(item.ModeloAeronave == null ? "-" : item.ModeloAeronave.Nombre)</td>
                            <td>@(item.ModeloAeronave == null ? 0 : item.ModeloAeronave.CapacidadAsientos)</td>
                            <td>@(item.EstadoAeronave == null ? item.EstadoAeronaveCodigo : item.EstadoAeronave.Descripcion)</td>
                            <td>@(vuelos.ContainsKey(item.AeronaveId) ? vuelos[item.AeronaveId] : 0)</td>
                            <td class="text-nowrap">
                                @Html.ActionLink("Ver", "Details", new { id = item.AeronaveId }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Editar", "Edit", new { id = item.AeronaveId }, new { @class = "btn btn-sm btn-outline-primary" })
                                @Html.ActionLink("Asignaciones", "Asignaciones", new { id = item.AeronaveId }, new { @class = "btn btn-sm btn-outline-dark" })
                            </td>
                        </tr>
                    }
                    @if (!registros.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No hay aeronaves registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
