@using System.Collections.Generic
@using Con_Autenticacion.Models
@model IEnumerable<ReservaPasajeroVuelo>

@{
    ViewBag.Title = "Mi check-in";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var realizados = ViewBag.CheckInsRealizados as HashSet<int>;
    if (realizados == null) { realizados = new HashSet<int>(); }
    bool hayAsignaciones = ViewBag.HayAsignaciones != null && (bool)ViewBag.HayAsignaciones;
}

<div class="container py-4">
    <h2 class="mb-1">Mi check-in</h2>
    <p class="text-muted">Realiza el check-in de tus vuelos confirmados y pagados.</p>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!hayAsignaciones)
    {
        <div class="alert alert-info">
            No tienes vuelos habilitados para realizar check-in. Debes contar con una reserva confirmada y pagada. El check-in se habilita desde 24 horas antes y hasta 60 minutos antes de la salida.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Reserva</th>
                                <th>Pasajero</th>
                                <th>Vuelo</th>
                                <th>Fecha</th>
                                <th>Asiento</th>
                                <th>Check-in</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var asignacion in Model)
                            {
                                <tr>
                                    <td>@(asignacion.Reserva != null ? asignacion.Reserva.CodigoReserva : "-")</td>
                                    <td>@(asignacion.Pasajero != null ? asignacion.Pasajero.Nombres + " " + asignacion.Pasajero.Apellidos : "-")</td>
                                    <td>VIP@asignacion.VueloId</td>
                                    <td>@(asignacion.Vuelo != null ? asignacion.Vuelo.FechaOperacion.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                    <td>@asignacion.NumeroAsiento</td>
                                    <td>
                                        @if (realizados.Contains(asignacion.AsignacionId))
                                        {
                                            <span class="badge bg-success">Completado</span>
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("Registrar", "CheckIns", FormMethod.Post, new { @class = "d-inline" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("asignacionId", asignacion.AsignacionId)
                                                <button type="submit" class="btn btn-sm btn-primary">Realizar check-in</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
