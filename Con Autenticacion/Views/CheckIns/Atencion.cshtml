@using System.Collections.Generic
@using Con_Autenticacion.Models
@model Reserva

@{
    ViewBag.Title = "Asistencia de check-in";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var realizados = ViewBag.CheckInsRealizados as HashSet<int>;
    var elegibles = ViewBag.AsignacionesElegibles as HashSet<int>;
    if (realizados == null) { realizados = new HashSet<int>(); }
    if (elegibles == null) { elegibles = new HashSet<int>(); }
}

<div class="container py-4">
    <h2 class="mb-1">Asistencia de check-in</h2>
    <p class="text-muted">Busca la reserva del pasajero y registra su check-in cuando cumpla las condiciones.</p>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Atencion", "CheckIns", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-md-8">
                    <label for="codigoReserva" class="form-label">Codigo de reserva</label>
                    <input type="text" id="codigoReserva" name="codigoReserva" value="@ViewBag.CodigoReserva" class="form-control" placeholder="Ejemplo: RV00000001" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Buscar pasajero</button>
                </div>
            }
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.CodigoReserva)) && Model == null)
    {
        <div class="alert alert-warning">No se encontro una reserva con el codigo ingresado.</div>
    }

    @if (Model != null)
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center">
                <strong>Reserva @Model.CodigoReserva</strong>
                <span class="badge bg-secondary">@(Model.EstadoReserva != null ? Model.EstadoReserva.Descripcion : Model.EstadoReservaCodigo)</span>
            </div>
            <div class="card-body">
                <p><strong>Fecha:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                @if (Model.ReservaPasajeroVuelo != null && Model.ReservaPasajeroVuelo.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Pasajero</th>
                                    <th>Vuelo</th>
                                    <th>Fecha</th>
                                    <th>Asiento</th>
                                    <th>Accion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asignacion in Model.ReservaPasajeroVuelo)
                                {
                                    <tr>
                                        <td>@(asignacion.Pasajero != null ? asignacion.Pasajero.Nombres + " " + asignacion.Pasajero.Apellidos : "-")</td>
                                        <td>VIP@asignacion.VueloId</td>
                                        <td>@(asignacion.Vuelo != null ? asignacion.Vuelo.FechaOperacion.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                        <td>@asignacion.NumeroAsiento</td>
                                        <td>
                                            @if (realizados.Contains(asignacion.AsignacionId))
                                            {
                                                <span class="badge bg-success">Check-in completado</span>
                                            }
                                            else if (elegibles.Contains(asignacion.AsignacionId))
                                            {
                                                using (Html.BeginForm("RegistrarPorCounter", "CheckIns", FormMethod.Post, new { @class = "d-inline" }))
                                                {
                                                    @Html.AntiForgeryToken()
                                                    @Html.Hidden("asignacionId", asignacion.AsignacionId)
                                                    @Html.Hidden("codigoReserva", Model.CodigoReserva)
                                                    <button type="submit" class="btn btn-sm btn-primary">Registrar check-in</button>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small">No habilitado: requiere reserva y pago confirmados y estar dentro de la ventana de 24 horas a 60 minutos antes de la salida.</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">La reserva no tiene pasajeros asignados.</div>
                }
            </div>
        </div>
    }
</div>
