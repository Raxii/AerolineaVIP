@model IEnumerable<Con_Autenticacion.Models.CheckIn>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.FechaRegistro)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.ReservaPasajeroVuelo.EstadoAsignacionCodigo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EstadoCheckIn.Descripcion)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.FechaRegistro)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.ReservaPasajeroVuelo.EstadoAsignacionCodigo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoCheckIn.Descripcion)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.CheckInId }) |
            @Html.ActionLink("Details", "Details", new { id=item.CheckInId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.CheckInId })
        </td>
    </tr>
}

</table>
