@using Con_Autenticacion.Models;
@model Comprobante

@{
    ViewBag.Title = "Comprobante - Eliminar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .byron-vip .card-header {
        background-color: #34414C;
        color: white;
    }

    .byron-vip .btn-vip {
        background-color: #34414C;
        border-color: #34414C;
        color: white;
    }

        .byron-vip .btn-vip:hover {
            background-color: #26323B;
            color: white;
        }

    .byron-vip .table thead th {
        background-color: #E7EBEF;
        color: #34414C;
    }

    .byron-vip .card {
        border: 1px solid #E7EBEF;
    }

    .byron-vip .table td {
        vertical-align: middle;
    }

    .byron-vip .card-body {
        background-color: #FFFFFF;
    }

    .byron-vip .text-muted {
        color: #607281 !important;
    }
</style>

<div class="container py-4 byron-vip">
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h2 class="h4 mb-1">AEROLÍNEA VIP</h2>
            <p class="mb-0">Comprobante - Eliminar</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">COMPROBANTE ACADÉMICO — SIN VALIDEZ TRIBUTARIA</p>
            <dl class="row">
                <dt class="col-sm-4">Número</dt>
                <dd class="col-sm-8">@Model.NumeroComprobante</dd>
                <dt class="col-sm-4">Reserva</dt>
                <dd class="col-sm-8">@(Model.Compra != null && Model.Compra.Reserva != null ? Model.Compra.Reserva.CodigoReserva : "Sin código")</dd>
                <dt class="col-sm-4">Fecha de emisión</dt>
                <dd class="col-sm-8">@Model.FechaEmision.ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-sm-4">Total</dt>
                <dd class="col-sm-8">@(Model.Compra != null ? Model.Compra.Importe.ToString("N2") : "Sin datos")</dd>
                <dt class="col-sm-4">Tipo</dt>
                <dd class="col-sm-8">@(Model.TipoComprobante != null ? Model.TipoComprobante.Descripcion : Model.TipoComprobanteCodigo)</dd>
                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8">@(Model.EstadoComprobante != null ? Model.EstadoComprobante.Descripcion : Model.EstadoComprobanteCodigo)</dd>
            </dl>
            <div class="alert alert-warning">Confirma que deseas eliminar este registro. Esta operación puede fallar si existen registros relacionados.</div>
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Confirmar eliminación</button>
                @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
            }
        </div>
    </div>
</div>
