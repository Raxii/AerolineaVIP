@model IEnumerable<Con_Autenticacion.Models.Comprobante>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.NumeroComprobante)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.FechaEmision)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Compra.MonedaCodigo)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.EstadoComprobante.Descripcion)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.TipoComprobante.Descripcion)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.NumeroComprobante)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.FechaEmision)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Compra.MonedaCodigo)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.EstadoComprobante.Descripcion)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.TipoComprobante.Descripcion)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.ComprobanteId }) |
            @Html.ActionLink("Details", "Details", new { id=item.ComprobanteId }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.ComprobanteId })
        </td>
    </tr>
}

</table>
