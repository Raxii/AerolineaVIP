@* Layout compartido Aerolinea VIP. Navegacion MVC 5 / Bootstrap 5.
    Los enlaces requieren una accion del controlador; tener la carpeta Views no es suficiente.
    Los permisos reales deben validarse con [Authorize] en los controladores. *@
@{
    // Usuarios y roles de Aerolínea VIP (ASP.NET Identity).
    bool autenticado = Request.IsAuthenticated;
    bool esSuper = autenticado && User.IsInRole("SuperUsuario");
    bool esAdmin = autenticado && User.IsInRole("Administrador");
    bool esCounter = autenticado && User.IsInRole("Counter");
    bool esPersonalAdmin = esSuper || esAdmin;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Aerolínea VIP</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* Diseño sencillo con Bootstrap 5, sin bibliotecas adicionales. */
        body {
            background-color: #F6F8FA;
            color: #34414C;
        }

        .vip-navbar {
            background-color: #172A3B;
            border-bottom: 3px solid #CBA968;
            box-shadow: 0 3px 16px rgba(16, 35, 51, 0.12);
        }

            .vip-navbar .navbar-brand {
                color: #FFFFFF;
                font-size: 1.2rem;
                font-weight: 700;
                letter-spacing: .7px;
                line-height: 1.2;
            }

                .vip-navbar .navbar-brand:hover {
                    color: #FFFFFF;
                }

        .vip-logo {
            color: #E8C987;
            margin-right: 5px;
            font-size: 1.4rem;
        }

        .vip-subtitulo {
            display: block;
            color: #B8C6D0;
            letter-spacing: 2px;
            font-size: .58rem;
            font-weight: 400;
            margin-left: 33px;
            margin-top: 3px;
        }

        .vip-navbar .nav-link {
            color: #F4F6F8 !important;
            border-radius: 6px;
            padding: .65rem .75rem !important;
            font-size: .9rem;
        }

            .vip-navbar .nav-link:hover,
            .vip-navbar .nav-link:focus,
            .vip-navbar .nav-link.show {
                color: #172A3B !important;
                background-color: #E7EBEF;
            }

        .vip-navbar .dropdown-menu {
            border: 1px solid #E2E8EE;
            border-top: 3px solid #CBA968;
            border-radius: 8px;
            padding: 8px;
            min-width: 250px;
            box-shadow: 0 12px 28px rgba(24, 42, 58, .14);
        }

        .vip-navbar .dropdown-header {
            color: #6A7B88;
            font-size: .74rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .8px;
        }

        .vip-navbar .dropdown-item {
            color: #34414C;
            padding: 10px 13px;
            border-radius: 6px;
            white-space: normal;
            font-size: .88rem;
        }

            .vip-navbar .dropdown-item:hover,
            .vip-navbar .dropdown-item:focus {
                background-color: #F2F5F8;
                color: #172A3B;
            }

        .vip-navbar .vip-pendiente {
            display: block;
            padding: 10px 13px;
            color: #7F8B95;
            font-size: .88rem;
            cursor: not-allowed;
        }

            .vip-navbar .vip-pendiente small {
                display: block;
                font-size: .72rem;
                color: #9AA4AC;
            }

        .vip-cuenta .navbar-nav {
            align-items: center;
        }

        .vip-cuenta .nav-link {
            font-size: .85rem;
        }

        .vip-contenido {
            min-height: 73vh;
            padding-top: 32px;
            padding-bottom: 52px;
        }

        .vip-pie {
            background-color: #172A3B;
            color: #CCD6DE;
            padding: 23px 0;
            border-top: 3px solid #CBA968;
            font-size: .84rem;
        }

            .vip-pie strong {
                color: #FFFFFF;
            }

            .vip-pie a {
                color: #E8C987;
            }

        @@media (max-width: 991px) {
            .vip-navbar .dropdown-menu {
                box-shadow: none;
                margin-bottom: 8px;
            }

            .vip-cuenta .navbar-nav {
                align-items: flex-start;
            }

            .vip-subtitulo {
                margin-left: 30px;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark vip-navbar">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <span class="vip-logo">✈</span>AEROLÍNEA VIP
                <span class="vip-subtitulo">VUELOS EJECUTIVOS</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#menuVip"
                    aria-controls="menuVip" aria-expanded="false"
                    aria-label="Mostrar u ocultar menú">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menuVip">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        @Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })
                    </li>

                    <!-- Pantallas 05 y 06: el formulario y los resultados estan en Home/Index. -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">Vuelos</a>
                        <ul class="dropdown-menu">
                            <li><span class="dropdown-header">Planifica tu viaje</span></li>
                            <li>@Html.ActionLink("Buscar vuelos y ver resultados", "Index", "Home", null, new { @class = "dropdown-item" })</li>
                            @if (esPersonalAdmin)
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><span class="dropdown-header">Consultas del personal</span></li>
                                <li>@Html.ActionLink("Vuelos registrados", "Index", "Vueloes", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Catalogo de asientos", "Index", "Asientoes", null, new { @class = "dropdown-item" })</li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <!-- Pantallas 07 y 08: requieren acciones y validaciones de disponibilidad. -->
                            <li><span class="vip-pendiente" aria-disabled="true">Disponibilidad real por vuelo<small>Pendiente de accion del controlador</small></span></li>
                            <li><span class="vip-pendiente" aria-disabled="true">Elegir asiento en un vuelo<small>Pendiente de accion del controlador</small></span></li>
                        </ul>
                    </li>

                    @if (autenticado)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Mis viajes</a>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-header">Reservas de pasajeros</span></li>
                                @if (esPersonalAdmin)
                                {
                                    <li>@Html.ActionLink("Consultar reservas", "Index", "Reservas", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Consultar compras", "Index", "Compras", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Comprobantes", "Index", "Comprobantes", null, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Registros de check-in", "Index", "CheckIns", null, new { @class = "dropdown-item" })</li>
                                }
                                else
                                {
                                    <!-- No enlazar los CRUD generales a clientes: falta filtrado por titular. -->
                                    <li><span class="vip-pendiente" aria-disabled="true">Mis reservas<small>Pendiente de consulta segura por usuario</small></span></li>
                                    <li><span class="vip-pendiente" aria-disabled="true">Mis comprobantes<small>Pendiente de consulta segura por usuario</small></span></li>
                                    <li><span class="vip-pendiente" aria-disabled="true">Check-in<small>Pendiente de validaciones del servidor</small></span></li>
                                }
                            </ul>
                        </li>
                    }

                    @if (esPersonalAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Operaciones</a>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-header">Gestión comercial</span></li>
                                <li>@Html.ActionLink("Pasajeros", "Index", "Pasajeroes", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Reservas", "Index", "Reservas", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Compras", "Index", "Compras", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Comprobantes", "Index", "Comprobantes", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Check-in", "Index", "CheckIns", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Flota y rutas</a>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-header">Administración de vuelos</span></li>
                                <li>@Html.ActionLink("Administrar vuelos", "Index", "Vueloes", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Aeronaves", "Index", "Aeronaves", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Modelos de aeronaves", "Index", "ModeloAeronaves", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Asientos", "Index", "Asientoes", null, new { @class = "dropdown-item" })</li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><span class="dropdown-header">Programación</span></li>
                                <li>@Html.ActionLink("Aeropuertos", "Index", "Aeropuerto", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Rutas", "Index", "Rutas", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Frecuencias", "Index", "Frecuencias", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Itinerarios", "Index", "Itinerarios", null, new { @class = "dropdown-item" })</li>
                                <li>@Html.ActionLink("Tramos de itinerarios", "Index", "TramoItinerarios", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-header">Herramientas de gestión</span></li>
                                @if (esSuper)
                                {
                                    <li>@Html.ActionLink("Usuarios y roles", "Index", "Usuarios", null, new { @class = "dropdown-item" })</li>
                                }
                                <!-- Pantalla 17: necesita CrudController.Index() y Views/Crud/Index.cshtml. -->
                                <li>@Html.ActionLink("Menu administrativo CRUD", "Index", "Crud", null, new { @class = "dropdown-item" })</li>
                                <!-- Pantalla 21: necesita ReportesController.Index() y Views/Reportes/Index.cshtml. -->
                                <li>@Html.ActionLink("Reportes administrativos", "Index", "Reportes", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }

                    @if (esCounter)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Atención</a>
                            <ul class="dropdown-menu">
                                <li><span class="dropdown-header">Personal Counter</span></li>
                                <li><span class="vip-pendiente" aria-disabled="true">Consulta de reservas<small>Esperando autorización específica del servidor</small></span></li>
                                <li><span class="vip-pendiente" aria-disabled="true">Asistencia de check-in<small>Esperando autorización específica del servidor</small></span></li>
                            </ul>
                        </li>
                    }

                    @if (autenticado)
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Mi cuenta", "Index", "Manage", null, new { @class = "nav-link" })
                        </li>
                    }
                </ul>

                <!-- Partial original: registro, inicio y cierre de sesión con antiforgery. -->
                <div class="vip-cuenta">
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <main class="container vip-contenido">
        @RenderBody()
    </main>

    <footer class="vip-pie">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><strong>AEROLÍNEA VIP</strong> &copy; @DateTime.Now.Year · Proyecto académico</span>
            <span>Grupo 3 · Sistema de reservas y administración de vuelos</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    <!-- Bootstrap 5 con Popper integrado: necesario para los menus desplegables. -->
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
