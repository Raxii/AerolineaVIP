
@{
    bool autenticado = Request.IsAuthenticated;

    bool esSuper = autenticado && User.IsInRole("SuperUsuario");
    bool esAdmin = autenticado && User.IsInRole("Administrador");
    bool esCounter = autenticado && User.IsInRole("Counter");
    bool esCliente = autenticado && User.IsInRole("Cliente");

    bool esPersonalAdmin = esSuper || esAdmin;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Aerolinea VIP</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        /* =========================================
           CONFIGURACION GENERAL
        ========================================= */

        html {
            min-height: 100%;
            width: 100%;
        }

        body {
            min-height: 100vh;
            margin: 0;
            padding: 0 !important;
            display: flex;
            flex-direction: column;
            background: #F4F7FA;
            color: #34414C;
            font-family: "Segoe UI", Arial, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        /* =========================================
           BARRA DE NAVEGACION
        ========================================= */

        .vip-navbar {
            flex: 0 0 auto;
            width: 100%;
            margin: 0 !important;
            padding: 0;
            background: #172A3B;
            border: none;
            border-bottom: 3px solid #CBA968;
            border-radius: 0;
            box-shadow: 0 3px 15px rgba(0,0,0,.10);
            z-index: 1030;
        }

            .vip-navbar > .container-fluid {
                min-height: 75px;
                display: flex;
                align-items: center;
            }

            /* LOGOTIPO */

            .vip-navbar .navbar-brand {
                display: flex;
                flex-direction: column;
                justify-content: center;
                color: #FFFFFF;
                font-size: 1.22rem;
                font-weight: 750;
                letter-spacing: .7px;
                line-height: 1.2;
                padding: 10px 12px 10px 0;
                margin-right: 20px;
                white-space: nowrap;
            }

                .vip-navbar .navbar-brand:hover {
                    color: #E8C987;
                }

        .vip-subtitulo {
            display: block;
            color: #B8C6D0;
            font-size: .58rem;
            font-weight: 400;
            letter-spacing: 2.2px;
            margin-top: 5px;
        }

        /* ENLACES */

        .vip-navbar .navbar-nav {
            align-items: center;
            gap: 3px;
        }

        .vip-navbar .nav-link {
            color: #F4F6F8 !important;
            font-size: .9rem;
            font-weight: 500;
            padding: 11px 13px !important;
            border-radius: 7px;
            transition: background .2s, color .2s;
        }

            .vip-navbar .nav-link:hover,
            .vip-navbar .nav-link:focus,
            .vip-navbar .nav-link.show {
                color: #172A3B !important;
                background: #E8C987;
            }

        /* BOTON MOVIL */

        .vip-navbar .navbar-toggler {
            border: 1px solid #718292;
            border-radius: 7px;
            padding: 7px 10px;
        }

            .vip-navbar .navbar-toggler:focus {
                box-shadow: 0 0 0 3px rgba(203,169,104,.25);
            }

        /* =========================================
           MENUS DESPLEGABLES
        ========================================= */

        .vip-navbar .dropdown-menu {
            min-width: 250px;
            padding: 9px;
            margin-top: 8px;
            border: 1px solid #E2E8EE;
            border-top: 3px solid #CBA968;
            border-radius: 9px;
            background: #FFFFFF;
            box-shadow: 0 12px 30px rgba(24,42,58,.16);
        }

        .vip-navbar .dropdown-header {
            color: #9A793E;
            font-size: .73rem;
            font-weight: 750;
            letter-spacing: .8px;
            text-transform: uppercase;
            padding: 9px 12px 7px;
        }

        .vip-navbar .dropdown-item {
            color: #34414C;
            font-size: .88rem;
            padding: 10px 12px;
            border-radius: 6px;
            white-space: normal;
            transition: background .2s;
        }

            .vip-navbar .dropdown-item:hover,
            .vip-navbar .dropdown-item:focus {
                background: #F1F4F7;
                color: #172A3B;
            }

        .vip-navbar .dropdown-divider {
            border-top-color: #E6EAF0;
            margin: 7px 0;
        }

        .vip-pendiente {
            display: block;
            padding: 10px 12px;
            color: #89949E;
            font-size: .88rem;
            cursor: not-allowed;
        }

            .vip-pendiente small {
                display: block;
                color: #AAB3BB;
                font-size: .72rem;
                margin-top: 3px;
            }

        /* =========================================
           CUENTA DE USUARIO
        ========================================= */

        .vip-cuenta {
            margin-left: auto;
            display: flex;
            align-items: center;
        }

            .vip-cuenta .navbar-nav {
                align-items: center;
            }

            .vip-cuenta .nav-link {
                font-size: .86rem;
            }

        /* =========================================
           CONTENIDO PRINCIPAL
        ========================================= */

        .vip-contenido {
            flex: 1 0 auto;
            width: 100%;
            padding: 32px 24px 48px;
            margin: 0;
        }

        .vip-main-inner {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
        }

            /* Evita que las tablas y formularios desborden */

            .vip-main-inner img {
                max-width: 100%;
            }

            .vip-main-inner .table-responsive {
                width: 100%;
            }

        /* =========================================
           FOOTER
        ========================================= */

        .vip-pie {
            flex-shrink: 0;
            width: 100%;
            margin-top: auto;
            padding: 23px 24px;
            background: #172A3B;
            color: #CCD6DE;
            border-top: 3px solid #CBA968;
            font-size: .84rem;
        }

            .vip-pie strong {
                color: #FFFFFF;
                font-weight: 750;
            }

            .vip-pie a {
                color: #E8C987;
            }

        .vip-footer-inner {
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
        }

        /* =========================================
           RESPONSIVE
        ========================================= */

        @@media (max-width: 991px) {

            .vip-navbar > .container-fluid {
                min-height: 68px;
                flex-wrap: wrap;
            }

            .vip-navbar .navbar-collapse {
                width: 100%;
                padding: 10px 0 15px;
                border-top: 1px solid rgba(255,255,255,.12);
            }

            .vip-navbar .navbar-nav {
                align-items: stretch;
                gap: 2px;
            }

            .vip-navbar .nav-link {
                padding: 10px 12px !important;
            }

            .vip-navbar .dropdown-menu {
                margin-top: 3px;
                margin-bottom: 8px;
                box-shadow: none;
            }

            .vip-cuenta {
                margin: 12px 0 0;
                padding-top: 10px;
                border-top: 1px solid rgba(255,255,255,.15);
            }

                .vip-cuenta .navbar-nav {
                    align-items: stretch;
                }

            .vip-contenido {
                padding: 25px 16px 35px;
            }

            .vip-footer-inner {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @@media (max-width: 576px) {

            .vip-navbar .navbar-brand {
                font-size: 1.05rem;
            }

            .vip-subtitulo {
                font-size: .53rem;
            }

            .vip-contenido {
                padding: 20px 12px 30px;
            }

            .vip-pie {
                padding: 19px 15px;
                font-size: .78rem;
            }
        }
    </style>

    @RenderSection("Styles", required: false)

</head>

<body>

    <!-- =========================================
         NAVEGACION PRINCIPAL
    ========================================== -->

    <nav class="navbar navbar-expand-lg navbar-dark vip-navbar">

        <div class="container-fluid px-3 px-lg-4">

            <!-- LOGOTIPO -->

            <a class="navbar-brand"
               href="@Url.Action("Index", "Home")">

                AEROLINEA VIP

                <span class="vip-subtitulo">
                    VUELOS EJECUTIVOS
                </span>

            </a>

            <!-- BOTON RESPONSIVE -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuVip"
                    aria-controls="menuVip"
                    aria-expanded="false"
                    aria-label="Mostrar menu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- MENU -->

            <div class="collapse navbar-collapse" id="menuVip">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    <!-- INICIO -->

                    <li class="nav-item">

                        @Html.ActionLink(
                            "Inicio",
                            "Index",
                            "Home",
                            null,
                            new { @class = "nav-link" }
                        )

                    </li>

                    <!-- VUELOS -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                           href="#"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            Vuelos

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <span class="dropdown-header">
                                    Planifica tu viaje
                                </span>
                            </li>

                            <li>
                                @Html.ActionLink(
                                    "Buscar vuelos y ver resultados",
                                    "Index",
                                    "Home",
                                    null,
                                    new { @class = "dropdown-item" }
                                )
                            </li>

                            <li>
                                @Html.ActionLink(
                                    "Buscar vuelos disponibles",
                                    "Buscar",
                                    "Vueloes",
                                    null,
                                    new { @class = "dropdown-item" }
                                )
                            </li>

                            <li>
                                @Html.ActionLink(
                                    "Ver vuelos y elegir asiento",
                                    "Index",
                                    "Vueloes",
                                    null,
                                    new { @class = "dropdown-item" }
                                )
                            </li>

                            @if (esPersonalAdmin)
                            {
                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <span class="dropdown-header">
                                        Consultas del personal
                                    </span>
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Vuelos registrados",
                                        "Index",
                                        "Vueloes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Catalogo de asientos",
                                        "Index",
                                        "Asientoes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>
                            }

                        </ul>

                    </li>

                    <!-- MIS VIAJES -->

                    @if (esCliente)
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Mis viajes

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <span class="dropdown-header">
                                        Reservas de pasajeros
                                    </span>
                                </li>

                                @if (esPersonalAdmin)
                                {
                                    <li>
                                        @Html.ActionLink(
                                            "Consultar reservas",
                                            "Index",
                                            "Reservas",
                                            null,
                                            new { @class = "dropdown-item" }
                                        )
                                    </li>

                                    <li>
                                        @Html.ActionLink(
                                            "Consultar compras",
                                            "Index",
                                            "Compras",
                                            null,
                                            new { @class = "dropdown-item" }
                                        )
                                    </li>

                                    <li>
                                        @Html.ActionLink(
                                            "Comprobantes",
                                            "Index",
                                            "Comprobantes",
                                            null,
                                            new { @class = "dropdown-item" }
                                        )
                                    </li>

                                    <li>
                                        @Html.ActionLink(
                                            "Registros de check-in",
                                            "Index",
                                            "CheckIns",
                                            null,
                                            new { @class = "dropdown-item" }
                                        )
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <span class="vip-pendiente">
                                            Mis reservas
                                            <small>Consulta pendiente de implementacion</small>
                                        </span>
                                    </li>

                                    <li>
                                        <span class="vip-pendiente">
                                            Mis comprobantes
                                            <small>Consulta pendiente de implementacion</small>
                                        </span>
                                    </li>

                                    <li>
                                        <span class="vip-pendiente">
                                            Check-in
                                            <small>Validaciones pendientes</small>
                                        </span>
                                    </li>
                                }

                            </ul>

                        </li>
                    }

                    <!-- MENUS ADMINISTRATIVOS -->

                    @if (esPersonalAdmin)
                    {

                        <!-- OPERACIONES -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Operaciones

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <span class="dropdown-header">
                                        Gestion comercial
                                    </span>
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Pasajeros",
                                        "Index",
                                        "Pasajeroes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Reservas",
                                        "Index",
                                        "Reservas",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Compras",
                                        "Index",
                                        "Compras",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Comprobantes",
                                        "Index",
                                        "Comprobantes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Check-in",
                                        "Index",
                                        "CheckIns",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                            </ul>

                        </li>

                        <!-- FLOTA Y RUTAS -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Flota y rutas

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <span class="dropdown-header">
                                        Administracion de vuelos
                                    </span>
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Administrar vuelos",
                                        "Index",
                                        "Vueloes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Aeronaves",
                                        "Index",
                                        "Aeronaves",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Modelos de aeronaves",
                                        "Index",
                                        "ModeloAeronaves",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Asientos",
                                        "Index",
                                        "Asientoes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li><hr class="dropdown-divider" /></li>

                                <li>
                                    <span class="dropdown-header">
                                        Programacion
                                    </span>
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Aeropuertos",
                                        "Index",
                                        "Aeropuerto",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Rutas",
                                        "Index",
                                        "Rutas",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Frecuencias",
                                        "Index",
                                        "Frecuencias",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Itinerarios",
                                        "Index",
                                        "Itinerarios",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Tramos de itinerarios",
                                        "Index",
                                        "TramoItinerarios",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                            </ul>

                        </li>

                        <!-- ADMINISTRACION -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Administracion

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <span class="dropdown-header">
                                        Herramientas de gestion
                                    </span>
                                </li>

                                @if (esSuper)
                                {
                                    <li>
                                        @Html.ActionLink(
                                            "Usuarios y roles",
                                            "Index",
                                            "Usuarios",
                                            null,
                                            new { @class = "dropdown-item" }
                                        )
                                    </li>
                                }

                                <li>
                                    @Html.ActionLink(
                                        "Menu administrativo CRUD",
                                        "Index",
                                        "Crud",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Reportes administrativos",
                                        "Index",
                                        "Reportes",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                            </ul>

                        </li>

                    }

                    <!-- ATENCION COUNTER -->

                    @if (esCounter)
                    {
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Atencion

                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <span class="dropdown-header">
                                        Atencion al pasajero
                                    </span>
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Consultar reservas",
                                        "Index",
                                        "Reservas",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                                <li>
                                    @Html.ActionLink(
                                        "Gestionar check-in",
                                        "Index",
                                        "CheckIns",
                                        null,
                                        new { @class = "dropdown-item" }
                                    )
                                </li>

                            </ul>

                        </li>
                    }

                    <!-- MI CUENTA -->

                    @if (autenticado)
                    {
                        <li class="nav-item">

                            @Html.ActionLink(
                                "Mi cuenta",
                                "Index",
                                "Manage",
                                null,
                                new { @class = "nav-link" }
                            )

                        </li>
                    }

                </ul>

                <!-- LOGIN Y CERRAR SESION -->

                <div class="vip-cuenta">

                    @Html.Partial("_LoginPartial")

                </div>

            </div>

        </div>

    </nav>

    <!-- =========================================
         CONTENIDO PRINCIPAL
    ========================================== -->

    <main class="vip-contenido">

        <div class="vip-main-inner">

            @RenderBody()

        </div>

    </main>

    <!-- =========================================
         FOOTER
    ========================================== -->

    <footer class="vip-pie">

        <div class="vip-footer-inner">

            <div>
                <strong>AEROLINEA VIP</strong>
                &copy; @DateTime.Now.Year
                - Proyecto academico
            </div>

            <div>
                Grupo 3 - Sistema de reservas y administracion de vuelos
            </div>

        </div>

    </footer>

    <!-- =========================================
         SCRIPTS
    ========================================== -->

    @Scripts.Render("~/bundles/jquery")

    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
