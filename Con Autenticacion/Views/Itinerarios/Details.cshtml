@model Con_Autenticacion.Models.Itinerario
@{
    ViewBag.Title = "Detalle de itinerario";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string estado = Model.EstadoItinerario != null ? Model.EstadoItinerario.Descripcion : Model.EstadoItinerarioCodigo;
}
<div class="container py-4" style="max-width:980px;">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
                Programacion / Consulta
            </div>
            <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
                Detalle del itinerario
            </h1>
            <p class="text-muted mb-0">
                Informacion del recorrido seleccionado.
            </p>
        </div>
        @Html.ActionLink("Volver al listado", "Index", null, new
        {
            @class = "btn btn-outline-secondary"
        }
        )
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="p-4 text-white" style="background:#172b3d;border-bottom:4px solid #c9a96e;">
            <div class="small text-uppercase opacity-75">
                Referencia
            </div>
            <div class="display-6 fw-bold">
                @Model.Referencia
            </div>
            <div class="fs-5">
                @Model.Nombre
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">
                            Estado
                        </small>
                        <strong>
                            @estado
                        </strong>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">
                            Identificador interno
                        </small>
                        <strong>
                            @Model.ItinerarioId
                        </strong>
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap mt-4">
                @Html.ActionLink("Editar itinerario", "Edit", new
                {
                    id = Model.ItinerarioId
                }
                , new
                     {
                    @class = "btn text-white",
                         style = "background:#172b3d;"
                }
                )@Html.ActionLink("Eliminar itinerario", "Delete", new
                {
                   id = Model.ItinerarioId
               }
               , new
                    {
                   @class = "btn btn-outline-danger"
               }
               )
            </div>
        </div>
    </div>
</div>
