@model Con_Autenticacion.Models.Frecuencia
@{
    ViewBag.Title = "Editar frecuencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:1000px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Programacion
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Editar frecuencia
        </h1>
        <p class="text-muted mb-0">
            Actualiza el horario seleccionado.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Frecuencia #@Model.FrecuenciaId
            </h2>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Frecuencias", FormMethod.Post, new
            {
                @class = "row g-3"
            }
           ))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.FrecuenciaId)
                @Html.ValidationSummary(true, "", new
                {
                    @class = "alert alert-danger"
                }
                )
                <div class="col-12">
                    <label class="form-label fw-semibold" for="RutaId">
                        Ruta
                    </label>
                    @Html.DropDownList("RutaId", null, "Selecciona una ruta", new
                    {
                        @class = "form-select"
                    }
                    )@Html.ValidationMessageFor(m => m.RutaId, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="DiaSemana">
                        Dia de operacion (1 a 7)
                    </label>
                    @Html.TextBoxFor(m => m.DiaSemana, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        max = "7"
                    }
                    )@Html.ValidationMessageFor(m => m.DiaSemana, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="HoraSalida">
                        Hora de salida
                    </label>
                    @Html.EditorFor(m => m.HoraSalida, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    }
                    )@Html.ValidationMessageFor(m => m.HoraSalida, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="HoraLlegada">
                        Hora de llegada
                    </label>
                    @Html.EditorFor(m => m.HoraLlegada, new
                    {
                        htmlAttributes = new
                        {
                            @class = "form-control"
                        }
                    }
                    )@Html.ValidationMessageFor(m => m.HoraLlegada, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-12">
                    <div class="form-check form-switch border rounded-3 p-3 ps-5">
                        <strong class="d-block">
                            Frecuencia activa
                        </strong>
                        <small class="text-muted d-block mb-2">
                            Controla si este horario puede utilizarse.
                        </small>
                        @Html.CheckBoxFor(m => m.Activa, new
                        {
                            @class = "form-check-input",
                            role = "switch"
                        }
                        )
                    </div>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn text-white" style="background:#172b3d;">
                        Guardar cambios
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new
                    {
                        @class = "btn btn-outline-secondary"
                    }
                    )
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
