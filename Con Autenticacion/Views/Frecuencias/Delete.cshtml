@model Con_Autenticacion.Models.Frecuencia
@{
    ViewBag.Title = "Eliminar frecuencia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string ruta = Model.Ruta != null && Model.Ruta.Aeropuerto != null && Model.Ruta.Aeropuerto1 != null ? Model.Ruta.Aeropuerto.CodigoIATA + " - " + Model.Ruta.Aeropuerto1.CodigoIATA : "Ruta " + Model.RutaId;
    int vuelos = ViewBag.VuelosAsociados == null ? -1 : (int)ViewBag.VuelosAsociados;
}
<div class="container py-4" style="max-width:900px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Confirmacion
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Eliminar frecuencia
        </h1>
        <p class="text-muted mb-0">
            Revisa las dependencias antes de continuar.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-warning border-0">
                <strong>
                    Atencion:
                </strong>
                si existen vuelos asociados, la eliminacion debe rechazarse para conservar la informacion.
            </div>
            <h2 class="h5" style="color:#172b3d;">
                Frecuencia #@Model.FrecuenciaId
            </h2>
            <div class="row g-3 my-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">
                        Ruta
                    </small>
                    <strong>
                        @ruta
                    </strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Dia
                    </small>
                    <strong>
                        @Model.DiaSemana
                    </strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Estado
                    </small>
                    <strong>
                        @(Model.Activa ? "Activa" : "Inactiva")
                    </strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">
                        Salida
                    </small>
                    <strong>
                        @Model.HoraSalida.ToString(@"hh\:mm")
                    </strong>
                </div>
                <div class="col-md-6">
                    <small class="text-muted d-block">
                        Llegada
                    </small>
                    <strong>
                        @Model.HoraLlegada.ToString(@"hh\:mm")
                    </strong>
                </div>
            </div>
            @if (vuelos > 0)
            {
                <div class="alert alert-danger">
                    No se puede eliminar: existen @vuelos vuelo(s) asociado(s).
                </div>
            }
            @using (Html.BeginForm("Delete", "Frecuencias", new
            {
                id = Model.FrecuenciaId
            }
            , FormMethod.Post, new
            {
                @class = "d-flex flex-wrap gap-2"
            }
            ))
            {
                @Html.AntiForgeryToken() @if (vuelos == 0 || vuelos == -1)
                {
                    <button type="submit" class="btn btn-danger">
                        Confirmar eliminacion
                    </button>
                }
                @Html.ActionLink("Cancelar", "Index", null, new
                {
                    @class = "btn btn-outline-secondary"
                }
                )
            }
        </div>
    </div>
</div>
