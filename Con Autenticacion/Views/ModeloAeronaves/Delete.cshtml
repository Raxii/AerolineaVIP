
@model Con_Autenticacion.Models.ModeloAeronave

@{
    ViewBag.Title = "Eliminar modelo";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string controlador = ViewContext.RouteData.Values["controller"].ToString();
}

<div class="container py-4" style="max-width:950px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Confirmacion
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">Eliminar modelo</h1>
        <p class="text-muted mb-0">Confirma la eliminacion del modelo seleccionado.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white p-4">
            <h2 class="h5 fw-bold mb-1">Confirmar eliminacion</h2>
            <p class="text-muted mb-0">Modelo #@Model.ModeloAeronaveId</p>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-danger">
                <strong>Atencion:</strong> Estas seguro de eliminar este modelo de aeronave?
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">Fabricante</small>
                        <strong>@Model.Fabricante</strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">Modelo</small>
                        <strong>@Model.Nombre</strong>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">Capacidad</small>
                        <strong>@Model.CapacidadAsientos asientos</strong>
                    </div>
                </div>
            </div>

            <div class="alert alert-warning mt-4 mb-4">
                No podras eliminar el modelo si existen aeronaves o asientos asociados.
            </div>

            @using (Html.BeginForm("Delete", controlador,
                new { id = Model.ModeloAeronaveId },
                FormMethod.Post, new { }))
            {
                @Html.AntiForgeryToken()

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-danger px-4">
                        Confirmar eliminacion
                    </button>

                    @Html.ActionLink("Cancelar", "Index", null,
                        new { @class = "btn btn-outline-secondary px-4" })
                </div>
            }
        </div>
    </div>
</div>
