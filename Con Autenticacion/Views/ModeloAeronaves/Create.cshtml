
@model Con_Autenticacion.Models.ModeloAeronave

@{
    ViewBag.Title = "Nuevo modelo de aeronave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4" style="max-width:950px;">

    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2"
             style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Configuracion
        </div>

        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Registrar modelo de aeronave
        </h1>

        <p class="text-muted mb-0">
            Registra un nuevo fabricante y modelo para la flota.
        </p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white p-4">
            <h2 class="h5 fw-bold mb-1" style="color:#172b3d;">
                Datos del modelo
            </h2>
            <small class="text-muted">
                Completa la informacion tecnica de la aeronave.
            </small>
        </div>

        <div class="card-body p-4">

            @using (Html.BeginForm("Create", "ModeloAeronaves", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.ValidationSummary(true, "",
                    new { @class = "alert alert-danger" })

                <div class="row g-3">

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Fabricante, "Fabricante",
                            new { @class = "form-label fw-semibold" })

                        @Html.TextBoxFor(m => m.Fabricante, new
                        {
                            @class = "form-control",
                            maxlength = "60",
                            required = "required",
                            placeholder = "Ej. Embraer"
                        })

                        @Html.ValidationMessageFor(m => m.Fabricante, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Nombre, "Nombre del modelo",
                            new { @class = "form-label fw-semibold" })

                        @Html.TextBoxFor(m => m.Nombre, new
                        {
                            @class = "form-control",
                            maxlength = "60",
                            required = "required",
                            placeholder = "Ej. Phenom 300E"
                        })

                        @Html.ValidationMessageFor(m => m.Nombre, "",
                            new { @class = "text-danger small" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(m => m.CapacidadAsientos,
                            "Capacidad de asientos",
                            new { @class = "form-label fw-semibold" })

                        @Html.TextBoxFor(m => m.CapacidadAsientos, new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "1",
                            max = "255",
                            step = "1",
                            required = "required",
                            placeholder = "Ej. 7"
                        })

                        @Html.ValidationMessageFor(m => m.CapacidadAsientos, "",
                            new { @class = "text-danger small" })

                        <small class="text-muted">
                            Capacidad total de pasajeros.
                        </small>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2 flex-wrap">

                    <button type="submit"
                            class="btn text-white px-4"
                            style="background:#172b3d;">
                        Registrar modelo
                    </button>

                    @Html.ActionLink("Cancelar", "Index", null,
                        new { @class = "btn btn-outline-secondary px-4" })

                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
