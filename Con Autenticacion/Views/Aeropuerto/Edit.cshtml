@model Con_Autenticacion.Models.Aeropuerto
@{
    ViewBag.Title = "Editar aeropuerto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:980px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Edicion
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Editar aeropuerto
        </h1>
        <p class="text-muted mb-0">
            Actualiza la informacion de @Model.CodigoIATA.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Datos del aeropuerto
            </h2>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Aeropuerto", FormMethod.Post, new
            {
                @class = "row g-3"
            }
           ))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.AeropuertoId)
                @Html.ValidationSummary(true, "", new
                {
                    @class = "alert alert-danger"
                }
                )
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="CodigoIATA">
                        Codigo IATA
                    </label>
                    @Html.TextBoxFor(m => m.CodigoIATA, new
                    {
                        @class = "form-control",
                        maxlength = "3"
                    }
                    )@Html.ValidationMessageFor(m => m.CodigoIATA, "", new
                   {
                      @class = "text-danger small"
                  }
                  )
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold" for="Nombre">
                        Nombre oficial
                    </label>
                    @Html.TextBoxFor(m => m.Nombre, new
                    {
                        @class = "form-control"
                    }
                    )@Html.ValidationMessageFor(m => m.Nombre, "", new
                   {
                      @class = "text-danger small"
                  }
                  )
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold" for="Localidad">
                        Ciudad o localidad
                    </label>
                    @Html.TextBoxFor(m => m.Localidad, new
                    {
                        @class = "form-control"
                    }
                    )@Html.ValidationMessageFor(m => m.Localidad, "", new
                   {
                      @class = "text-danger small"
                  }
                  )
                </div>
                <div class="col-12">
                    <div class="form-check form-switch border rounded-3 p-3 ps-5">
                        <strong class="d-block">
                            Aeropuerto activo
                        </strong>
                        <small class="text-muted d-block mb-2">
                            Controla si puede utilizarse en nuevas rutas.
                        </small>
                        @Html.CheckBoxFor(m => m.Activo, new
                        {
                            @class = "form-check-input",
                            role = "switch"
                        }
                        )
                    </div>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn text-white" style="background:#172b3d;">
                        Guardar cambios
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new
                    {
                        @class = "btn btn-outline-secondary"
                    }
                    )
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
