@model Con_Autenticacion.Models.ManageLoginsViewModel
@using Microsoft.Owin.Security
@{
    ViewBag.Title = "Administrar accesos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool mostrarQuitar = ViewBag.ShowRemoveButton != null && (bool)ViewBag.ShowRemoveButton;
}
<div class="container py-4" style="max-width:1000px;">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
                Mi cuenta / Seguridad
            </div>
            <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
                Administrar accesos
            </h1>
            <p class="text-muted mb-0">
                Consulta los proveedores externos asociados a tu cuenta.
            </p>
        </div>
        @Html.ActionLink("Volver a mi cuenta", "Index", null, new
        {
            @class = "btn btn-outline-secondary"
        }
        )
    </div>
    @if (!String.IsNullOrWhiteSpace(ViewBag.StatusMessage as string))
    {
        <div class="alert alert-success">
            @ViewBag.StatusMessage
        </div>
    }
    <div class="card border-0 shadow-sm rounded-4 mb-3">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Accesos vinculados
            </h2>
        </div>
        <div class="card-body p-4">
            @if (Model.CurrentLogins != null && Model.CurrentLogins.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>
                                    Proveedor
                                </th>
                                <th class="text-end">
                                    Accion
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in Model.CurrentLogins)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @account.LoginProvider
                                    </td>
                                    <td class="text-end">
                                        @if (mostrarQuitar)
                                        {
                                            using (Html.BeginForm("RemoveLogin", "Manage", FormMethod.Post, new
                                            {
                                                @class = "d-inline"
                                            }
                                            ))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("loginProvider", account.LoginProvider)
                                                @Html.Hidden("providerKey", account.ProviderKey)
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    Quitar
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                Acceso principal
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">
                    No hay accesos externos vinculados.
                </p>
            }
        </div>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Vincular otro proveedor
            </h2>
        </div>
        <div class="card-body p-4">
            @if (Model.OtherLogins != null && Model.OtherLogins.Count > 0)
            {
                using (Html.BeginForm("LinkLogin", "Manage", FormMethod.Post, new
                {
                    @class = "d-flex flex-wrap gap-2"
                }
                ))
                {
                    @Html.AntiForgeryToken()
                    foreach (AuthenticationDescription proveedor in Model.OtherLogins)
                    {
                        <button type="submit" class="btn btn-outline-primary" name="provider" value="@proveedor.AuthenticationType">
                            @proveedor.Caption
                        </button>
                    }
                }
            }
            else
            {
                <p class="text-muted mb-0">
                    No hay proveedores externos configurados en esta aplicacion.
                </p>
            }
        </div>
    </div>
</div>
