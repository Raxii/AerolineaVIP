@model Con_Autenticacion.Models.AddPhoneNumberViewModel
@{
    ViewBag.Title = "Agregar telefono";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:800px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Mi cuenta / Contacto
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Agregar telefono
        </h1>
        <p class="text-muted mb-0">
            Registra un numero de contacto para tu cuenta.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            @using (Html.BeginForm("AddPhoneNumber", "Manage", FormMethod.Post, new
            {
                @class = "row g-3"
            }
           ))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new
                {
                    @class = "alert alert-danger"
                }
                )
                <div class="col-12">
                    <label class="form-label fw-semibold" for="Number">
                        Numero de telefono
                    </label>
                    @Html.TextBoxFor(m => m.Number, new
                    {
                        @class = "form-control",
                        type = "tel",
                        placeholder = "Ej. 0991234567",
                        autocomplete = "tel"
                    }
                    )@Html.ValidationMessageFor(m => m.Number, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn text-white" style="background:#172b3d;">
                        Continuar
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new
                    {
                        @class = "btn btn-outline-secondary"
                    }
                    )
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
