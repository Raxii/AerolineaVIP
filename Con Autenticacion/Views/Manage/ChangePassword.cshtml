@model Con_Autenticacion.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Cambiar contrasena";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:850px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Mi cuenta / Seguridad
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Cambiar contrasena
        </h1>
        <p class="text-muted mb-0">
            Actualiza tu clave de acceso.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Nueva contrasena
            </h2>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new
            {
                @class = "row g-3"
            }
           ))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary("", new
                {
                    @class = "alert alert-danger"
                }
                )
                <div class="col-12">
                    <label class="form-label fw-semibold" for="OldPassword">
                        Contrasena actual
                    </label>
                    @Html.PasswordFor(m => m.OldPassword, new
                    {
                        @class = "form-control",
                        autocomplete = "current-password"
                    }
                    )@Html.ValidationMessageFor(m => m.OldPassword, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="NewPassword">
                        Nueva contrasena
                    </label>
                    @Html.PasswordFor(m => m.NewPassword, new
                    {
                        @class = "form-control",
                        autocomplete = "new-password"
                    }
                    )@Html.ValidationMessageFor(m => m.NewPassword, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="ConfirmPassword">
                        Confirmar contrasena
                    </label>
                    @Html.PasswordFor(m => m.ConfirmPassword, new
                    {
                        @class = "form-control",
                        autocomplete = "new-password"
                    }
                    )@Html.ValidationMessageFor(m => m.ConfirmPassword, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn text-white" style="background:#172b3d;">
                        Actualizar contrasena
                    </button>
                    @Html.ActionLink("Volver a mi cuenta", "Index", null, new
                    {
                        @class = "btn btn-outline-secondary"
                    }
                    )
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
