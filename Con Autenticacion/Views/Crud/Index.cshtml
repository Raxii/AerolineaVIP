
@using System
@using System.Collections.Generic
@using Con_Autenticacion.Models

@{
    ViewBag.Title = "Panel del Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var vuelosProgramados =
        (int)(ViewBag.VuelosProgramados ?? 0);

    var aeronavesActivas =
        (int)(ViewBag.AeronavesActivas ?? 0);

    var aeronavesEnMantenimiento =
        (int)(ViewBag.AeronavesEnMantenimiento ?? 0);

    var reservasDelDia =
        (int)(ViewBag.ReservasDelDia ?? 0);

    var vuelosCancelados =
        (int)(ViewBag.IncidenciasAbiertas ?? 0);

    var vuelosRecientes =
        ViewBag.IncidenciasRecientes as List<Vuelo>
        ?? new List<Vuelo>();
}

<style>
    .admin-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 35px 15px 55px;
    }

    .admin-header {
        background: #172a3b;
        color: white;
        padding: 32px;
        border-radius: 16px;
        margin-bottom: 25px;
        box-shadow: 0 8px 24px rgba(23,42,59,.12);
    }

        .admin-header small {
            color: #d6b36a;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .admin-header h2 {
            color: white;
            font-size: 29px;
            font-weight: 800;
            margin: 12px 0;
        }

        .admin-header p {
            color: #dce5ed;
            margin: 0;
        }

    .admin-card {
        background: white;
        border: 1px solid #e5eaf0;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(23,42,59,.05);
    }

    .admin-section-title {
        color: #172a3b;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .admin-label {
        color: #526174;
        font-size: 13px;
        font-weight: 750;
        margin-bottom: 8px;
    }

    .admin-input {
        min-height: 43px;
        border: 1px solid #dce3eb;
        border-radius: 8px;
    }

        .admin-input:focus {
            border-color: #b88a3b;
            box-shadow: 0 0 0 3px rgba(184,138,59,.12);
        }

    .admin-kpi {
        height: 100%;
        padding: 22px;
        border-radius: 14px;
        background: white;
        border: 1px solid #e5eaf0;
        box-shadow: 0 5px 18px rgba(23,42,59,.05);
    }

    .admin-kpi-label {
        color: #64748b;
        font-size: 13px;
        font-weight: 750;
    }

    .admin-kpi-value {
        color: #172a3b;
        font-size: 34px;
        font-weight: 850;
        margin: 12px 0 5px;
    }

    .admin-kpi-detail {
        color: #64748b;
        font-size: 12px;
    }

    .admin-kpi-line {
        width: 42px;
        height: 4px;
        background: #b88a3b;
        border-radius: 5px;
        margin-bottom: 15px;
    }

    .admin-action {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 48px;
        padding: 12px;
        background: #172a3b;
        border: 1px solid #172a3b;
        border-radius: 9px;
        color: white;
        text-align: center;
        font-size: 13px;
        font-weight: 750;
        text-decoration: none;
        transition: .2s;
    }

        .admin-action:hover {
            background: #29465d;
            border-color: #29465d;
            color: white;
            text-decoration: none;
        }

    .admin-action-gold {
        background: #a77b32;
        border-color: #a77b32;
    }

        .admin-action-gold:hover {
            background: #896226;
            border-color: #896226;
        }

    .admin-table thead th {
        background: #f1f5f9;
        color: #34475a;
        font-size: 12px;
        font-weight: 800;
        padding: 16px;
        white-space: nowrap;
    }

    .admin-table tbody td {
        padding: 16px;
        color: #405366;
        font-size: 13px;
        vertical-align: middle;
    }

    .admin-table tbody tr:hover {
        background: #f8fafc;
    }

    .admin-badge {
        display: inline-block;
        padding: 7px 12px;
        border-radius: 20px;
        background: #fce8e8;
        color: #a32929;
        font-size: 11px;
        font-weight: 800;
    }

    .admin-panel {
        padding: 24px;
    }

    .admin-filter-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .admin-btn {
        border-radius: 8px;
        padding: 10px 17px;
        font-size: 13px;
        font-weight: 750;
    }

    .admin-btn-primary {
        background: #172a3b;
        color: white;
        border: 1px solid #172a3b;
    }

        .admin-btn-primary:hover {
            background: #29465d;
            color: white;
        }

    .admin-btn-light {
        background: white;
        color: #405366;
        border: 1px solid #cbd5df;
    }

        .admin-btn-light:hover {
            background: #f1f5f9;
        }

    .admin-table-title {
        color: #172a3b;
        font-size: 16px;
        font-weight: 800;
    }

    @@media (max-width: 768px) {
        .admin-header {
            padding: 23px;
        }

            .admin-header h2 {
                font-size: 24px;
            }

        .admin-kpi-value {
            font-size: 29px;
        }

        .admin-panel {
            padding: 17px;
        }
    }
</style>

<div class="container admin-page">

    <!-- ENCABEZADO -->

    <div class="admin-header">

        <small>AEROLINEA VIP / ADMINISTRACION</small>

        <h2>Panel del Administrador</h2>

        <p>
            Bienvenido al centro de gestion y control
            de las operaciones de Aerolinea VIP.
        </p>

    </div>

    <!-- INDICADORES -->

    <div class="row g-3 mb-4">

        <div class="col-md-3 col-sm-6">

            <div class="admin-kpi">

                <div class="admin-kpi-line"></div>

                <div class="admin-kpi-label">
                    Vuelos programados
                </div>

                <div class="admin-kpi-value">
                    @vuelosProgramados
                </div>

                <div class="admin-kpi-detail">
                    Vuelos programados y confirmados
                </div>

            </div>

        </div>

        <div class="col-md-3 col-sm-6">

            <div class="admin-kpi">

                <div class="admin-kpi-line"></div>

                <div class="admin-kpi-label">
                    Aeronaves disponibles
                </div>

                <div class="admin-kpi-value">
                    @aeronavesActivas
                </div>

                <div class="admin-kpi-detail">
                    @aeronavesEnMantenimiento no disponibles
                </div>

            </div>

        </div>

        <div class="col-md-3 col-sm-6">

            <div class="admin-kpi">

                <div class="admin-kpi-line"></div>

                <div class="admin-kpi-label">
                    Reservas del dia
                </div>

                <div class="admin-kpi-value">
                    @reservasDelDia
                </div>

                <div class="admin-kpi-detail">
                    Reservas registradas hoy
                </div>

            </div>

        </div>

        <div class="col-md-3 col-sm-6">

            <div class="admin-kpi">

                <div class="admin-kpi-line"></div>

                <div class="admin-kpi-label">
                    Vuelos cancelados
                </div>

                <div class="admin-kpi-value text-danger">
                    @vuelosCancelados
                </div>

                <div class="admin-kpi-detail">
                    Cancelaciones registradas
                </div>

            </div>

        </div>

    </div>

    <!-- ACCESOS RAPIDOS -->

    <div class="admin-card admin-panel mb-4">

        <h5 class="admin-section-title">
            Accesos rapidos
        </h5>

        <div class="row g-3">

            <div class="col-md-3 col-sm-6">

                <a href="@Url.Action("Administrar", "Vueloes")"
                   class="admin-action">

                    Administrar vuelos

                </a>

            </div>

            <div class="col-md-3 col-sm-6">

                <a href="@Url.Action("Index", "Aeronaves")"
                   class="admin-action">

                    Gestionar aeronaves

                </a>

            </div>

            <div class="col-md-3 col-sm-6">

                <a href="@Url.Action("Index", "Reservas")"
                   class="admin-action">

                    Consultar reservas

                </a>

            </div>

            <div class="col-md-3 col-sm-6">

                <a href="@Url.Action("Index", "Reportes")"
                   class="admin-action admin-action-gold">

                    Abrir reportes

                </a>

            </div>

        </div>

    </div>

    <!-- FILTROS -->

    <div class="admin-card admin-panel mb-4">

        <h5 class="admin-section-title">
            Filtros de vuelos cancelados
        </h5>

        <div class="row g-3 align-items-end">

            <div class="col-md-4">

                <label for="filtroFecha"
                       class="form-label admin-label">

                    Fecha de operacion

                </label>

                <input type="date"
                       id="filtroFecha"
                       class="form-control admin-input" />

            </div>

            <div class="col-md-4">

                <label for="filtroEstado"
                       class="form-label admin-label">

                    Estado

                </label>

                <select id="filtroEstado"
                        class="form-select admin-input">

                    <option value="">Todos los registros</option>

                    <option value="CANCELADO">
                        Cancelado
                    </option>

                </select>

            </div>

            <div class="col-md-4">

                <div class="admin-filter-actions">

                    <button type="button"
                            id="btnAplicarFiltros"
                            class="admin-btn admin-btn-primary">

                        Aplicar filtros

                    </button>

                    <button type="button"
                            id="btnLimpiarFiltros"
                            class="admin-btn admin-btn-light">

                        Limpiar

                    </button>

                </div>

            </div>

        </div>

        <p class="small text-muted mt-3 mb-0">

            Los filtros se aplican unicamente a la tabla
            de vuelos cancelados. Los indicadores muestran
            los valores generales del sistema.

        </p>

    </div>

    <!-- TABLA DE VUELOS CANCELADOS -->

    <div class="admin-card overflow-hidden">

        <div class="d-flex justify-content-between
                    align-items-center flex-wrap gap-2
                    p-4 border-bottom">

            <div>

                <h5 class="admin-table-title mb-1">
                    Vuelos cancelados recientes
                </h5>

                <p class="small text-muted mb-0">
                    Consulta de cancelaciones registradas.
                </p>

            </div>

            <span class="badge bg-danger rounded-pill px-3 py-2">
                @vuelosCancelados cancelaciones
            </span>

        </div>

        <div class="table-responsive">

            <table class="table table-hover admin-table mb-0">

                <thead>

                    <tr>

                        <th>Codigo</th>

                        <th>Tipo</th>

                        <th>Estado</th>

                        <th>Fecha de operacion</th>

                    </tr>

                </thead>

                <tbody id="tablaIncidencias">

                    @if (vuelosRecientes.Count > 0)
                    {
                        foreach (var vuelo in vuelosRecientes)
                        {
                            var estadoTexto =
                                vuelo.EstadoVuelo != null &&
                                !String.IsNullOrWhiteSpace(
                                    vuelo.EstadoVuelo.Descripcion)
                                ? vuelo.EstadoVuelo.Descripcion
                                : "Cancelado";

                            var fechaFiltro =
                                vuelo.FechaOperacion.ToString("yyyy-MM-dd");

                            <tr class="fila-incidencia"
                                data-fecha="@fechaFiltro"
                                data-estado="@vuelo.EstadoVueloCodigo">

                                <td class="fw-bold">
                                    @("VIP" + vuelo.VueloId.ToString("D5"))
                                </td>

                                <td>
                                    Cancelacion
                                </td>

                                <td>

                                    <span class="admin-badge">
                                        @estadoTexto
                                    </span>

                                </td>

                                <td>
                                    @vuelo.FechaOperacion.ToString("dd/MM/yyyy")
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4"
                                class="text-center text-muted py-5">

                                No hay vuelos cancelados registrados.

                            </td>

                        </tr>
                    }

                    <tr id="filaSinResultados"
                        style="display:none;">

                        <td colspan="4"
                            class="text-center text-muted py-5">

                            No se encontraron vuelos con los filtros seleccionados.

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>


@section scripts {

    <script>

                document.addEventListener("DOMContentLoaded", function () {

                    // Obtener los elementos del formulario
                    var fechaElemento =
                        document.getElementById("filtroFecha");

                    var estadoElemento =
                        document.getElementById("filtroEstado");

                    var btnAplicar =
                        document.getElementById("btnAplicarFiltros");

                    var btnLimpiar =
                        document.getElementById("btnLimpiarFiltros");

                    var filas =
                        document.querySelectorAll(".fila-incidencia");

                    var filaSinResultados =
                        document.getElementById("filaSinResultados");

                    // Validar los elementos HTML
                    if (!(fechaElemento instanceof HTMLInputElement)) {
                        return;
                    }

                    if (!(estadoElemento instanceof HTMLSelectElement)) {
                        return;
                    }

                    if (!btnAplicar || !btnLimpiar) {
                        return;
                    }

                    // Los tipos quedan definidos correctamente
                    var filtroFecha = fechaElemento;
                    var filtroEstado = estadoElemento;

                    // Funcion para aplicar los filtros
                    function aplicarFiltros() {

                        var fechaSeleccionada = filtroFecha.value;
                        var estadoSeleccionado = filtroEstado.value;

                        var encontrados = 0;

                        filas.forEach(function (fila) {

                            // Verificar que sea un elemento HTML
                            if (!(fila instanceof HTMLElement)) {
                                return;
                            }

                            var fechaVuelo =
                                fila.getAttribute("data-fecha");

                            var estadoVuelo =
                                fila.getAttribute("data-estado");

                            var coincideFecha =
                                fechaSeleccionada === "" ||
                                fechaVuelo === fechaSeleccionada;

                            var coincideEstado =
                                estadoSeleccionado === "" ||
                                estadoVuelo === estadoSeleccionado;

                            if (coincideFecha && coincideEstado) {

                                fila.style.display = "";

                                encontrados++;

                            } else {

                                fila.style.display = "none";

                            }

                        });

                        // Mostrar mensaje cuando no existan resultados
                        if (filaSinResultados instanceof HTMLElement) {

                            filaSinResultados.style.display =
                                encontrados === 0 && filas.length > 0
                                ? ""
                                : "none";

                        }

                    }

                    // Boton aplicar filtros
                    btnAplicar.addEventListener("click", function () {

                        aplicarFiltros();

                    });

                    // Boton limpiar filtros
                    btnLimpiar.addEventListener("click", function () {

                        filtroFecha.value = "";
                        filtroEstado.value = "";

                        aplicarFiltros();

                    });

                });

    </script>

}
