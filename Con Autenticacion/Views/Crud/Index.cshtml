@{
    ViewBag.Title = "Panel del Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Panel del Administrador</h2>
        <p class="small text-muted mb-4">Vista general de la operación administrativa de Aerolínea VIP.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted fw-bold">Fecha</label>
                <input type="date" class="form-control form-control-sm">
            </div>

            <div class="col-md-4">
                <label class="form-label small text-muted fw-bold">Estado</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>Activos</option>
                    <option>Cancelados</option>
                    <option>Retrasados</option>
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-sm px-3 text-white fw-semibold" style="background-color: #37474f; border-color: #37474f;">Aplicar filtros</button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Vuelos programados</div>
                <div class="fs-3 fw-bold text-dark">45</div>
                <span class="small text-success">↑ 5% vs. ayer</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Aeronaves activas</div>
                <div class="fs-3 fw-bold text-dark">12</div>
                <span class="small text-muted">2 en mantenimiento</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Reservas del día</div>
                <div class="fs-3 fw-bold text-dark">128</div>
                <span class="small text-success">↑ 12% vs. ayer</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Incidencias abiertas</div>
                <div class="fs-3 fw-bold text-danger">3</div>
                <span class="small text-muted">Requieren atención</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <h6 class="fw-bold text-dark mb-3">Accesos rápidos</h6>

        <div class="row g-3">
            <div class="col-md-3">
                <button class="btn w-100 text-white fw-semibold rounded-3 py-2" style="background-color: #37474f; border-color: #37474f;">Administrar Vuelos</button>
            </div>

            <div class="col-md-3">
                <button class="btn w-100 btn-outline-secondary fw-semibold rounded-3 py-2">Gestionar Aeronaves</button>
            </div>

            <div class="col-md-3">
                <button class="btn w-100 btn-outline-secondary fw-semibold rounded-3 py-2">Consultar Reservas</button>
            </div>

            <div class="col-md-3">
                <button class="btn w-100 btn-outline-secondary fw-semibold rounded-3 py-2">Abrir Reportes</button>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #e0e0e0 !important;">
        <div class="card-header bg-light border-bottom py-3 px-4">
            <span class="small fw-bold text-dark">Incidencias recientes</span>
        </div>

        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light text-dark">
                <tr>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Vuelo</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Tipo</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Estado</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Fecha</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="py-3 px-4">VIP-401</td>
                    <td class="py-3 px-4">Retraso de salida</td>
                    <td class="py-3 px-4"><span class="badge bg-warning text-dark bg-opacity-75 rounded-pill">En revisión</span></td>
                    <td class="py-3 px-4">28 Oct 2026</td>
                </tr>
                <tr>
                    <td class="py-3 px-4">VIP-705</td>
                    <td class="py-3 px-4">Cambio de aeronave</td>
                    <td class="py-3 px-4"><span class="badge bg-success bg-opacity-75 rounded-pill">Resuelto</span></td>
                    <td class="py-3 px-4">27 Oct 2026</td>
                </tr>
                <tr>
                    <td class="py-3 px-4">VIP-210</td>
                    <td class="py-3 px-4">Asiento no disponible</td>
                    <td class="py-3 px-4"><span class="badge bg-warning text-dark bg-opacity-75 rounded-pill">En revisión</span></td>
                    <td class="py-3 px-4">26 Oct 2026</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
