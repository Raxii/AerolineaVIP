@{
    ViewBag.Title = "Panel del Administrador";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var vuelosProgramados = (int)(ViewBag.VuelosProgramados ?? 0);
    var aeronavesActivas = (int)(ViewBag.AeronavesActivas ?? 0);
    var aeronavesEnMantenimiento = (int)(ViewBag.AeronavesEnMantenimiento ?? 0);
    var reservasDelDia = (int)(ViewBag.ReservasDelDia ?? 0);
    var incidenciasAbiertas = (int)(ViewBag.IncidenciasAbiertas ?? 0);
    var incidenciasRecientes = (List<Con_Autenticacion.Models.Vuelo>)(ViewBag.IncidenciasRecientes ?? new List<Con_Autenticacion.Models.Vuelo>());
}

<div class="container py-5" style="max-width: 1200px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Panel del Administrador</h2>
        <p class="small text-muted mb-4">Vista general de la operacion administrativa de Aerolinea VIP.</p>
    </div>
    @*FALTA AGREGAR EL FILTRO*@
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted fw-bold">Fecha</label>
                <input type="date" class="form-control form-control-sm">
            </div>

            <div class="col-md-4">
                <label class="form-label small text-muted fw-bold">Estado</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>Activos</option>
                    <option>Cancelados</option>
                    <option>Retrasados</option>
                </select>
            </div>

            <div class="col-md-4 d-flex align-items-end">
                <button class="btn btn-sm px-3 text-white fw-semibold" style="background-color: #37474f; border-color: #37474f;">Aplicar filtros</button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Vuelos programados</div>
                <div class="fs-3 fw-bold text-dark">@vuelosProgramados</div>
                <span class="small text-success">Desde hoy en adelante</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Aeronaves activas</div>
                <div class="fs-3 fw-bold text-dark">@aeronavesActivas</div>
                <span class="small text-muted">@aeronavesEnMantenimiento en mantenimiento</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Reservas del dia</div>
                <div class="fs-3 fw-bold text-dark">@reservasDelDia</div>
                <span class="small text-success">Creadas hoy</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Incidencias abiertas</div>
                <div class="fs-3 fw-bold text-danger">@incidenciasAbiertas</div>
                <span class="small text-muted">Requieren atencion</span>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <h6 class="fw-bold text-dark mb-3">Accesos rapidos</h6>

        <div class="row g-3">
            <div class="col-md-3">
                <a href="@Url.Action("Administrar", "Vueloes")" class="btn w-100 text-white fw-semibold rounded-3 py-2" style="background-color: #37474f; border-color: #37474f;">Administrar Vuelos</a>
            </div>

            <div class="col-md-3">
                <a href="@Url.Action("Index", "Aeronaves")" class="btn w-100 text-white fw-semibold rounded-3 py-2" style="background-color: #37474f; border-color: #37474f;">Gestionar Aeronaves</a>
            </div>

            <div class="col-md-3">
                <button class="btn w-100 btn-outline-secondary fw-semibold rounded-3 py-2">Consultar Reservas</button>
            </div>

            <div class="col-md-3">
                <a href="@Url.Action("Index", "Reportes")" class="btn w-100 text-white fw-semibold rounded-3 py-2" style="background-color: #37474f; border-color: #37474f;">Abrir Reportes</a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #e0e0e0 !important;">
        <div class="card-header bg-light border-bottom py-3 px-4">
            <span class="small fw-bold text-dark">Incidencias recientes</span>
        </div>

        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light text-dark">
                <tr>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Vuelo</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Tipo</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Estado</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Fecha</th>
                </tr>
            </thead>
            <tbody>
                @if (incidenciasRecientes.Count > 0)
                {
                    foreach (var incidencia in incidenciasRecientes)
                    {
                        var estadoBadge = "bg-warning text-dark";
                        var estadoTexto = incidencia.EstadoVuelo != null ? incidencia.EstadoVuelo.Descripcion : "Desconocido";

                        if (incidencia.EstadoVuelo != null && incidencia.EstadoVuelo.Codigo == "OP")
                        {
                            estadoBadge = "bg-success";
                        }
                        else if (incidencia.EstadoVuelo != null && incidencia.EstadoVuelo.Codigo == "CA")
                        {
                            estadoBadge = "bg-danger";
                        }

                        var tipoIncidencia = "Sin clasificar";
                        if (incidencia.EstadoVuelo != null)
                        {
                            if (incidencia.EstadoVuelo.Codigo == "RE")
                            {
                                tipoIncidencia = "Retraso de salida";
                            }
                            else if (incidencia.EstadoVuelo.Codigo == "CC")
                            {
                                tipoIncidencia = "Cambio de aeronave";
                            }
                            else if (incidencia.EstadoVuelo.Codigo == "CA")
                            {
                                tipoIncidencia = "Cancelación";
                            }
                        }

                        <tr>
                            <td class="py-3 px-4">
                                @Html.DisplayFor(modelItem => incidencia.VueloId)
                            </td>
                            <td class="py-3 px-4">@tipoIncidencia</td>
                            <td class="py-3 px-4">
                                <span class="badge @estadoBadge bg-opacity-75 rounded-pill">@estadoTexto</span>
                            </td>
                            <td class="py-3 px-4">
                                @Html.DisplayFor(modelItem => incidencia.FechaOperacion, "{0:dd MMM yyyy}")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-3 px-4 text-center text-muted small">No hay incidencias registradas</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>