@using Con_Autenticacion.Models
@model IEnumerable<Reserva>
@{
    ViewBag.Title = "Historial de reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string usuario = ViewBag.Usuario as string ?? "Usuario";
    string correo = ViewBag.Correo as string ?? "";
    int totalReservas = ViewBag.TotalReservas == null ? 0 : (int)ViewBag.TotalReservas;
    var reservas = Model as List<Reserva> ?? new List<Reserva>();
}

<div class="container py-4" style="max-width: 1150px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-uppercase small fw-bold text-secondary">Administracion</span>
            <h1 class="h3 fw-bold mb-1">Historial de reservas</h1>
            <p class="text-muted mb-0">Cuenta: <strong>@usuario</strong> | @correo</p>
        </div>
        @Html.ActionLink("Volver a usuarios", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <span class="fw-bold">Reservas del usuario</span>
            <span class="badge bg-light text-dark border">@totalReservas registros</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-4">Codigo</th><th>Fecha de creacion</th><th>Fecha limite</th><th>Estado</th><th class="text-end pe-4">Accion</th></tr></thead>
                <tbody>
                    @if (reservas.Count > 0)
                    {
                        foreach (var reserva in reservas)
                        {
                            string estado = reserva.EstadoReserva != null ? reserva.EstadoReserva.Descripcion : reserva.EstadoReservaCodigo;
                            <tr>
                                <td class="ps-4 fw-semibold">@reserva.CodigoReserva</td>
                                <td>@reserva.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(reserva.FechaExpiracion.HasValue ? reserva.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha")</td>
                                <td><span class="badge bg-light text-dark border">@estado</span></td>
                                <td class="text-end pe-4">@Html.ActionLink("Ver reserva", "Details", "Reservas", new { id = reserva.ReservaId }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-5">Este usuario no tiene reservas registradas.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
