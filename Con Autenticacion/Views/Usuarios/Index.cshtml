@using Con_Autenticacion.Controllers;
@model IEnumerable<UsuarioRolViewModel>

@{
    ViewBag.Title = "Gestión de Usuarios, Pasajeros y Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5" style="max-width: 1250px;">
    <div class="mb-4">
        <h2 class="h4 fw-bold text-dark mb-1">Gestión de Usuarios, Pasajeros y Reservas</h2>
        <p class="small text-muted mb-4">Consulta y administración de operaciones de clientes, perfiles y reservas asociadas.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4" style="border: 1px solid #e0e0e0 !important;">
        <div class="row g-2 align-items-center mb-2">
            <div class="col-md-6">
                <label class="form-label small text-muted fw-bold">Buscar por identificador</label>
                <input type="text" class="form-control form-control-sm" placeholder="Código de reserva, documento o correo...">
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold">Tipo de usuario</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>Cliente</option>
                    <option>Counter</option>
                    <option>Administrador</option>
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-sm w-100 px-3 text-white fw-semibold" style="background-color: #37474f; border-color: #37474f;">Consultar</button>
            </div>
        </div>

        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold">Fecha de reserva</label>
                <input type="date" class="form-control form-control-sm">
            </div>

            <div class="col-md-3">
                <label class="form-label small text-muted fw-bold">Estado de reserva</label>
                <select class="form-select form-select-sm">
                    <option>Todos</option>
                    <option>Confirmada</option>
                    <option>Pendiente</option>
                    <option>Cancelada</option>
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-sm btn-outline-secondary w-100">Limpiar filtros</button>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Usuarios registrados</div>
                <div class="fs-3 fw-bold text-dark">1,250</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Pasajeros del día</div>
                <div class="fs-3 fw-bold text-dark">340</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Reservas activas</div>
                <div class="fs-3 fw-bold text-success">128</div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3" style="border: 1px solid #e0e0e0 !important;">
                <div class="small text-muted fw-bold">Canceladas hoy</div>
                <div class="fs-3 fw-bold text-danger">5</div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="border: 1px solid #e0e0e0 !important;">
        <div class="card-header bg-light border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <span class="small fw-bold text-dark">Resultados de la consulta</span>
            <span class="badge bg-light text-dark border">12 registros</span>
        </div>

        <table class="table table-hover table-striped align-middle mb-0">
            <thead class="table-light text-dark">
                <tr>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Usuario</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Correo</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Rol</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Reserva</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Estado</th>
                    <th class="py-3 px-4 fw-bold border-bottom-0">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="py-3 px-4 fw-semibold">María López</td>
                    <td class="py-3 px-4 text-muted">maria.lopez@email.com</td>
                    <td class="py-3 px-4"><span class="badge bg-light text-dark border">Cliente</span></td>
                    <td class="py-3 px-4">VIP-401<br><span class="small text-muted">28 Oct 2026</span></td>
                    <td class="py-3 px-4"><span class="badge bg-success bg-opacity-75 rounded-pill">Confirmada</span></td>
                    <td class="py-3 px-4">
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary">Actualizar</button>
                            <button class="btn btn-sm btn-outline-secondary">Historial</button>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="py-3 px-4 fw-semibold">Carlos Ruiz</td>
                    <td class="py-3 px-4 text-muted">carlos.ruiz@email.com</td>
                    <td class="py-3 px-4"><span class="badge bg-light text-dark border">Counter</span></td>
                    <td class="py-3 px-4">VIP-705<br><span class="small text-muted">29 Oct 2026</span></td>
                    <td class="py-3 px-4"><span class="badge bg-warning bg-opacity-75 rounded-pill text-dark">Pendiente</span></td>
                    <td class="py-3 px-4">
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-secondary">Actualizar</button>
                            <button class="btn btn-sm btn-outline-secondary">Historial</button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
