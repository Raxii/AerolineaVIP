@model IEnumerable<Con_Autenticacion.Controllers.UsuarioRolViewModel>
@using Con_Autenticacion.Controllers
@{
    ViewBag.Title = "Gestion de usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var listaUsuarios = Model as List<UsuarioRolViewModel> ?? new List<UsuarioRolViewModel>();
    int totalUsuarios = ViewBag.TotalUsuarios == null ? 0 : (int)ViewBag.TotalUsuarios;
    int reservasActivas = ViewBag.ReservasActivas == null ? 0 : (int)ViewBag.ReservasActivas;
    int reservasHoy = ViewBag.ReservasHoy == null ? 0 : (int)ViewBag.ReservasHoy;
    int reservasCanceladas = ViewBag.ReservasCanceladas == null ? 0 : (int)ViewBag.ReservasCanceladas;
    string buscar = ViewBag.Buscar as string ?? "";
    string rolSeleccionado = ViewBag.RolSeleccionado as string ?? "";
    var rolesDisponibles = new[] { "Cliente", "Counter", "Administrador" };
}

<div class="container py-4" style="max-width: 1320px;">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="text-uppercase small fw-bold text-secondary">Administracion</span>
            <h1 class="h3 fw-bold mb-1">Gestion de usuarios y reservas</h1>
            <p class="text-muted mb-0">Consulta cuentas registradas, actualiza roles y revisa el historial de reservas.</p>
        </div>
    </div>

    @if (TempData["Ok"] != null)
    {<div class="alert alert-success">@TempData["Ok"]</div>}
    @if (TempData["Error"] != null)
    {<div class="alert alert-danger">@TempData["Error"]</div>}

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Usuarios registrados</div><div class="display-6 fw-bold">@totalUsuarios</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Reservas activas</div><div class="display-6 fw-bold text-success">@reservasActivas</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Reservas creadas hoy</div><div class="display-6 fw-bold">@reservasHoy</div></div></div></div>
        <div class="col-md-3"><div class="card border-0 shadow-sm h-100"><div class="card-body"><div class="small text-muted">Reservas canceladas</div><div class="display-6 fw-bold text-danger">@reservasCanceladas</div></div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Index", "Usuarios", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
            {
                <div class="col-md-7">
                    <label class="form-label fw-semibold">Buscar usuario</label>
                    <input type="text" name="buscar" value="@buscar" class="form-control" placeholder="Nombre de usuario o correo" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Rol</label>
                    <select name="rol" class="form-select">
                        <option value="">Todos</option>
                        <option value="Cliente" @(rolSeleccionado == "Cliente" ? "selected" : "")>Cliente</option>
                        <option value="Counter" @(rolSeleccionado == "Counter" ? "selected" : "")>Counter</option>
                        <option value="Administrador" @(rolSeleccionado == "Administrador" ? "selected" : "")>Administrador</option>
                        <option value="SuperUsuario" @(rolSeleccionado == "SuperUsuario" ? "selected" : "")>SuperUsuario</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark flex-fill">Consultar</button>
                    @Html.ActionLink("Limpiar", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <span class="fw-bold">Cuentas encontradas</span>
            <span class="badge bg-light text-dark border">@listaUsuarios.Count registros</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th class="ps-4">Usuario</th><th>Correo</th><th>Rol actual</th><th>Ultima reserva</th><th>Reservas</th><th>Actualizar rol</th><th class="text-end pe-4">Historial</th></tr>
                </thead>
                <tbody>
                    @if (listaUsuarios.Count > 0)
                    {
                        foreach (var usuario in listaUsuarios)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold">@usuario.Usuario</td>
                                <td>@usuario.Correo</td>
                                <td><span class="badge bg-light text-dark border">@usuario.Roles</span></td>
                                <td>
                                    <div class="fw-semibold">@usuario.ReservaCodigo</div>
                                    @if (usuario.FechaReserva.HasValue)
                                    {
                                        <span class="small text-muted">@usuario.FechaReserva.Value.ToString("dd/MM/yyyy") - @usuario.EstadoReserva</span>
                                    }
                                    else
                                    {
                                        <span class="small text-muted">@usuario.EstadoReserva</span>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@usuario.CantidadReservas</span></td>
                                <td>
                                    @if (usuario.PuedeCambiarRol)
                                    {
                                        using (Html.BeginForm("CambiarRol", "Usuarios", FormMethod.Post, new { @class = "d-flex gap-2 align-items-center" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", usuario.Id)
                                            @Html.DropDownList("rol", new SelectList(rolesDisponibles, usuario.RolSeleccionado), new { @class = "form-select form-select-sm", style = "min-width:130px;" })
                                            <button type="submit" class="btn btn-sm btn-outline-primary">Actualizar</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Protegido</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    @Html.ActionLink("Ver historial", "Historial", new { id = usuario.Id }, new { @class = "btn btn-sm btn-outline-success" })
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">No se encontraron usuarios con esos filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
