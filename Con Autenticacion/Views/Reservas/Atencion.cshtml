@using Con_Autenticacion.Models
@model Reserva

@{
    ViewBag.Title = "Consulta de reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="mb-1">Consulta de reservas</h2>
    <p class="text-muted">Atencion al pasajero: busca una reserva mediante su codigo.</p>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            @using (Html.BeginForm("Atencion", "Reservas", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
            {
                <div class="col-md-8">
                    <label for="codigoReserva" class="form-label">Codigo de reserva</label>
                    <input type="text" id="codigoReserva" name="codigoReserva" value="@ViewBag.CodigoReserva" class="form-control" placeholder="Ejemplo: RV00000001" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Consultar reserva</button>
                </div>
            }
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.CodigoReserva)) && Model == null)
    {
        <div class="alert alert-warning">No se encontro una reserva con el codigo ingresado.</div>
    }

    @if (Model != null)
    {
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Reserva @Model.CodigoReserva</strong>
                <span class="badge bg-secondary">@(Model.EstadoReserva != null ? Model.EstadoReserva.Descripcion : Model.EstadoReservaCodigo)</span>
            </div>
            <div class="card-body">
                <p><strong>Fecha de creacion:</strong> @Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</p>
                <h5 class="mt-4">Pasajeros y vuelos asociados</h5>

                @if (Model.ReservaPasajeroVuelo != null && Model.ReservaPasajeroVuelo.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Pasajero</th>
                                    <th>Vuelo</th>
                                    <th>Fecha</th>
                                    <th>Asiento</th>
                                    <th>Estado de asignacion</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asignacion in Model.ReservaPasajeroVuelo)
                                {
                                    <tr>
                                        <td>@(asignacion.Pasajero != null ? asignacion.Pasajero.Nombres + " " + asignacion.Pasajero.Apellidos : "No registrado")</td>
                                        <td>VIP@asignacion.VueloId</td>
                                        <td>@(asignacion.Vuelo != null ? asignacion.Vuelo.FechaOperacion.ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                        <td>@asignacion.NumeroAsiento</td>
                                        <td>@(asignacion.EstadoAsignacion != null ? asignacion.EstadoAsignacion.Descripcion : asignacion.EstadoAsignacionCodigo)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">La reserva no tiene asignaciones de pasajeros registradas.</div>
                }
            </div>
        </div>
    }
</div>
