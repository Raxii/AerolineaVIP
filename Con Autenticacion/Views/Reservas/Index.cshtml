@using Con_Autenticacion.Models;
@model IEnumerable<Reserva>

@{
    ViewBag.Title = "Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .byron-vip .card-header {
        background-color: #34414C;
        color: white;
    }

    .byron-vip .btn-vip {
        background-color: #34414C;
        border-color: #34414C;
        color: white;
    }

        .byron-vip .btn-vip:hover {
            background-color: #26323B;
            color: white;
        }

    .byron-vip .table thead th {
        background-color: #E7EBEF;
        color: #34414C;
    }

    .byron-vip .card {
        border: 1px solid #E7EBEF;
    }

    .byron-vip .table td {
        vertical-align: middle;
    }

    .byron-vip .card-body {
        background-color: #FFFFFF;
    }

    .byron-vip .text-muted {
        color: #607281 !important;
    }
</style>

<div class="container py-4 byron-vip">
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h2 class="h4 mb-1">AEROLÍNEA VIP</h2>
            <p class="mb-0">Reservas</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">Consulta de reservas y pasajeros registrados</p>
            <div class="mb-3">
                @Html.ActionLink("Nuevo registro", "Create", null, new { @class = "btn btn-vip" })
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered">
                    <thead>
                        <tr>
                            <th>Código de reserva</th>
                            <th>Pasajero(s)</th>
                            <th>Fecha de creación</th>
                            <th>Fecha límite</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CodigoReserva</td>
                                <td>
                                    @if (item.ReservaPasajeroVuelo != null && item.ReservaPasajeroVuelo.Count > 0)
                                    {
                                        foreach (var asignacion in item.ReservaPasajeroVuelo)
                                        {
                                            if (asignacion.Pasajero != null)
                                            {
                                                <div>@asignacion.Pasajero.Nombres @asignacion.Pasajero.Apellidos</div>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin pasajero asignado</span>
                                    }
                            </td>
                            <td>@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@(item.FechaExpiracion.HasValue ? item.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha")</td>
                            <td>@(item.EstadoReserva != null ? item.EstadoReserva.Descripcion : item.EstadoReservaCodigo)</td>
                            <td class="text-nowrap">
                                @Html.ActionLink("Ver", "Details", new { id = item.ReservaId }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Editar", "Edit", new { id = item.ReservaId }, new { @class = "btn btn-sm btn-outline-secondary" })
                                @Html.ActionLink("Eliminar", "Delete", new { id = item.ReservaId }, new { @class = "btn btn-sm btn-outline-danger" })
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
