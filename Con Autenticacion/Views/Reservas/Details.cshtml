@using Con_Autenticacion.Models;
@model Reserva

@{
    ViewBag.Title = "Reserva - Detalles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .byron-vip .card-header {
        background-color: #34414C;
        color: white;
    }

    .byron-vip .btn-vip {
        background-color: #34414C;
        border-color: #34414C;
        color: white;
    }

        .byron-vip .btn-vip:hover {
            background-color: #26323B;
            color: white;
        }

    .byron-vip .table thead th {
        background-color: #E7EBEF;
        color: #34414C;
    }

    .byron-vip .card {
        border: 1px solid #E7EBEF;
    }

    .byron-vip .table td {
        vertical-align: middle;
    }

    .byron-vip .card-body {
        background-color: #FFFFFF;
    }

    .byron-vip .text-muted {
        color: #607281 !important;
    }
</style>

<div class="container py-4 byron-vip">
    <div class="card shadow-sm">
        <div class="card-header py-3">
            <h2 class="h4 mb-1">AEROLÍNEA VIP</h2>
            <p class="mb-0">Reserva - Detalles</p>
        </div>
        <div class="card-body p-4">
            <p class="text-muted">Información de la reserva y sus pasajeros</p>
            <dl class="row">
                <dt class="col-sm-4">Reserva</dt>
                <dd class="col-sm-8">@Model.CodigoReserva</dd>
                <dt class="col-sm-4">Pasajero(s)</dt>
                <dd class="col-sm-8">
                    @if (Model.ReservaPasajeroVuelo != null && Model.ReservaPasajeroVuelo.Count > 0)
                    {
                        foreach (var asignacion in Model.ReservaPasajeroVuelo)
                        {
                            if (asignacion.Pasajero != null)
                            {
                                <div>@asignacion.Pasajero.Nombres @asignacion.Pasajero.Apellidos — Asiento @asignacion.NumeroAsiento</div>
                            }
                        }
                    }
                    else
                    {
                        <span class="text-muted">Sin pasajero asignado</span>
                    }
            </dd>
            <dt class="col-sm-4">Fecha de creación</dt>
            <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Fecha límite</dt>
            <dd class="col-sm-8">@(Model.FechaExpiracion.HasValue ? Model.FechaExpiracion.Value.ToString("dd/MM/yyyy HH:mm") : "Sin fecha")</dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">@(Model.EstadoReserva != null ? Model.EstadoReserva.Descripcion : Model.EstadoReservaCodigo)</dd>
        </dl>
        @Html.ActionLink("Editar", "Edit", new { id = Model.ReservaId }, new { @class = "btn btn-vip" })
        @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>
</div>
