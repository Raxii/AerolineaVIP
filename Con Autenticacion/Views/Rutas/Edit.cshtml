@model Con_Autenticacion.Models.Ruta
@{
    ViewBag.Title = "Editar ruta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:980px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Operacion
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Editar ruta
        </h1>
        <p class="text-muted mb-0">
            Modifica el origen, destino o estado de la ruta.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Ruta #@Model.RutaId
            </h2>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "Rutas", FormMethod.Post, new
            {
                @class = "row g-3"
            }
           ))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.RutaId)
                @Html.ValidationSummary(true, "", new
                {
                    @class = "alert alert-danger"
                }
                )
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="AeropuertoOrigenId">
                        Aeropuerto de origen
                    </label>
                    @Html.DropDownList("AeropuertoOrigenId", null, "Selecciona el origen", new
                    {
                        @class = "form-select"
                    }
                    )@Html.ValidationMessageFor(m => m.AeropuertoOrigenId, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold" for="AeropuertoDestinoId">
                        Aeropuerto de destino
                    </label>
                    @Html.DropDownList("AeropuertoDestinoId", null, "Selecciona el destino", new
                    {
                        @class = "form-select"
                    }
                    )@Html.ValidationMessageFor(m => m.AeropuertoDestinoId, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-12">
                    <div class="form-check form-switch border rounded-3 p-3 ps-5">
                        <strong class="d-block">
                            Ruta activa
                        </strong>
                        <small class="text-muted d-block mb-2">
                            Si se desactiva, no deberia utilizarse en nuevas frecuencias.
                        </small>
                        @Html.CheckBoxFor(m => m.Activa, new
                        {
                            @class = "form-check-input",
                            role = "switch"
                        }
                        )
                    </div>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn text-white" style="background:#172b3d;">
                        Guardar cambios
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new
                    {
                        @class = "btn btn-outline-secondary"
                    }
                    )
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
