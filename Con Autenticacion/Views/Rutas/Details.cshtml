@model Con_Autenticacion.Models.Ruta
@{
    ViewBag.Title = "Detalle de ruta";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string origen = Model.Aeropuerto != null ? Model.Aeropuerto.CodigoIATA : Model.AeropuertoOrigenId.ToString();
    string destino = Model.Aeropuerto1 != null ? Model.Aeropuerto1.CodigoIATA : Model.AeropuertoDestinoId.ToString();
    string nombreOrigen = Model.Aeropuerto != null ? Model.Aeropuerto.Nombre : "No disponible";
    string nombreDestino = Model.Aeropuerto1 != null ? Model.Aeropuerto1.Nombre : "No disponible";
    int frecuencias = ViewBag.FrecuenciasAsociadas == null ? -1 : (int)ViewBag.FrecuenciasAsociadas;
}
<div class="container py-4" style="max-width:1000px;">
    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
                Flota y rutas / Consulta
            </div>
            <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
                Detalle de ruta
            </h1>
            <p class="text-muted mb-0">
                Trayecto registrado en el catalogo.
            </p>
        </div>
        @Html.ActionLink("Volver al listado", "Index", null, new
        {
            @class = "btn btn-outline-secondary"
        }
        )
    </div>
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="p-4 text-white" style="background:#172b3d;border-bottom:4px solid #c9a96e;">
            <div class="small text-uppercase opacity-75">
                Trayecto
            </div>
            <div class="display-6 fw-bold">
                @origen - @destino
            </div>
            <div class="fs-6">
                @nombreOrigen a @nombreDestino
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">
                            Origen
                        </small>
                        <strong>
                            @origen
                        </strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">
                            Destino
                        </small>
                        <strong>
                            @destino
                        </strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded-3 p-3">
                        <small class="text-muted d-block">
                            Estado
                        </small>
                        @if (Model.Activa)
                        {
                            <span class="badge text-bg-success">
                                Activa
                            </span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">
                                Inactiva
                            </span>
                        }
                    </div>
                </div>
                @if (frecuencias >= 0)
                {
                    <div class="col-md-4">
                        <div class="border rounded-3 p-3">
                            <small class="text-muted d-block">
                                Frecuencias asociadas
                            </small>
                            <strong>
                                @frecuencias
                            </strong>
                        </div>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 flex-wrap mt-4">
                @Html.ActionLink("Editar ruta", "Edit", new
                {
                    id = Model.RutaId
                }
                , new
                     {
                    @class = "btn text-white",
                         style = "background:#172b3d;"
                }
                )@Html.ActionLink("Eliminar ruta", "Delete", new
                {
                   id = Model.RutaId
               }
               , new
                    {
                   @class = "btn btn-outline-danger"
               }
               )
            </div>
        </div>
    </div>
</div>
