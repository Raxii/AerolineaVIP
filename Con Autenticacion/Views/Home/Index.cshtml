@using Con_Autenticacion.ViewModels
@using System.Linq
@model BusquedaVueloViewModel

@{
    ViewBag.Title = "Inicio";
}

<div class="container py-4">
    <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-sm">
        <h1 class="display-5 fw-bold">Vuela con comodidad y confianza</h1>
        <p class="lead mb-3">
            Consulta la programación de vuelos y encuentra la mejor opción para tu viaje.
        </p>
        <p class="mb-0">Rutas domésticas e internacionales con la mejor disponibilidad.</p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Buscar vuelos</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Buscar", "Home", FormMethod.Get, new { @class = "row g-3" }))
            {
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                <div class="col-md-3">
                    @Html.LabelFor(m => m.AeropuertoOrigenId, "Aeropuerto de origen", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.AeropuertoOrigenId, Model.Aeropuertos, "-- Origen --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.AeropuertoOrigenId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.AeropuertoDestinoId, "Aeropuerto de destino", new { @class = "form-label fw-bold" })
                    @Html.DropDownListFor(m => m.AeropuertoDestinoId, Model.Aeropuertos, "-- Destino --", new { @class = "form-select" })
                    @Html.ValidationMessageFor(m => m.AeropuertoDestinoId, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-3">
                    @Html.LabelFor(m => m.Fecha, "Fecha de vuelo", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.Fecha, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                    @Html.ValidationMessageFor(m => m.Fecha, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-2">
                    @Html.LabelFor(m => m.CantidadPasajeros, "Cantidad de pasajeros", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(m => m.CantidadPasajeros, new { @class = "form-control", type = "number", min = "1", max = "20" })
                    @Html.ValidationMessageFor(m => m.CantidadPasajeros, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">Buscar</button>
                </div>
            }
        </div>
    </div>

    @if (Model.BusquedaRealizada)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0">Resultados</h5>
            </div>
            <div class="card-body">
                @if (Model.Resultados != null && Model.Resultados.Any())
                {
                    foreach (var vuelo in Model.Resultados)
                    {
                        <div class="border rounded p-3 mb-2">
                            <strong>@vuelo.Origen → @vuelo.Destino</strong>
                            <div>Fecha: @vuelo.FechaOperacion.ToShortDateString()</div>
                            <div>Salida: @vuelo.HoraSalida</div>
                            <div>Llegada: @vuelo.HoraLlegada</div>
                            <div>Disponibles: @vuelo.Disponibles</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted mb-0">No hay vuelos disponibles para los criterios seleccionados.</p>
                }
            </div>
        </div>
    }
</div>
