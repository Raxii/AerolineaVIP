@{
    // =====================================
    // CONFIGURACION INICIAL DE LA VISTA
    // =====================================
    ViewBag.Title = "Home";
    var origenes = ViewBag.Origenes as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var destinos = ViewBag.Destinos as IEnumerable<SelectListItem> ?? new List<SelectListItem>();
    var destinosPopulares = ViewBag.DestinosPopulares as List<Con_Autenticacion.Models.Aeropuerto>
        ?? new List<Con_Autenticacion.Models.Aeropuerto>();
    var vuelosDisponibles = ViewBag.VuelosDisponibles != null ? (int)ViewBag.VuelosDisponibles : 0;
}

@* =====================================
    CONTENEDOR PRINCIPAL DE LA PAGINA
    ===================================== *@
<div class="container py-5">
    <div class="text-center mb-4">
        <h2 class="display-5 fw-bold text-dark mb-3 text-center">Descubre el mundo con nosotros</h2>
        <p class="lead text-muted mx-auto text-center mb-5" style="max-width: 600px;">
            Vuela con la mejor atención, tarifas competitivas y destinos increíbles. Encuentra tu próximo vuelo aquí.
        </p>
    </div>
    @* =====================================
        FORMULARIO DE BUSQUEDA DE VUELOS
        ===================================== *@
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 900px; border: 1px solid #e0e0e0 !important;">
        @using (Html.BeginForm("Buscar", "Vueloes", FormMethod.Get, new { id = "form-buscar-home" }))
        {
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Origen</label>
                    @Html.DropDownList("AeropuertoOrigenId",
                        new SelectList(origenes, "Value", "Text"),
                        "Seleccione aeropuerto...",
                        new { @class = "form-select form-control-lg", required = "required", id = "home-origen" })
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Destino</label>
                    @Html.DropDownList("AeropuertoDestinoId",
                        new SelectList(destinos, "Value", "Text"),
                        "Seleccione aeropuerto...",
                        new { @class = "form-select form-control-lg", required = "required", id = "home-destino" })
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Fecha</label>
                    <input type="date" class="form-control form-control-lg" name="Fecha"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" required>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted fw-bold">Pasajeros</label>
                    <input type="number" class="form-control form-control-lg" name="CantidadPasajeros" min="1" max="7" value="1" required>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-lg w-100 text-white fw-bold rounded-3"
                            style="background-color: #37474f; border-color: #37474f;">
                        Buscar Vuelos
                    </button>
                </div>
            </div>
        }
    </div>
    @* =====================================
        INFORMACION DE VUELOS DISPONIBLES
        ===================================== *@
    <div class="mx-auto mt-4" style="max-width: 900px;">
        @if (vuelosDisponibles > 0)
        {
            <div class="alert alert-info d-flex align-items-center rounded-3 border-0" role="alert">
                <span class="small">Hay <strong>@vuelosDisponibles</strong> vuelos programados disponibles para reservar.</span>
            </div>
        }
        else
        {
            <div class="alert alert-warning d-flex align-items-center rounded-3 border-0" role="alert">
                <span class="small">Por el momento no hay vuelos programados. Vuelve pronto.</span>
            </div>
        }
    </div>
    @* =====================================
        SECCION DE DESTINOS POPULARES
        ===================================== *@
    <div class="mt-5">
        <h3 class="h5 fw-bold text-dark mb-4 mt-5">Destinos Populares</h3>
        <div class="row g-4">
            @if (destinosPopulares.Count == 0)
            {
                <p class="text-muted small">Aún no hay destinos programados para mostrar.</p>
            }
            else
            {
                foreach (var destino in destinosPopulares)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100" style="border: 1px solid #e0e0e0 !important;">
                            <div class="card-img-top rounded-top-4 bg-light" style="height: 150px;">
                                @Html.Partial("~/Views/Aeropuerto/ImgAeropuerto.cshtml", destino)
                            </div>
                            <div class="card-body text-center">
                                <h5 class="card-title fw-bold text-dark">@destino.Nombre (@destino.CodigoIATA)</h5>
                                <p class="card-text text-muted small mb-0">@destino.Localidad</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/Scripts/Validaciones/origen-destino-home.js")"></script>
}