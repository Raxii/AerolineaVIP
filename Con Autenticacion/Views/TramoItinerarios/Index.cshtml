@model IEnumerable<Con_Autenticacion.Models.TramoItinerario>
@using System.Collections.Generic
@using Con_Autenticacion.Models
@{
    ViewBag.Title = "Administracion de tramos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    IEnumerable<TramoItinerario> registros = ViewBag.ListaTramos as IEnumerable<TramoItinerario>;
    if (registros == null)
    {
        registros = Model;
    }
    bool hayRegistros = false;
}
<div class="container py-4" style="max-width:1250px;">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 border-bottom pb-3 mb-4">
        <div>
            <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
                Programacion / Estructura de itinerarios
            </div>
            <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
                Tramos de itinerarios
            </h1>
            <p class="text-muted mb-0">
                Relaciona cada itinerario con los vuelos que forman su recorrido.
            </p>
        </div>
        @Html.ActionLink("+ Nuevo tramo", "Create", null, new
        {
            @class = "btn text-white",
            style = "background:#172b3d;"
        }
        )
    </div>
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success">
            @TempData["Ok"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-1" style="color:#172b3d;">
                Secuencia de vuelos
            </h2>
            <small class="text-muted">
                El orden define la posicion de cada vuelo dentro del itinerario.
            </small>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:#f3f6f8;color:#172b3d;">
                    <tr>
                        <th class="ps-4">
                            Orden
                        </th>
                        <th>
                            Itinerario
                        </th>
                        <th>
                            Vuelo
                        </th>
                        <th>
                            Fecha
                        </th>
                        <th>
                            Estado del vuelo
                        </th>
                        <th class="text-end pe-4">
                            Acciones
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @if (registros != null)
                    {
                        foreach (var item in registros)
                        {
                            hayRegistros = true;
                            string referencia = item.Itinerario != null ? item.Itinerario.Referencia : "Itinerario " + item.ItinerarioId;
                            string estado = item.Vuelo != null ? item.Vuelo.EstadoVueloCodigo : "N/A";
                            string fecha = item.Vuelo != null ? item.Vuelo.FechaOperacion.ToString("dd/MM/yyyy") : "N/A";
                            <tr>
                                <td class="ps-4">
                                    <span class="badge rounded-pill text-dark border" style="background:#f5eddf;">
                                        @item.Orden
                                    </span>
                                </td>
                                <td class="fw-semibold">
                                    @referencia
                                </td>
                                <td>
                                    VUE-@item.VueloId
                                </td>
                                <td>
                                    @fecha
                                </td>
                                <td>
                                    @estado
                                </td>
                                <td class="text-end pe-4 text-nowrap">
                                    @Html.ActionLink("Ver", "Details", new
                                    {
                                        id = item.TramoItinerarioId
                                    }
                                    , new
                                         {
                                        @class = "btn btn-sm btn-outline-secondary"
                                    }
                                    )
                                    @Html.ActionLink("Editar", "Edit", new
                                    {
                                        id = item.TramoItinerarioId
                                    }
                                    , new
                                         {
                                        @class = "btn btn-sm btn-outline-primary"
                                    }
                                    )
                                    @Html.ActionLink("Eliminar", "Delete", new
                                    {
                                        id = item.TramoItinerarioId
                                    }
                                    , new
                                         {
                                        @class = "btn btn-sm btn-outline-danger"
                                    }
                                    )
                                </td>
                            </tr>
                        }
                    }
                    @if (!hayRegistros)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                No hay tramos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
