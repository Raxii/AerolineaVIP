@model Con_Autenticacion.Models.TramoItinerario
@{
    ViewBag.Title = "Editar tramo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container py-4" style="max-width:1000px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Programacion / Tramos
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Editar tramo
        </h1>
        <p class="text-muted mb-0">
            Actualiza el vuelo o el orden dentro del itinerario.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white px-4 py-3">
            <h2 class="h5 mb-0" style="color:#172b3d;">
                Tramo #@Model.TramoItinerarioId
            </h2>
        </div>
        <div class="card-body p-4">
            @using (Html.BeginForm("Edit", "TramoItinerarios", FormMethod.Post, new
            {
                @class = "row g-3"
            }
           ))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.TramoItinerarioId)
                @Html.ValidationSummary(true, "", new
                {
                    @class = "alert alert-danger"
                }
                )
                <div class="col-12">
                    <label class="form-label fw-semibold" for="ItinerarioId">
                        Itinerario
                    </label>
                    @Html.DropDownList("ItinerarioId", null, "Selecciona un itinerario", new
                    {
                        @class = "form-select"
                    }
                    )@Html.ValidationMessageFor(m => m.ItinerarioId, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold" for="VueloId">
                        Vuelo asignado
                    </label>
                    @Html.DropDownList("VueloId", null, "Selecciona un vuelo", new
                    {
                        @class = "form-select"
                    }
                    )@Html.ValidationMessageFor(m => m.VueloId, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold" for="Orden">
                        Orden del tramo
                    </label>
                    @Html.TextBoxFor(m => m.Orden, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "1",
                        max = "255"
                    }
                    )@Html.ValidationMessageFor(m => m.Orden, "", new
                    {
                       @class = "text-danger small"
                   }
                   )
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                    <button type="submit" class="btn text-white" style="background:#172b3d;">
                        Guardar cambios
                    </button>
                    @Html.ActionLink("Cancelar", "Index", null, new
                    {
                        @class = "btn btn-outline-secondary"
                    }
                    )
                </div>
            }
        </div>
    </div>
</div>
@section Scripts
{
    @Scripts.Render("~/bundles/jqueryval")
}
