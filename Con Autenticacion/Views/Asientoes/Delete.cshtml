@model Con_Autenticacion.Models.Asiento
@{
    ViewBag.Title = "Eliminar asiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string modelo = Model.ModeloAeronave != null ? Model.ModeloAeronave.Fabricante + " " + Model.ModeloAeronave.Nombre : "N/A";
    string lado = Model.Lado == "D" ? "Derecho" : Model.Lado == "I" ? "Izquierdo" : Model.Lado;
}
<div class="container py-4" style="max-width:900px;">
    <div class="mb-4">
        <div class="text-uppercase small fw-bold mb-2" style="color:#b18b4b;letter-spacing:.12em;">
            Flota y rutas / Confirmacion
        </div>
        <h1 class="h3 fw-bold mb-1" style="color:#172b3d;">
            Eliminar asiento
        </h1>
        <p class="text-muted mb-0">
            Confirma la eliminacion de esta ubicacion.
        </p>
    </div>
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="alert alert-warning border-0">
                <strong>
                    Atencion:
                </strong>
                revisa que el asiento no este siendo utilizado por una reserva.
            </div>
            <h2 class="h5" style="color:#172b3d;">
                Asiento @Model.Codigo
            </h2>
            <div class="row g-3 my-3">
                <div class="col-md-6">
                    <small class="text-muted d-block">
                        Modelo
                    </small>
                    <strong>
                        @modelo
                    </strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Fila
                    </small>
                    <strong>
                        @Model.Fila
                    </strong>
                </div>
                <div class="col-md-3">
                    <small class="text-muted d-block">
                        Lado
                    </small>
                    <strong>
                        @lado
                    </strong>
                </div>
                <div class="col-12">
                    <small class="text-muted d-block">
                        Ubicacion
                    </small>
                    <strong>
                        @Model.Ubicacion
                    </strong>
                </div>
            </div>
            @using (Html.BeginForm("Delete", "Asientoes", new
            {
                id = Model.NumeroAsiento,
                modeloAeronaveId = Model.ModeloAeronaveId,
                numeroAsiento = Model.NumeroAsiento
            }
           , FormMethod.Post, new
           {
               @class = "d-flex flex-wrap gap-2"
           }
           ))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    Confirmar eliminacion
                </button>
                @Html.ActionLink("Cancelar", "Index", null, new
                {
                    @class = "btn btn-outline-secondary"
                }
                )
            }
        </div>
    </div>
</div>
